// WXS 格式化模块
// 用于在WXML中直接调用格式化函数

/**
 * 单位中英文映射表
 */
var UNIT_MAP = {
  'piece': '件',
  'pieces': '件',
  'box': '箱',
  'boxes': '箱',
  'pcs': '个',
  'pc': '个',
  'kg': '千克',
  'g': '克',
  'ton': '吨',
  'm': '米',
  'cm': '厘米',
  'mm': '毫米',
  'sqm': '平方米',
  'cbm': '立方米',
  'set': '套',
  'sets': '套',
  'pair': '对',
  'pairs': '对',
  'dozen': '打',
  'pack': '包',
  'packs': '包',
  'bag': '袋',
  'bags': '袋',
  'bottle': '瓶',
  'bottles': '瓶',
  'can': '罐',
  'cans': '罐',
  'roll': '卷',
  'rolls': '卷',
  'sheet': '张',
  'sheets': '张'
};

/**
 * 格式化单位 - 将英文单位转换为中文
 */
var formatUnit = function(unit) {
  if (!unit) return '';
  var lowerUnit = unit.toLowerCase();
  return UNIT_MAP[lowerUnit] || unit;
};

/**
 * 格式化数量显示
 * - 默认：数量 + 中文单位（如 100件）
 * - 如提供每件片数：按「X件Y片」格式展示
 */
var formatQuantity = function(quantity, unit, piecesPerUnit) {
  if (typeof quantity !== 'number') {
    // WXS 环境不保证 Number/|| 的支持，这里做最保守处理
    quantity = 0;
  }

  // 如提供每件片数，则按“件/片”拆分显示
  if (piecesPerUnit && piecesPerUnit > 0) {
    var total = quantity;
    var units = Math.floor(total / piecesPerUnit);
    var pieces = total % piecesPerUnit;

    if (units === 0) {
      // 不足一件，仅显示片数
      return pieces + '片';
    }

    if (pieces === 0) {
      // 刚好整件
      return units + '件';
    }

    // 同时有整件和零散片数
    return units + '件' + pieces + '片';
  }

  // 默认：数量 + 中文单位
  return quantity + formatUnit(unit);
};

/**
 * 格式化数量显示（同时展示「件/片拆分」和「总片数」）
 * 示例：库存=91片, 每件10片 -> "9件1片（91片）"
 * - 当未提供 piecesPerUnit 时，退化为 formatQuantity 行为
 */
var formatQuantityWithPieces = function(quantity, unit, piecesPerUnit) {
  var display = formatQuantity(quantity, unit, piecesPerUnit);

  if (typeof quantity !== 'number') {
    quantity = 0;
  }

  // 仅在提供了每件片数时追加总片数，避免对非片数单位造成误解
  if (piecesPerUnit && piecesPerUnit > 0) {
    return display + '（' + quantity + '片）';
  }

  return display;
};

/**
 * 格式化金额 - 使用人民币符号（简化版，WXS不支持正则）
 */
var formatAmount = function(amount) {
  if (typeof amount !== 'number') return '￥0.00';

  // 转换为两位小数
  var fixed = amount.toFixed(2);

  // 分割整数和小数部分
  var parts = fixed.split('.');
  var integerPart = parts[0];
  var decimalPart = parts[1];

  // 手动添加千分位分隔符
  var result = '';
  var count = 0;
  for (var i = integerPart.length - 1; i >= 0; i--) {
    if (count > 0 && count % 3 === 0) {
      result = ',' + result;
    }
    result = integerPart.charAt(i) + result;
    count++;
  }

  return '￥' + result + '.' + decimalPart;
};

/**
 * 格式化库存状态
 */
var formatStockStatus = function(quantity) {
  if (quantity > 20) {
    return '充足';
  } else if (quantity > 0) {
    return '偏低';
  } else {
    return '缺货';
  }
};

/**
 * 获取库存状态类型
 */
var getStockStatusType = function(quantity) {
  if (quantity > 20) {
    return 'success';
  } else if (quantity > 0) {
    return 'warning';
  } else {
    return 'danger';
  }
};

module.exports = {
  formatUnit: formatUnit,
  formatQuantity: formatQuantity,
  formatQuantityWithPieces: formatQuantityWithPieces,
  formatAmount: formatAmount,
  formatStockStatus: formatStockStatus,
  getStockStatusType: getStockStatusType
};
