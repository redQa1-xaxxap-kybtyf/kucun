/* 产品创建页 - 2025 Hyper Minimal */
.container {
  min-height: 100vh;
  background-color: #ffffff; /* White clean background */
  padding: 32rpx 40rpx 180rpx; /* Bottom padding for fixed footer */
  box-sizing: border-box;
}

.form-card {
  /* No card needed, just clean layout on white */
  background-color: transparent;
  padding: 0;
  box-shadow: none;
}

.form-item {
  margin-bottom: 48rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
}

/* Inputs & Textareas */
.input, .textarea, .picker-value {
  width: 100%;
  background: #F7F8FA; /* System Gray 6 */
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  font-size: 30rpx;
  color: #1d1d1f;
  padding: 0 32rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}

.input, .picker-value {
  height: 96rpx;
  line-height: 96rpx; /* Center vertical */
}

.textarea {
  min-height: 200rpx;
  padding-top: 24rpx;
  line-height: 1.5;
}

.input:focus, .textarea:focus {
  background: #FFFFFF;
  border-color: #0071E3;
  box-shadow: 0 4rpx 16rpx rgba(0, 113, 227, 0.1);
}

.input-placeholder {
  color: #aeaeb2;
}

/* Image Upload Styling */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.thumb-row {
  display: flex;
}

.image-item, .image-add, .thumb-image, .thumb-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx; /* Super rounded */
  overflow: hidden;
  position: relative;
}

.thumb-image, .image-thumb {
  width: 100%;
  height: 100%;
  background: #f2f2f7;
  object-fit: cover;
}

.image-add, .thumb-placeholder {
  background: #F7F8FA;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s;
}

.image-add:active, .thumb-placeholder:active {
  opacity: 0.7;
}

.thumb-plus {
  font-size: 48rpx;
  color: #8E8E93;
  font-weight: 300;
  margin-bottom: 8rpx;
}

.thumb-text {
  font-size: 20rpx;
  color: #AEAEB2;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(4px);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* Submit Bar */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  padding: 24rpx 40rpx 48rpx; /* Safe area padding */
  border-top: 0.5rpx solid rgba(0,0,0,0.05);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 112rpx;
  background: #0071E3;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 113, 227, 0.3);
}

.submit-btn[disabled] {
  background: #E5E5EA;
  color: #AEAEB2;
  box-shadow: none;
}
