/* 2025年现代化设计 - 渐变背景 + 玻璃形态学 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  background-attachment: fixed;
  padding: 32rpx 32rpx 160rpx;
  box-sizing: border-box;
  position: relative;
}

/* 背景装饰元素 - 增加深度感 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(
      circle at 20% 80%,
      rgba(255, 255, 255, 0.08) 0%,
      transparent 50%
    ),
    radial-gradient(
      circle at 80% 20%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 50%
    );
  pointer-events: none;
  z-index: 0;
}

/* 玻璃形态学卡片 - 优化移动端性能 */
.form-card {
  position: relative;
  background: rgba(255, 255, 255, 0.95);
  /* 降低 blur 值以提高移动端性能 */
  backdrop-filter: blur(20rpx) saturate(150%);
  -webkit-backdrop-filter: blur(20rpx) saturate(150%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.12),
    0 2rpx 8rpx rgba(0, 0, 0, 0.08),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  z-index: 1;
}

/* Bento布局 - 模块化设计 */
.form-item {
  margin-bottom: 40rpx;
  animation: fadeInUp 0.6s ease-out backwards;
}

.form-item:nth-child(1) {
  animation-delay: 0.1s;
}
.form-item:nth-child(2) {
  animation-delay: 0.15s;
}
.form-item:nth-child(3) {
  animation-delay: 0.2s;
}
.form-item:nth-child(4) {
  animation-delay: 0.25s;
}
.form-item:nth-child(5) {
  animation-delay: 0.3s;
}
.form-item:nth-child(6) {
  animation-delay: 0.35s;
}
.form-item:nth-child(7) {
  animation-delay: 0.4s;
}
.form-item:nth-child(8) {
  animation-delay: 0.45s;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 保留旧标签样式（用于其他地方） */
.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
  letter-spacing: 0.3rpx;
}

/* === 2025年现代化输入框系统 === */

/* 输入框包装器 */
.input-wrapper {
  position: relative;
  padding-top: 8rpx;
}

/* 浮动标签 - 始终在输入框上方,避免与 placeholder 重叠 */
.label-float {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.45);
  margin-bottom: 12rpx;
  margin-left: 4rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

/* 标签激活状态 - 颜色高亮 */
.input-wrapper.has-value .label-float {
  color: #667eea;
  font-weight: 600;
}

/* 输入框容器 */
.input-container {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 250, 252, 0.9) 100%
  );
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

/* 聚焦状态 - 仅通过 has-value 类控制 */
.input-wrapper.has-value .input-container {
  border-color: rgba(102, 126, 234, 0.4);
  background: #ffffff;
  box-shadow:
    0 4rpx 20rpx rgba(102, 126, 234, 0.15),
    0 0 0 4rpx rgba(102, 126, 234, 0.05),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 1);
  transform: translateY(-2rpx);
}

/* 增强版输入框（无图标版本） */
.input-enhanced {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1d1d1f;
  background: transparent;
  border: none;
  font-weight: 500;
}

/* 输入提示文字 */
.input-hint {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.3);
  margin-top: 12rpx;
  margin-left: 24rpx;
  font-weight: 400;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: all 0.3s ease;
}

/* 修复：微信小程序不支持~选择器 */
.input-wrapper.has-value .input-hint {
  opacity: 1;
  transform: translateY(0);
}

/* Placeholder样式 */
.input-placeholder {
  color: rgba(0, 0, 0, 0.25);
  font-weight: 400;
  font-size: 26rpx;
}

/* 保留旧版输入框样式作为后备 */
.input {
  width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f7 100%);
  box-sizing: border-box;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

/* 注意: 微信小程序不支持 :focus 伪类,需通过 JS 控制状态 */

.thumb-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.thumb-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background-color: #f2f2f7;
}

/* 图片上传区 - 玻璃效果 + 微交互 */
.thumb-placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 28rpx;
  border: 2rpx dashed rgba(102, 126, 234, 0.3);
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(249, 249, 251, 0.8) 100%
  );
  backdrop-filter: blur(10rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #667eea;
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.thumb-placeholder::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(102, 126, 234, 0.1) 0%,
    transparent 70%
  );
  transform: translate(-50%, -50%);
  transition: all 0.6s ease-out;
}

.thumb-placeholder:active {
  transform: scale(0.95);
  border-color: rgba(102, 126, 234, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
}

.thumb-placeholder:active::before {
  width: 200%;
  height: 200%;
}

.thumb-plus {
  font-size: 64rpx;
  line-height: 1;
  font-weight: 300;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.thumb-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #667eea;
}

/* 多图上传区域 - 网格布局优化 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.image-item {
  position: relative;
  animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 图片缩略图 - 玻璃效果 */
.image-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f2f2f7 0%, #e8e8ed 100%);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.image-thumb:active {
  transform: scale(0.95);
}

/* 删除按钮 - 现代化设计 */
.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff3b30 0%, #ff6b6b 100%);
  backdrop-filter: blur(10rpx);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.4);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.image-remove:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 8rpx rgba(255, 59, 48, 0.3);
}

/* 添加图片按钮 - 统一风格 */
.image-add {
  width: 100%;
  height: 200rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(102, 126, 234, 0.3);
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(249, 249, 251, 0.8) 100%
  );
  backdrop-filter: blur(10rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #667eea;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.image-add:active {
  transform: scale(0.95);
  border-color: rgba(102, 126, 234, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.15);
}

/* === 文本域增强版 === */

.textarea-wrapper {
  position: relative;
  padding-top: 8rpx;
}

/* 文本域标签 - 与输入框保持一致的样式 */
.textarea-wrapper .label-float {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.45);
  margin-bottom: 12rpx;
  margin-left: 4rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

/* 文本域标签激活状态 */
.textarea-wrapper.has-value .label-float {
  color: #667eea;
  font-weight: 600;
}

.textarea-container {
  position: relative;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 250, 252, 0.9) 100%
  );
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

/* 文本框聚焦状态 - 仅通过 has-value 类控制 */
.textarea-wrapper.has-value .textarea-container {
  border-color: rgba(102, 126, 234, 0.4);
  background: #ffffff;
  box-shadow:
    0 4rpx 20rpx rgba(102, 126, 234, 0.15),
    0 0 0 4rpx rgba(102, 126, 234, 0.05),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 1);
  transform: translateY(-2rpx);
}

.textarea-enhanced {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #1d1d1f;
  background: transparent;
  border: none;
  font-weight: 400;
  box-sizing: border-box;
}

/* 字数统计 */
.char-count {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.3);
  font-weight: 500;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

/* 文本框激活时的字数统计样式 */
.textarea-wrapper.has-value .char-count {
  color: #667eea;
  border-color: rgba(102, 126, 234, 0.3);
  background: rgba(102, 126, 234, 0.05);
}

/* 保留旧版文本框样式作为后备 */
.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
  line-height: 1.6;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f7 100%);
  box-sizing: border-box;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

/* 注意: 微信小程序不支持 :focus 伪类,需通过 JS 控制状态 */

.input-placeholder {
  color: rgba(0, 0, 0, 0.3);
  font-weight: 400;
}

/* === 选择器增强版 === */

.picker-container {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 250, 252, 0.9) 100%
  );
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
  height: 88rpx;
}

.input-wrapper.has-value .picker-container,
.picker-container:active {
  border-color: rgba(102, 126, 234, 0.4);
  background: #ffffff;
  box-shadow:
    0 4rpx 20rpx rgba(102, 126, 234, 0.15),
    0 0 0 4rpx rgba(102, 126, 234, 0.05),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 1);
  transform: translateY(-2rpx);
}

.picker-value-enhanced {
  flex: 1;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
  padding-left: 24rpx;
  padding-right: 16rpx;
}

.picker-arrow {
  font-size: 40rpx;
  color: #667eea;
  font-weight: 300;
  margin-right: 20rpx;
  transform: rotate(90deg);
  transition: all 0.3s ease;
}

.picker-container:active .picker-arrow {
  transform: rotate(90deg) scale(1.2);
}

/* 移除图标相关样式 */
.input-icon {
  display: none;
}

/* 保留旧版选择器样式作为后备 */
.picker-value {
  width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f7 100%);
  color: #1d1d1f;
  box-sizing: border-box;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  position: relative;
}

.picker-value::after {
  content: '›';
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%) rotate(90deg);
  font-size: 32rpx;
  color: #667eea;
  font-weight: 300;
}

/* 底部提交栏 - 优化移动端性能 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  /* 降低 blur 值以提高移动端性能 */
  backdrop-filter: blur(15rpx) saturate(150%);
  -webkit-backdrop-filter: blur(15rpx) saturate(150%);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  /* 注意: 在真机上可能被键盘遮挡,建议在 Page 中添加 adjust-position="true" */
}

/* 提交按钮 - 渐变 + 动效 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow:
    0 8rpx 24rpx rgba(102, 126, 234, 0.4),
    0 4rpx 12rpx rgba(118, 75, 162, 0.3);
  border: none;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 按钮光泽效果 */
.submit-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.3) 50%,
    transparent 100%
  );
  transition: left 0.6s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow:
    0 4rpx 16rpx rgba(102, 126, 234, 0.3),
    0 2rpx 8rpx rgba(118, 75, 162, 0.2);
}

.submit-btn:active::before {
  left: 100%;
}

.submit-btn[disabled] {
  opacity: 0.6;
  transform: none;
}
