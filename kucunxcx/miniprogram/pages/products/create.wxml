<!-- 产品创建页 -->
<view class="container {{ enableBackdropBlur ? '' : 'no-blur' }}">
  <view class="form-card">
    <!-- 缩略图（列表封面） -->
    <view class="form-item">
      <text class="label">缩略图</text>
      <view class="thumb-row">
        <image
          wx:if="{{ thumbnailUrl }}"
          class="thumb-image"
          src="{{ thumbnailUrl }}"
          mode="aspectFill"
          bindtap="onThumbnailTap"
        />
        <view
          wx:else
          class="thumb-placeholder"
          bindtap="onChooseThumbnail"
        >
          <text class="thumb-plus">＋</text>
          <text class="thumb-text">上传缩略图</text>
        </view>
      </view>
    </view>

    <!-- 主图（多张，用于产品轮播） -->
    <view class="form-item">
      <text class="label">主图（可多张）</text>
      <view class="image-grid">
        <view
          class="image-item"
          wx:for="{{ mainImages }}"
          wx:key="*this"
          wx:for-item="url"
          wx:for-index="index"
        >
          <image
            class="image-thumb"
            src="{{ url }}"
            mode="aspectFill"
            bindtap="onPreviewMainImage"
            data-index="{{ index }}"
          />
          <view
            class="image-remove"
            bindtap="onRemoveMainImage"
            data-index="{{ index }}"
          >
            ×
          </view>
        </view>

        <!-- 添加主图按钮 -->
        <view class="image-add" bindtap="onAddMainImage">
          <text class="thumb-plus">＋</text>
          <text class="thumb-text">添加主图</text>
        </view>
      </view>
    </view>

    <!-- 详情图（效果图，多张） -->
    <view class="form-item">
      <text class="label">详情图</text>
      <view class="image-grid">
        <view
          class="image-item"
          wx:for="{{ effectImages }}"
          wx:key="*this"
          wx:for-item="url"
          wx:for-index="index"
        >
          <image
            class="image-thumb"
            src="{{ url }}"
            mode="aspectFill"
            bindtap="onPreviewEffectImage"
            data-index="{{ index }}"
          />
          <view
            class="image-remove"
            bindtap="onRemoveEffectImage"
            data-index="{{ index }}"
          >
            ×
          </view>
        </view>

        <!-- 添加详情图按钮 -->
        <view class="image-add" bindtap="onAddEffectImage">
          <text class="thumb-plus">＋</text>
          <text class="thumb-text">添加详情图</text>
        </view>
      </view>
    </view>

    <!-- 产品编号 - 增强版 -->
    <view class="form-item">
      <view class="input-wrapper {{ (code || focusStates.code) ? 'has-value' : '' }}">
        <text class="label-float">产品编号</text>
        <view class="input-container">
          <input
            class="input-enhanced"
            placeholder="请输入产品编号"
            placeholder-class="input-placeholder"
            value="{{ code }}"
            data-field="code"
            bindinput="onCodeInput"
            bindfocus="onInputFocus"
            bindblur="onInputBlur"
          />
        </view>
        <view class="input-hint">仅支持字母、数字、-、_</view>
      </view>
    </view>

    <!-- 产品名称 - 增强版 -->
    <view class="form-item">
      <view class="input-wrapper {{ (name || focusStates.name) ? 'has-value' : '' }}">
        <text class="label-float">产品名称</text>
        <view class="input-container">
          <input
            class="input-enhanced"
            placeholder="请输入产品名称"
            placeholder-class="input-placeholder"
            value="{{ name }}"
            data-field="name"
            bindinput="onNameInput"
            bindfocus="onInputFocus"
            bindblur="onInputBlur"
          />
        </view>
      </view>
    </view>

    <!-- 规格 - 增强版 -->
    <view class="form-item">
      <view class="input-wrapper {{ (specification || focusStates.specification) ? 'has-value' : '' }}">
        <text class="label-float">规格</text>
        <view class="input-container">
          <input
            class="input-enhanced"
            placeholder="例如:800x800,300x600 等"
            placeholder-class="input-placeholder"
            value="{{ specification }}"
            data-field="specification"
            bindinput="onSpecInput"
            bindfocus="onInputFocus"
            bindblur="onInputBlur"
          />
        </view>
      </view>
    </view>

    <!-- 分类选择 - 增强版 -->
    <view class="form-item">
      <view class="input-wrapper {{ categoryName ? 'has-value' : '' }}">
        <text class="label-float">分类</text>
        <picker
          mode="selector"
          range="{{ categories }}"
          range-key="name"
          bindchange="onCategoryChange"
        >
          <view class="picker-container">
            <view class="picker-value-enhanced">
              {{ categoryName || '请选择产品分类' }}
            </view>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view class="input-hint">必须选择一个分类</view>
      </view>
    </view>

    <!-- 厚度 - 增强版 -->
    <view class="form-item">
      <view class="input-wrapper {{ (thickness || focusStates.thickness) ? 'has-value' : '' }}">
        <text class="label-float">厚度 (mm)</text>
        <view class="input-container">
          <input
            class="input-enhanced"
            type="digit"
            placeholder="可选,例如:9.5"
            placeholder-class="input-placeholder"
            value="{{ thickness }}"
            data-field="thickness"
            bindinput="onThicknessInput"
            bindfocus="onInputFocus"
            bindblur="onInputBlur"
          />
        </view>
        <view class="input-hint">可选填写</view>
      </view>
    </view>

    <!-- 描述 - 增强版 -->
    <view class="form-item">
      <view class="textarea-wrapper {{ (description || focusStates.description) ? 'has-value' : '' }}">
        <text class="label-float">产品描述</text>
        <view class="textarea-container">
          <textarea
            class="textarea-enhanced"
            placeholder="用于补充说明产品特性、用途等信息"
            placeholder-class="input-placeholder"
            value="{{ description }}"
            data-field="description"
            bindinput="onDescInput"
            bindfocus="onInputFocus"
            bindblur="onInputBlur"
            maxlength="1000"
          />
          <view class="char-count">{{ description ? description.length : 0 }}/1000</view>
        </view>
        <view class="input-hint">可选,最多1000字</view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-bar">
    <button
      class="submit-btn"
      type="primary"
      loading="{{ submitting }}"
      disabled="{{ submitting }}"
      bindtap="onSubmit"
    >
      保存产品
    </button>
  </view>
</view>
