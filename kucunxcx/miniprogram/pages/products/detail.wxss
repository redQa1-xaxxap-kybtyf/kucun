/* 产品详情页样式 - 2025年现代化设计 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f5f7 0%, #ffffff 40%, #fafafa 100%);
  padding-bottom: 180rpx;
  animation: fadeIn 0.6s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 主图轮播区域 - 紧凑型电商布局 */
.swiper-wrapper {
  position: relative;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5; /* 明确的分割线 */
}

/* 图片轮播 */
.product-swiper {
  width: 100%;
  height: 750rpx; /* 1:1 正方形主图，符合电商标准 */
  position: relative;
  background: #fff;
}

/* 轮播图片 */
.swiper-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 图片计数器 - 右下角胶囊 */
.image-counter {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  z-index: 10;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: normal;
}

/* 效果图网格 - Bento布局 */
.effect-images-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  padding: 32rpx;
  gap: 20rpx;
  animation: fadeInUp 0.6s ease-out 0.2s backwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 效果图 - 完整显示在固定容器内 */
.effect-image {
  width: 100%;
  height: 320rpx; /* 固定高度 */
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.1),
    0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  display: block; /* 去除底部空隙 */
  object-fit: cover; /* 覆盖容器，保持比例，可能裁剪 */
}

.effect-image:active {
  transform: scale(0.97);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.08),
    0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

/* 信息卡片 - 玻璃形态学 */
.info-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  margin: 24rpx 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  animation: slideInUp 0.5s ease-out backwards;
}

.info-card:nth-of-type(1) {
  animation-delay: 0.1s;
}
.info-card:nth-of-type(2) {
  animation-delay: 0.2s;
}
.info-card:nth-of-type(3) {
  animation-delay: 0.3s;
}
.info-card:nth-of-type(4) {
  animation-delay: 0.4s;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 产品标题 - 大胆字体 */
.product-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  position: relative;
}

/* 添加装饰性渐变条 */
.product-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 32rpx;
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 2rpx;
}

.product-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
  flex: 1;
  margin-right: 24rpx;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
}

.product-header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

/* 编辑按钮 - 2025年现代化设计 */
.edit-button {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 0 !important;
  height: 60rpx !important;
  line-height: 60rpx !important;
  padding: 0 28rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  border-radius: 30rpx !important;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  color: #ffffff !important;
  border: none !important;
  box-shadow:
    0 6rpx 20rpx rgba(102, 126, 234, 0.4),
    0 2rpx 8rpx rgba(118, 75, 162, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3) !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  position: relative !important;
  overflow: hidden !important;
  letter-spacing: 0.5rpx !important;
}

/* 按钮光泽效果 */
.edit-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.4) 50%,
    transparent 100%
  );
  transition: left 0.6s ease;
  pointer-events: none;
}

/* 按下效果 */
.edit-button:active {
  transform: scale(0.96) !important;
  box-shadow:
    0 3rpx 12rpx rgba(102, 126, 234, 0.35),
    0 1rpx 4rpx rgba(118, 75, 162, 0.25),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2) !important;
}

.edit-button:active::before {
  left: 100%;
}

/* 添加图标前缀 */
.edit-button::after {
  content: '✏️';
  margin-left: 8rpx;
  font-size: 24rpx;
  filter: brightness(1.2);
}

/* 卡片标题 - 极简设计 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  padding: 32rpx 32rpx 24rpx;
  background: linear-gradient(
    135deg,
    rgba(102, 126, 234, 0.03) 0%,
    rgba(118, 75, 162, 0.02) 100%
  );
  letter-spacing: 0.3rpx;
  position: relative;
}

/* 标题装饰图标 */
.card-title::before {
  content: '';
  position: absolute;
  left: 32rpx;
  bottom: 0;
  width: 60rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 2rpx;
}

/* 优化Vant标签样式 */
.van-tag {
  border-radius: 16rpx !important;
  padding: 8rpx 16rpx !important;
  font-size: 22rpx !important;
  font-weight: 600 !important;
  letter-spacing: 0.5rpx !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08) !important;
}

/* 产品描述 - 优化阅读体验 */
.product-description {
  padding: 32rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #3a3a3c;
  letter-spacing: 0.3rpx;
}

/* Override Vant Cell Styles if needed */
.van-cell {
  background-color: transparent !important; /* Let card bg show */
}
