<!-- 产品列表页 -->
<wxs src="../../utils/format.wxs" module="fmt" />

<view class="container {{ enableBackdropBlur ? '' : 'no-blur' }}">
  <!-- 搜索栏和筛选 -->
  <view class="search-section">
    <van-search
      value="{{ searchValue }}"
      placeholder="搜索产品名称或编码"
      bind:search="onSearch"
      bind:change="onSearchChange"
      bind:clear="onClearSearch"
      shape="round"
      background="transparent"
      show-action
    >
      <view slot="action" bind:tap="toggleFilter" class="filter-btn">
        <text class="filter-text">筛选</text>
        <van-icon name="filter-o" size="16px" color="#007aff" />
      </view>
    </van-search>
  </view>

  <!-- 筛选下拉菜单和布局切换 -->
  <view class="filter-layout-bar" wx:if="{{ showFilter }}">
    <van-dropdown-menu active-color="#007aff" class="filter-menu">
      <van-dropdown-item value="{{ filterCategory }}" options="{{ categoryOptions }}" bind:change="onCategoryChange" />
      <van-dropdown-item value="{{ filterStatus }}" options="{{ statusOptions }}" bind:change="onStatusChange" />
      <van-dropdown-item value="{{ filterSort }}" options="{{ sortOptions }}" bind:change="onSortChange" />
    </van-dropdown-menu>

    <view class="layout-switcher-compact">
      <view class="layout-icon {{ layoutMode === 'list' ? 'active' : '' }}" bindtap="switchToLayout" data-mode="list">
        <text>━</text>
      </view>
      <view class="layout-icon {{ layoutMode === 'grid-2' ? 'active' : '' }}" bindtap="switchToLayout" data-mode="grid-2">
        <text>▦</text>
      </view>
      <view class="layout-icon {{ layoutMode === 'grid-3' ? 'active' : '' }}" bindtap="switchToLayout" data-mode="grid-3">
        <text>▦</text>
      </view>
    </view>
  </view>

  <!-- 产品列表 - 使用scroll-view -->
  <scroll-view
    class="scroll-container"
    scroll-y
    bindscrolltolower="onLoadMore"
    lower-threshold="100"
  >
    <view class="product-list-wrapper layout-{{ layoutMode }}">
      <view
        wx:for="{{ products }}"
        wx:key="id"
        class="ios-product-card"
        bindtap="navigateToDetail"
        data-id="{{ item.id }}"
      >
        <image
          class="product-thumb"
          src="{{ item.thumbnailUrl || '/assets/images/placeholder.png' }}"
          mode="aspectFill"
        />

        <view class="product-content">
          <!-- 顶部：编码和状态 -->
          <view class="product-header">
            <text class="product-code">{{ item.code }}</text>
            <van-tag
              type="{{ item.inventory.availableQuantity > 0 ? 'success' : 'danger' }}"
              size="medium"
              custom-class="status-tag"
            >
              {{ item.inventory.availableQuantity > 0 ? '有货' : '缺货' }}
            </van-tag>
          </view>

          <!-- 中部：产品名称 -->
          <text class="product-name">{{ item.name }}</text>

          <!-- 底部：规格和库存 -->
          <view class="product-footer">
            <text class="product-spec">{{ item.specification || '默认规格' }}</text>
            <!-- 库存数字（有权限用户）单列模式靠右显示 -->
            <text
              class="product-stock {{ item.inventory.availableQuantity > 0 ? '' : 'text-danger' }}"
              wx:if="{{ item.inventory && canViewNumericInventory }}"
            >
              {{ fmt.formatQuantityWithPieces(item.inventory.availableQuantity, item.unit, item.piecesPerUnit) }}
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-footer" wx:if="{{ loading }}">
      <van-loading type="spinner" size="24px" color="#8E8E93">加载中...</van-loading>
    </view>

    <!-- 完成状态 -->
    <view class="finished-footer" wx:if="{{ finished && !loading && products.length > 0 }}">
      <text class="finished-text">没有更多了</text>
    </view>

    <!-- 空状态 -->
    <van-empty
      wx:if="{{ !loading && products.length === 0 }}"
      description="暂无产品"
      image="search"
    />
  </scroll-view>
</view>
