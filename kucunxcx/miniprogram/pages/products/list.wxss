/* 产品列表页样式 - Apple Style with Best Practices */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f7;
}

/* 搜索区域 */
.search-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 0.5px solid rgba(0,0,0,0.08);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.van-search__content {
  background-color: #f5f5f7 !important;
  box-shadow: none !important;
  border-radius: 12rpx !important;
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.icon-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background-color: transparent; /* Remove ugly gray bg */
  border-radius: 32rpx; /* Pill shape */
  transition: all 0.2s;
  border: 1rpx solid rgba(0,0,0,0.05); /* Subtle border */
}

.icon-btn:active {
  background-color: rgba(0,0,0,0.04);
  transform: scale(0.98);
}

.icon-btn .van-icon {
  font-size: 32rpx; /* Slightly larger icons */
}

.filter-text {
  font-size: 26rpx;
  color: #1d1d1f;
  font-weight: 500;
}

/* 滚动容器 */
.scroll-container {
  flex: 1;
  height: 100%;
}

/* 产品列表容器 - 单列模式 */
.product-list-wrapper {
  padding: 16rpx 24rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* iOS Style Product Card - 默认单列模式 */
.ios-product-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.ios-product-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.product-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f5f5f7 0%, #e8e8ed 100%);
  flex-shrink: 0;
  object-fit: cover;
}

.product-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-tag {
  flex-shrink: 0;
}

.product-code {
  font-size: 24rpx;
  color: #86868b;
  margin: 4rpx 0;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: 8rpx;
}

.product-spec {
  font-size: 22rpx;
  color: #86868b;
  background-color: #f5f5f7;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.product-stock {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
}

/* =========================
   网格布局模式
========================= */

/* 双列和三列共用样式 */
.layout-grid-2,
.layout-grid-3 {
  display: grid;
  padding: 12rpx 16rpx;
}

/* 双列布局 - 小红书风格 */
.layout-grid-2 {
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.layout-grid-2 .ios-product-card {
  flex-direction: column;
  padding: 0;
  margin-bottom: 0;
  gap: 0;
  border-radius: 12rpx;
}

.layout-grid-2 .product-thumb {
  width: 100%;
  height: 340rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: linear-gradient(135deg, #f5f5f7 0%, #e8e8ed 100%);
}

.layout-grid-2 .product-content {
  padding: 16rpx;
  gap: 8rpx;
  justify-content: flex-start;
}

.layout-grid-2 .product-header {
  margin-bottom: 4rpx;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.layout-grid-2 .product-name {
  font-size: 28rpx;
  -webkit-line-clamp: 2;
  line-height: 1.3;
}

.layout-grid-2 .product-code {
  font-size: 22rpx;
  margin: 0;
}

.layout-grid-2 .product-footer {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #f5f5f7;
}

.layout-grid-2 .product-stock {
  font-size: 24rpx;
}

/* 三列布局 - 淘宝风格 */
.layout-grid-3 {
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 12rpx 12rpx;
}

.layout-grid-3 .ios-product-card {
  flex-direction: column;
  padding: 0;
  margin-bottom: 0;
  gap: 0;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}

.layout-grid-3 .product-thumb {
  width: 100%;
  height: 220rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(135deg, #f5f5f7 0%, #e8e8ed 100%);
}

.layout-grid-3 .product-content {
  padding: 12rpx;
  gap: 6rpx;
  justify-content: flex-start;
}

.layout-grid-3 .product-header {
  margin-bottom: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.layout-grid-3 .product-name {
  font-size: 24rpx;
  -webkit-line-clamp: 2;
  line-height: 1.3;
  font-weight: 500;
}

.layout-grid-3 .product-code {
  display: none; /* 三列模式隐藏编码 */
}

.layout-grid-3 .product-footer {
  margin-top: 6rpx;
  padding-top: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.layout-grid-3 .product-spec {
  display: none; /* 三列模式隐藏规格 */
}

.layout-grid-3 .product-stock {
  font-size: 22rpx;
  font-weight: 600;
}

/* 库存不足样式 */
.product-stock.text-danger {
  color: #ff3b30;
}

/* 加载和完成状态 */
.loading-footer,
.finished-footer {
  padding: 32rpx 0 64rpx; /* Extra padding at bottom */
  text-align: center;
}

.finished-text {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
}

/* =========================
   筛选栏 - 整合筛选和布局切换
========================= */

/* =========================
   筛选栏 - 整合筛选和布局切换
========================= */

.filter-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-bottom: 0.5rpx solid rgba(0,0,0,0.05);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  position: sticky; /* Sticky below search */
  top: 108rpx; /* Approx height of search bar */
  z-index: 99;
}

.filter-dropdown {
  flex: 1;
  min-width: 0;
  --dropdown-menu-height: 88rpx;
  --dropdown-menu-background-color: transparent;
  --dropdown-menu-box-shadow: none;
}

/* Vant Dropdown Overrides */
.van-dropdown-menu__item {
  justify-content: flex-start !important;
  padding-left: 24rpx !important;
}

.van-dropdown-menu__title {
  font-size: 28rpx !important;
  color: #1d1d1f !important;
  font-weight: 500 !important;
}

.van-dropdown-menu__title--active {
  color: #0071E3 !important;
}

/* 布局切换按钮组 - iOS Segmented Control Style */
.layout-switcher {
  display: flex;
  align-items: center;
  padding: 6rpx;
  margin-right: 24rpx;
  background-color: #f2f2f7; /* Track color */
  border-radius: 16rpx;
  height: 64rpx; /* Fixed height */
  box-sizing: border-box;
}

.layout-btn {
  width: 60rpx;
  height: 52rpx; /* Fit inside track */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  color: #8E8E93;
  position: relative;
}

.layout-btn:active {
  opacity: 0.7;
}

.layout-btn.active {
  color: #1d1d1f;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.12); /* Pop out effect */
}

