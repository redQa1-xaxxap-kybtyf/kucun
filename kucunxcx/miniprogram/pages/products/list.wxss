/* 产品列表页样式 - 2025年现代化设计 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg,
    #f5f5f7 0%,
    #ffffff 30%,
    #fafafa 100%);
}

/* 搜索区域 - 玻璃形态学 */
.search-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  padding: 8rpx 0;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.filter-layout-bar {
  display: flex;
  align-items: center;
  background: #fff;
  flex-wrap: nowrap;
  padding: 0 8rpx 0 0;  /* 右侧小内边距 */
}

.filter-menu {
  flex: 1;
  min-width: 0;
}

.layout-switcher-compact {
  display: flex;
  align-items: center;
  gap: 2rpx;  /* 减小间距 */
  padding: 0 8rpx;  /* 减小左右内边距 */
  border-left: 1rpx solid #eee;
  flex-shrink: 0;
}

.layout-icon {
  width: 44rpx;  /* 减小宽度 */
  height: 44rpx;  /* 减小高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  transition: all 0.2s ease;
  color: #999;
  font-size: 18rpx;  /* 减小图标字号 */
}

.layout-icon.active {
  background: #667eea;
  color: #fff;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.filter-text {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 500;
}

/* 滚动容器 */
.scroll-container {
  flex: 1;
  height: 100%;
}

/* 产品列表容器 */
.product-list-wrapper {
  padding: 24rpx 28rpx;
}

/* 单排布局 */
.product-list-wrapper.layout-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 双排布局 */
.product-list-wrapper.layout-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 三排布局 */
.product-list-wrapper.layout-grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

/* 2025年现代化产品卡片 - 精致美化 */
.ios-product-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.08),
    0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

/* 双排和三排布局下的卡片样式 */
.layout-grid-2 .ios-product-card,
.layout-grid-3 .ios-product-card {
  flex-direction: column;
  gap: 0;
  padding: 16rpx;
}

.layout-grid-3 .ios-product-card {
  border-radius: 16rpx;
  padding: 12rpx;
}

/* 卡片悬停效果 */
.ios-product-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg,
    rgba(102, 126, 234, 0.02) 0%,
    rgba(118, 75, 162, 0.01) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.ios-product-card:active {
  transform: scale(0.98);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.06),
    0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.ios-product-card:active::before {
  opacity: 1;
}

/* 产品缩略图 - 优化显示 */
.product-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
  object-fit: cover;
}

/* 双排布局下的图片 - 调整为接近正方形 */
.layout-grid-2 .product-thumb {
  width: 100%;
  aspect-ratio: 1;  /* 正方形比例 */
  height: auto;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* 三排布局下的图片 - 保持正方形 */
.layout-grid-3 .product-thumb {
  width: 100%;
  aspect-ratio: 1;  /* 正方形比例 */
  height: auto;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.ios-product-card:active .product-thumb {
  transform: scale(0.95);
}

.product-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

/* 双排和三排布局下的内容区域 */
.layout-grid-2 .product-content,
.layout-grid-3 .product-content {
  gap: 10rpx;
  padding-top: 8rpx;
}

/* 顶部：产品编码和状态 */
.product-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

/* 产品编码 - 主要标识，视觉突出 */
.product-code {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  letter-spacing: 0.3rpx;
  flex: 1;

  /* 单行截断 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 三排布局下的编码字体缩小 */
.layout-grid-3 .product-code {
  font-size: 24rpx;
  font-weight: 600;
}

/* 状态标签 */
.status-tag {
  flex-shrink: 0;
  border-radius: 12rpx !important;
  padding: 8rpx 16rpx !important;
  font-size: 22rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1) !important;
}

/* 三排布局下的状态标签缩小 */
.layout-grid-3 .status-tag {
  padding: 6rpx 12rpx !important;
  font-size: 20rpx !important;
  border-radius: 10rpx !important;
}

/* 产品名称 - 次要信息，清晰可读 */
.product-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #444444;
  line-height: 1.6;

  /* 双行截断 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

/* 三排布局下的名称字体缩小 */
.layout-grid-3 .product-name {
  font-size: 22rpx;
  -webkit-line-clamp: 1;
  line-height: 1.5;
}

/* 底部：规格和库存 - 改为垂直布局避免遮盖 */
.product-footer {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-start;
}

/* 单列布局下的底部区域 - 库存靠右 */
.layout-list .product-footer {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

/* 产品规格 - 完整显示,不被压缩 */
.product-spec {
  font-size: 24rpx;
  font-weight: 400;
  color: #888888;
  line-height: 1.5;
  width: 100%;

  /* 单行截断 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 单列布局下的规格 - 自适应宽度 */
.layout-list .product-spec {
  width: auto;
  flex: 1;
  min-width: 0;
}

/* 三排布局下的规格字体缩小 */
.layout-grid-3 .product-spec {
  font-size: 20rpx;
}

/* 库存显示 - 独立一行清晰显示 */
.product-stock {
  font-size: 24rpx;
  font-weight: 600;
  color: #34c759;
  padding: 8rpx 14rpx;
  background: linear-gradient(135deg,
    rgba(52, 199, 89, 0.12) 0%,
    rgba(52, 199, 89, 0.06) 100%);
  border-radius: 10rpx;
  white-space: nowrap;
  align-self: flex-start;
  line-height: 1.3;
  box-shadow: 0 2rpx 6rpx rgba(52, 199, 89, 0.15);
}

/* 单列布局下的库存 - 保持紧凑不拉伸 */
.layout-list .product-stock {
  flex-shrink: 0;
  align-self: center;
}

/* 三排布局下的库存显示 */
.layout-grid-3 .product-stock {
  font-size: 20rpx;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
}

/* 三排布局下的底部区域 - 空间紧张时保持紧凑 */
.layout-grid-3 .product-footer {
  gap: 6rpx;
}

/* 双排布局下的底部区域 - 适中间距 */
.layout-grid-2 .product-footer {
  gap: 10rpx;
}

.product-stock.text-danger {
  color: #ff3b30;
  background: linear-gradient(135deg,
    rgba(255, 59, 48, 0.12) 0%,
    rgba(255, 59, 48, 0.06) 100%);
  box-shadow: 0 2rpx 6rpx rgba(255, 59, 48, 0.15);
}

/* 加载和完成状态 - 优化样式 */
.loading-footer,
.finished-footer {
  padding: 40rpx 0 80rpx;
  text-align: center;
}

.finished-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.3);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 加载动画优化 */
.loading-footer .van-loading {
  color: #667eea !important;
}

/* 空状态优化 */
.van-empty {
  padding: 80rpx 0 !important;
}

.van-empty__image {
  opacity: 0.5;
}
