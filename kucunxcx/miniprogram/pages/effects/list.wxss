/* 效果图列表页样式 - Apple Style */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg,
    #f5f5f7 0%,
    #ffffff 30%,
    #fafafa 100%);
}

/* 搜索区域 */
.search-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  padding: 8rpx 0;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 操作提示条 */
.action-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  margin: 16rpx 24rpx 0;
  background: rgba(134, 134, 139, 0.1);
  border-radius: 12rpx;
}

.action-tip text {
  font-size: 24rpx;
  color: #86868B;
  flex: 1;
}

/* 滚动容器 */
.effect-scroll {
  flex: 1;
  height: 100%;
}

/* 效果图网格 - 两列布局 */
.effect-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 24rpx;
}

/* 效果图卡片 */
.effect-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.08),
    0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.effect-card:active {
  transform: scale(0.98);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 图片容器 - 正方形 */
.effect-img-box {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
}

.effect-img-box image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 收藏标记 */
.favorite-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 产品编码信息 */
.effect-info {
  padding: 16rpx 20rpx 20rpx;
  background: #ffffff;
}

.effect-code {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.effect-name {
  font-size: 24rpx;
  font-weight: 400;
  color: #86868B;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

/* 浏览量和点赞量 */
.effect-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-item text {
  font-size: 22rpx;
  color: #86868B;
}

/* 加载更多 */
.load-more-footer {
  padding: 32rpx 0;
  text-align: center;
}

.no-more-text {
  font-size: 24rpx;
  color: #86868B;
}

/* 底部安全区 */
.safe-area-bottom {
  height: 60rpx;
}

/* ==================== 分享弹窗样式 ==================== */
.share-popup {
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.share-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  text-align: center;
  margin-bottom: 16rpx;
}

.share-info {
  font-size: 26rpx;
  color: #86868B;
  text-align: center;
  margin-bottom: 32rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  border: none;
  margin-bottom: 24rpx;
}

.share-btn text {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}

.share-cancel {
  font-size: 28rpx;
  color: #86868B;
  text-align: center;
  padding: 16rpx;
}

/* ==================== 骨架屏样式 ==================== */
.skeleton-card {
  pointer-events: none;
}

.skeleton-img {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-text {
  border-radius: 4rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-code {
  width: 70%;
  height: 28rpx;
  margin: 0 auto;
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
