<!-- 效果图详情页 -->
<view class="container">
  <!-- 图片区域 -->
  <swiper
    class="image-swiper"
    current="{{ currentIndex }}"
    bindchange="onSwiperChange"
    circular="{{ effectList.length > 1 }}"
  >
    <swiper-item wx:for="{{ effectList }}" wx:key="imageUrl">
      <image
        class="effect-image"
        src="{{ item.imageUrl }}"
        mode="aspectFit"
        bindtap="previewImage"
        data-url="{{ item.imageUrl }}"
      />
    </swiper-item>
  </swiper>

  <!-- 图片指示器 -->
  <view class="image-indicator" wx:if="{{ effectList.length > 1 }}">
    <text>{{ currentIndex + 1 }} / {{ effectList.length }}</text>
  </view>

  <!-- 产品信息 -->
  <view class="info-section">
    <view class="info-header">
      <view class="info-left">
        <view class="product-code">{{ currentItem.productCode }}</view>
        <view class="product-name">{{ currentItem.productName }}</view>
      </view>
      <view class="view-product-btn" bindtap="goToProduct">
        <text>查看产品</text>
        <van-icon name="arrow" size="12px" color="#fff" />
      </view>
    </view>
    <view class="product-meta">
      <view class="meta-item">
        <van-icon name="eye-o" size="14px" color="#86868B" />
        <text>{{ currentItem.viewCount || 0 }} 次浏览</text>
      </view>
      <view class="meta-item" wx:if="{{ effectList.length > 1 }}">
        <van-icon name="photo-o" size="14px" color="#86868B" />
        <text>共 {{ effectList.length }} 张效果图</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <van-goods-action safe-area-inset-bottom>
    <van-goods-action-icon
      icon="share-o"
      text="分享"
      open-type="share"
    />
    <van-goods-action-icon
      icon="{{ currentItem.isFavorite ? 'star' : 'star-o' }}"
      text="{{ currentItem.isFavorite ? '已收藏' : '收藏' }}"
      bind:click="toggleFavorite"
      color="{{ currentItem.isFavorite ? '#FFD700' : '' }}"
    />
  </van-goods-action>
</view>
