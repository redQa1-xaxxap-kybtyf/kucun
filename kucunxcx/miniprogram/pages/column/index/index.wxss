/* 罗马柱首页样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #ffffff 100%);
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 顶部标题 - 优化间距和排版 */
.header {
  padding: 48rpx 0 48rpx;
  text-align: left; /* 改为左对齐，更有设计感 */
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: #111827;
  letter-spacing: -1rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(135deg, #111827 0%, #4b5563 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 30rpx;
  color: #6b7280;
  font-weight: 500;
}

/* 功能卡片 - Premium Design */
.feature-cards {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.feature-card {
  border-radius: 40rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.feature-card:active {
  transform: scale(0.98);
}

.card-content-wrapper {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 40rpx;
  min-height: 220rpx;
}

/* 主卡片（快速拼柱）- Deep Purple Aurora */
.feature-card.primary {
  background: radial-gradient(110% 180% at 0% 0%, #7c3aed 0%, #4f46e5 100%);
  box-shadow:
    0 20rpx 40rpx -12rpx rgba(124, 58, 237, 0.4),
    0 12rpx 20rpx -8rpx rgba(79, 70, 229, 0.3),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.15);
}

/* 波浪装饰 */
.card-wave {
  position: absolute;
  left: -20%;
  bottom: -40%;
  width: 140%;
  height: 100%;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(255, 255, 255, 0.1) 0%,
    rgba(255, 255, 255, 0) 60%
  );
  border-radius: 40%;
  animation: wave 8s infinite linear;
  opacity: 0.6;
}

.card-wave.wave-2 {
  left: 0%;
  bottom: -50%;
  width: 150%;
  animation: wave 12s infinite linear reverse;
  opacity: 0.3;
}

@keyframes wave {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 次要卡片（产品查找）- Clean Glass */
.feature-card.secondary {
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.03),
    0 10rpx 40rpx -10rpx rgba(0, 0, 0, 0.05);
}

.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-right: 32rpx;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.card-title.dark {
  color: #111827;
  text-shadow: none;
}

.card-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #ffffff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transform: translateY(-2rpx);
}

.card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  line-height: 1.4;
}

.card-desc.dark {
  color: #6b7280;
}

/* --- CSS 纯绘图标与插画 --- */
.card-illustration {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  position: relative;
}

/* 罗马柱图标 */
.icon-column {
  width: 60rpx;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  opacity: 0.9;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
}

.col-cap {
  width: 52rpx;
  height: 12rpx;
  background: #ffffff;
  border-radius: 4rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.col-body {
  width: 36rpx;
  flex: 1;
  background: linear-gradient(90deg, #e0e7ff 0%, #ffffff 50%, #e0e7ff 100%);
  border-radius: 4rpx;
  box-shadow: inset 0 0 4rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

/* 柱身纹理 */
.col-body::after {
  content: '';
  position: absolute;
  top: 0;
  left: 30%;
  width: 40%;
  height: 100%;
  background: rgba(0, 0, 0, 0.05);
}

.col-base {
  width: 52rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 4rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 搜索图标 CSS */
.icon-search {
  width: 80rpx;
  height: 80rpx;
  position: relative;
}

.search-glass {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #10b981;
  border-radius: 50%;
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  box-sizing: border-box;
}

.search-handle {
  width: 24rpx;
  height: 6rpx;
  background: #10b981;
  border-radius: 4rpx;
  position: absolute;
  bottom: 18rpx;
  right: 14rpx;
  transform: rotate(45deg);
  transform-origin: 0 50%;
}

/* 使用说明 - 优化 */
.info-section {
  margin-top: 64rpx;
  background: #ffffff; /* 确保使用白色背景 */
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03); /* 降低阴影强度 */
  border: 1rpx solid rgba(0, 0, 0, 0.03); /* 添加极淡边框 */
}

.info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 32rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 28rpx;
  color: #333;
}

/* 底部按钮 */
.bottom-action {
  padding: 48rpx 0 64rpx;
}

.btn-back {
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 48rpx;
  padding: 24rpx 0;
  border: none;
}

.btn-back::after {
  border: none;
}
