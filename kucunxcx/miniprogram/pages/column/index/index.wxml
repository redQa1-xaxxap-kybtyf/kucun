<!-- 罗马柱首页入口 -->
<view class="container">
  <!-- 顶部标题区域 -->
  <view class="header">
    <view class="header-content">
      <text class="title">罗马柱配砖助手</text>
      <text class="subtitle">快速生成柱体用砖清单</text>
    </view>
  </view>

  <!-- 功能入口卡片 -->
  <view class="feature-cards">
    <!-- 快速拼柱入口 (Premium Card) -->
    <view class="feature-card primary" bindtap="onStartBuild">
      <!-- 动态波浪背景 -->
      <view class="card-wave"></view>
      <view class="card-wave wave-2"></view>
      
      <view class="card-content-wrapper">
        <view class="card-main">
          <view class="card-header">
            <text class="card-title">设计</text>
            <view class="card-badge">推荐</view>
          </view>
          <text class="card-desc">输入高度 · 智能推荐 · 一键出单</text>
        </view>
        
        <!-- 右侧装饰插图 -->
        <view class="card-illustration">
          <!-- CSS 绘制柱子图标 -->
          <view class="icon-column">
             <view class="col-cap"></view>
             <view class="col-body"></view>
             <view class="col-base"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 产品查找入口 (Clean Card) -->
    <view class="feature-card secondary" bindtap="onSearchMaterial">
      <view class="card-content-wrapper">
        <view class="card-main">
          <view class="card-header">
            <text class="card-title dark">找砖</text>
          </view>
          <text class="card-desc dark">浏览素材 · 精准搜索 · 自由搭配</text>
        </view>
        
        <view class="card-illustration secondary">
          <!-- CSS 绘制搜索图标 -->
          <view class="icon-search">
            <view class="search-glass"></view>
            <view class="search-handle"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 使用说明 -->
  <view class="info-section">
    <view class="info-title">使用说明</view>
    <view class="info-list">
      <view class="info-item">
        <text class="step-num">1</text>
        <text class="step-text">输入罗马柱目标高度</text>
      </view>
      <view class="info-item">
        <text class="step-num">2</text>
        <text class="step-text">选择柱身、底座、盖帽图案</text>
      </view>
      <view class="info-item">
        <text class="step-num">3</text>
        <text class="step-text">系统自动生成用砖清单</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-action">
    <button class="btn-back" bindtap="onBackHome">返回首页</button>
  </view>
</view>
