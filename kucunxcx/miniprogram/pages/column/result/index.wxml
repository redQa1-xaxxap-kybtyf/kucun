<!-- Step 3: 用砖清单结果页 -->
<view class="container">
  <!-- 步骤指示器 -->
  <view class="step-indicator">
    <view class="step completed">
      <text class="step-num">✓</text>
      <text class="step-label">输入高度</text>
    </view>
    <view class="step-line completed"></view>
    <view class="step completed">
      <text class="step-num">✓</text>
      <text class="step-label">选择造型</text>
    </view>
    <view class="step-line completed"></view>
    <view class="step active">
      <text class="step-num">3</text>
      <text class="step-label">生成清单</text>
    </view>
  </view>

  <!-- 结果概览卡片 -->
  <view class="result-summary-card">
    <view class="summary-header">
      <text class="summary-title">🎉 用砖清单已生成</text>
    </view>
    <view class="summary-stats">
      <view class="stat-item">
        <text class="stat-label">目标高度</text>
        <text class="stat-value">{{targetHeight}} mm</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">用砖高度</text>
        <text class="stat-value">{{buildHeight}} mm</text>
      </view>
      <view class="stat-item" wx:if="{{delta !== 0}}">
        <text class="stat-label">差值</text>
        <text class="stat-value {{delta > 0 ? 'cut' : 'insufficient'}}">
          {{delta > 0 ? '超出' : '不足'}} {{delta > 0 ? delta : -delta}} mm
        </text>
      </view>
    </view>

    <!-- 切割说明 -->
    <view class="cut-info" wx:if="{{delta > 0 && cutPosition}}">
      <view class="cut-badge">需切割</view>
      <view class="cut-content">
        <text class="cut-text">默认切割位置：{{cutPosition}}</text>
        <view class="cut-action" bindtap="onChangeCutPosition">修改</view>
      </view>
    </view>
  </view>

  <!-- 用砖清单 -->
  <view class="brick-list-section">
    <view class="section-title">用砖清单</view>
    
    <!-- 按面型分组 -->
    <view class="face-type-group" wx:for="{{brickList}}" wx:key="faceType">
      <view class="face-type-header">
        <text class="face-type-name">{{item.faceTypeDesc}}</text>
      </view>
      <view class="brick-items">
        <view class="brick-item" wx:for="{{item.items}}" wx:for-item="brick" wx:key="index">
          <view class="brick-slot">
            <text class="slot-badge {{brick.cutHeight ? 'cut' : ''}}">{{brick.slotDesc}}</text>
          </view>
          <view class="brick-info">
            <text class="brick-code">{{brick.code}}</text>
            <text class="brick-note" wx:if="{{brick.note}}">{{brick.note}}</text>
          </view>
          <view class="brick-quantity">
            <text>× {{brick.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-actions">
    <button class="btn-secondary" bindtap="onRebuild">重新拼柱</button>
    <button class="btn-primary" bindtap="onBackHome">完成</button>
  </view>
</view>

<!-- 切割位置选择弹层 -->
<view class="cut-picker-mask" wx:if="{{showCutPositionPicker}}" bindtap="closeCutPositionPicker">
  <view class="cut-picker" catchtap="">
    <view class="picker-header">
      <text class="picker-title">选择切割位置</text>
      <view class="picker-close" bindtap="closeCutPositionPicker">×</view>
    </view>
    <view class="picker-content">
      <view class="cut-hint">需要切割：{{delta}} mm</view>
      <view class="cut-options">
        <view 
          class="cut-option"
          wx:for="{{cuttableSlots}}"
          wx:key="type"
          data-slot="{{item.type}}"
          bindtap="onSelectCutPosition"
        >
          <text class="option-name">{{item.name}}</text>
          <text class="option-arrow">→</text>
        </view>
      </view>
    </view>
  </view>
</view>
