/* Step 3: 用砖清单结果页样式 */

.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 32rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0 32rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.step.active .step-num {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.step.completed .step-num {
  background: #10b981;
  color: #ffffff;
}

.step-label {
  font-size: 22rpx;
  color: #999;
}

.step.active .step-label {
  color: #667eea;
  font-weight: 500;
}

.step.completed .step-label {
  color: #10b981;
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  background: #e0e0e0;
  margin: 0 16rpx;
  margin-bottom: 24rpx;
}

.step-line.completed {
  background: #10b981;
}

/* 结果概览卡片 */
.result-summary-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.summary-header {
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 36rpx;
  font-weight: 600;
}

.summary-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  min-width: calc(50% - 8rpx);
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
}

.stat-value.cut {
  color: #fbbf24;
}

.stat-value.insufficient {
  color: #f87171;
}

/* 切割说明 */
.cut-info {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
}

.cut-badge {
  background: #fbbf24;
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.cut-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cut-text {
  font-size: 26rpx;
}

.cut-action {
  font-size: 26rpx;
  text-decoration: underline;
  opacity: 0.9;
}

/* 用砖清单区域 */
.brick-list-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.face-type-group {
  margin-bottom: 24rpx;
}

.face-type-group:last-child {
  margin-bottom: 0;
}

.face-type-header {
  background: #f8f9fa;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.face-type-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
}

.brick-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.brick-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.brick-slot {
  margin-right: 16rpx;
}

.slot-badge {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
}

.slot-badge.cut {
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
}

.brick-info {
  flex: 1;
}

.brick-code {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  display: block;
}

.brick-note {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.brick-quantity {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-secondary {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 48rpx;
  padding: 28rpx 0;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-primary {
  flex: 2;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 28rpx 0;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* 切割位置选择弹层 */
.cut-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.cut-picker {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.picker-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.picker-content {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.cut-hint {
  text-align: center;
  font-size: 28rpx;
  color: #f59e0b;
  margin-bottom: 24rpx;
}

.cut-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cut-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 16rpx;
}

.cut-option:active {
  background: #f0f0f0;
}

.option-name {
  font-size: 30rpx;
  color: #1a1a1a;
}

.option-arrow {
  font-size: 28rpx;
  color: #999;
}
