<!-- 产品查找页面 (三栏布局改造) -->
<view class="container">

  <!-- 顶部颜色筛选栏 -->
  <scroll-view class="color-filter-bar" scroll-x show-scrollbar="{{false}}">
    <view class="color-filter-inner">
      <view
        class="color-btn {{filters.color === item.value ? 'active' : ''}}"
        wx:for="{{colorOptions}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onColorChange"
      >
        <view class="color-dot" style="background: {{item.color || '#ddd'}}"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 主体内容区 -->
  <view class="main-content">
    <!-- 左侧分类导航 -->
    <scroll-view class="category-nav" scroll-y show-scrollbar="{{false}}">
      <view
        class="nav-item {{filters.slot === item.value ? 'active' : ''}}"
        wx:for="{{categoryOptions}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onCategoryChange"
      >
        <view class="nav-indicator"></view>
        <text>{{item.label}}</text>
      </view>
    </scroll-view>

    <!-- 右侧产品网格 -->
    <scroll-view 
      class="product-grid-scroll" 
      scroll-y 
      show-scrollbar="{{false}}"
      bindscrolltolower="onReachBottom"
      refresher-enabled
      bindrefresherrefresh="onPullDownRefresh"
      refresher-triggered="{{loading && page === 1}}"
    >
      <!-- 网格容器 -->
      <view class="product-grid" wx:if="{{materials.length > 0}}">
        <view
          class="product-card"
          wx:for="{{materials}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onMaterialTap"
        >
          <image class="product-image" src="{{item.image}}" mode="aspectFill" lazy-load />
          <view class="product-info">
            <text class="product-code">{{item.code}}</text>
            <view class="product-tag" wx:if="{{item.height}}">{{item.height}}</view>
          </view>
          <!-- 选中状态打钩 (如果是从拼柱页面过来) -->
          <view class="selected-mark" wx:if="{{fromBuild && selectedMaterialId === item.id}}">
            <van-icon name="success" color="#fff" size="14px" />
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:elif="{{!loading}}">
        <van-icon name="apps-o" size="48px" color="#E5E7EB" />
        <text class="empty-text">暂无此类产品</text>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{loadingMore}}">
        <van-loading type="spinner" size="20px" />
      </view>
      <view class="no-more" wx:elif="{{!hasMore && materials.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 搜索弹窗 (保留简单搜索功能) -->
<van-popup
  show="{{showSearchPanel}}"
  position="top"
  custom-style="height: auto; background: transparent;"
  bind:close="closeSearchPanel"
>
  <view class="search-panel">
    <view class="search-input-box">
      <van-icon name="search" size="18px" color="#999" />
      <input 
        class="search-input"
        placeholder="输入产品编号搜索" 
        focus="{{showSearchPanel}}"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
    </view>
  </view>
</van-popup>
