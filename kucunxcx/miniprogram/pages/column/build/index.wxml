<!-- Step 2: 拼柱页面 -->
<view class="container">
  <!-- 步骤指示器 -->
  <view class="step-indicator">
    <view class="step completed">
      <view class="step-icon">
        <van-icon name="success" size="14px" color="#fff" />
      </view>
      <text class="step-label">输入高度</text>
    </view>
    <view class="step-line active"></view>
    <view class="step active">
      <view class="step-icon">2</view>
      <text class="step-label">选择造型</text>
    </view>
    <view class="step-line"></view>
    <view class="step">
      <view class="step-icon">3</view>
      <text class="step-label">生成清单</text>
    </view>
  </view>

  <!-- 高度状态卡片 (Premium Grid) -->
  <view class="status-grid">
    <view class="status-card">
      <text class="status-label">目标高度</text>
      <text class="status-value">{{targetHeight}} <text class="unit">mm</text></text>
    </view>
    <view class="status-card">
      <text class="status-label">当前高度</text>
      <text class="status-value {{deltaStatus.status === 'perfect' ? 'success' : 'normal'}}">{{buildHeight}} <text class="unit">mm</text></text>
    </view>
  </view>
  
  <view class="status-message-bar {{deltaStatus.status}}">
    <view class="status-icon">
      <van-icon name="{{deltaStatus.status === 'perfect' ? 'success' : deltaStatus.status === 'cut' ? 'warn-o' : deltaStatus.status === 'empty' ? 'info-o' : 'close'}}" color="#fff" size="14px" />
    </view>
    <text class="status-desc">{{deltaStatus.message}}</text>
  </view>

  <!-- 柱体结构预览 -->
  <view class="structure-section">
    <view class="section-title">柱体结构</view>
    <view class="structure-list">
      <!-- 列表渲染改写，不再依赖 slot.icon -->
      <view 
        class="structure-card {{currentSlot === slot.type ? 'active' : ''}}"
        wx:for="{{slots}}"
        wx:key="type"
        wx:for-item="slot"
        data-slot="{{slot.type}}"
        bindtap="onSlotTap"
      >
        <!-- CSS 矢量图标容器 -->
        <view class="slot-icon-box {{slot.type.toLowerCase()}}">
          <view class="css-icon-shape"></view>
        </view>

        <view class="slot-info">
          <text class="slot-name">{{slot.name}}</text>
          <text class="slot-desc" wx:if="{{faceTypes[currentFaceTypeIndex].materials[slot.type].code}}">
            <text class="code">{{faceTypes[currentFaceTypeIndex].materials[slot.type].code}}</text>
            <text class="segments" wx:if="{{slot.type === 'BODY'}}"> × {{faceTypes[currentFaceTypeIndex].materials[slot.type].segments}}</text>
          </text>
          <text class="slot-desc placeholder" wx:else>点击选择素材</text>
        </view>

        <!-- 操作区 -->
        <view class="slot-action">
          <!-- 只有柱身显示加减按钮 -->
          <view class="stepper-box" wx:if="{{slot.type === 'BODY' && faceTypes[currentFaceTypeIndex].materials[slot.type].code}}" catchtap="noop">
            <view 
              class="step-btn minus" 
              data-slot="{{slot.type}}" 
              data-action="minus"
              catchtap="onSegmentChange"
            >
              <van-icon name="minus" size="10px" />
            </view>
            <text class="step-val">{{faceTypes[currentFaceTypeIndex].materials[slot.type].segments}}</text>
            <view 
              class="step-btn plus" 
              data-slot="{{slot.type}}" 
              data-action="add"
              catchtap="onSegmentChange"
            >
              <van-icon name="plus" size="10px" />
            </view>
          </view>
          
          <van-icon wx:else name="arrow" color="#D1D5DB" size="16px" />
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-actions">
    <button class="btn-back" bindtap="onBack">上一步</button>
    <button 
      class="btn-generate {{canGenerate ? '' : 'disabled'}}" 
      bindtap="onGenerateScheme"
    >
      生成用砖清单
    </button>
  </view>
</view>

<!-- 素材选择弹层 -->
<view class="material-picker-mask" wx:if="{{showMaterialPicker}}" bindtap="closeMaterialPicker">
  <view class="material-picker" catchtap="">
    <view class="picker-header">
      <text class="picker-title">选择{{currentSlot === 'BODY' ? '柱身' : currentSlot === 'BASE' ? '底座' : '盖帽'}}素材</text>
      <view class="picker-close" bindtap="closeMaterialPicker">×</view>
    </view>
    <view class="picker-content">
      <view class="loading-state" wx:if="{{loadingMaterials}}">
        <text>加载中...</text>
      </view>
      <view class="material-grid" wx:elif="{{availableMaterials.length > 0}}">
        <view 
          class="material-item"
          wx:for="{{availableMaterials}}"
          wx:key="id"
          data-material="{{item}}"
          bindtap="onMaterialSelect"
        >
          <image class="material-image" src="{{item.image}}" mode="aspectFill" />
          <view class="material-info">
            <text class="material-code">{{item.code}}</text>
            <text class="material-height">{{item.height}}mm</text>
            <view class="material-tag" wx:if="{{item.cuttable}}">可切</view>
            <view class="material-tag disabled" wx:else>不可切</view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:else>
        <text>暂无可用素材</text>
      </view>
    </view>
  </view>
</view>
