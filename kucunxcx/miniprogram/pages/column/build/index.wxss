/* Step 2: 拼柱页面样式 */

.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 32rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0 48rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.step-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #9CA3AF;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
  border: 4rpx solid #f5f6fa;
}

.step.active .step-icon {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

.step.completed .step-icon {
  background: #10B981;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.step-label {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 500;
}

.step.active .step-label {
  color: #6366F1;
  font-weight: 600;
}

.step.completed .step-label {
  color: #10B981;
  font-weight: 600;
}

.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #E5E7EB;
  margin: 0 8rpx;
  margin-bottom: 36rpx;
  border-radius: 2rpx;
}

.step-line.active {
  background: #10B981;
}

/* 高度状态卡片 - Premium Grid */
.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.status-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}

.status-label {
  font-size: 24rpx;
  color: #6B7280;
}

.status-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.status-value.success {
  color: #10B981;
}

.unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #9CA3AF;
  margin-left: 4rpx;
}

.status-message-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.status-message-bar.perfect {
  background: #10B981;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.status-message-bar.empty {
  background: #6366F1;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

.status-message-bar.cut {
  background: #F59E0B;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.status-message-bar.insufficient {
  background: #EF4444;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.3);
}

.status-icon {
  margin-right: 16rpx;
  display: flex;
  opacity: 0.9;
}

/* 柱体结构区域 */
.structure-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-left: 8rpx;
  margin-bottom: 8rpx;
}

.structure-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.structure-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.structure-card:active {
  transform: scale(0.99);
  box-shadow: none;
}

.structure-card.active {
  border-color: #6366F1;
  background: linear-gradient(135deg, #ffffff 0%, #EEF2FF 100%);
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.15);
}

/* CSS 矢量图标 */
.slot-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.structure-card.active .slot-icon-box {
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.css-icon-shape {
  background: #9CA3AF;
  width: 48rpx;
  height: 48rpx;
}

/* 盖帽 - 梯形 */
.slot-icon-box.cap .css-icon-shape {
  height: 32rpx;
  background: linear-gradient(180deg, #6B7280 0%, #4B5563 100%);
  clip-path: polygon(20% 0%, 80% 0%, 100% 100%, 0% 100%);
  border-radius: 4rpx;
}
.structure-card.active .slot-icon-box.cap .css-icon-shape {
  background: linear-gradient(180deg, #818CF8 0%, #6366F1 100%);
}

/* 柱头 - 倒梯形 + 矩形 (类似多立克柱头) */
.slot-icon-box.head .css-icon-shape {
  height: 36rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.slot-icon-box.head .css-icon-shape::before {
  content: '';
  width: 100%;
  height: 12rpx;
  background: #6B7280;
  border-radius: 4rpx 4rpx 0 0;
  margin-bottom: 2rpx;
}
.slot-icon-box.head .css-icon-shape::after {
  content: '';
  width: 70%;
  height: 22rpx;
  background: #4B5563;
  clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);
}
.structure-card.active .slot-icon-box.head .css-icon-shape::before {
  background: #818CF8;
}
.structure-card.active .slot-icon-box.head .css-icon-shape::after {
  background: #6366F1;
}

/* 柱身 - 竖条纹圆柱 */
.slot-icon-box.body .css-icon-shape {
  height: 56rpx;
  width: 40rpx;
  background: repeating-linear-gradient(
    90deg,
    #9CA3AF,
    #9CA3AF 4rpx,
    #D1D5DB 4rpx,
    #D1D5DB 8rpx
  );
  border: 1rpx solid #9CA3AF;
}
.structure-card.active .slot-icon-box.body .css-icon-shape {
  background: repeating-linear-gradient(
    90deg,
    #818CF8,
    #818CF8 4rpx,
    #C7D2FE 4rpx,
    #C7D2FE 8rpx
  );
  border-color: #6366F1;
}

/* 底座 - 阶梯形 */
.slot-icon-box.base .css-icon-shape {
  height: 36rpx;
  width: 52rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.slot-icon-box.base .css-icon-shape::before {
  content: '';
  width: 70%;
  height: 40%;
  background: #6B7280;
  margin-bottom: 2rpx;
  border-radius: 4rpx 4rpx 0 0;
}
.slot-icon-box.base .css-icon-shape::after {
  content: '';
  width: 100%;
  height: 60%;
  background: #4B5563;
  border-radius: 4rpx;
}
.structure-card.active .slot-icon-box.base .css-icon-shape::before {
  background: #818CF8;
}
.structure-card.active .slot-icon-box.base .css-icon-shape::after {
  background: #6366F1;
}


.slot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.slot-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 4rpx;
}

.slot-desc {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

.slot-desc.placeholder {
  color: #9CA3AF;
  font-weight: 400;
}

.code {
  font-family: monospace;
  background: #F3F4F6;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  color: #374151;
}

.segments {
  color: #6366F1;
  font-weight: 700;
}

/* 步进器 */
.stepper-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F3F4F6;
  padding: 6rpx;
  border-radius: 32rpx;
}

.step-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4B5563;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

.step-btn:active {
  transform: scale(0.9);
}

.step-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  min-width: 24rpx;
  text-align: center;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-back {
  flex: 1;
  background: #ffffff;
  color: #4B5563;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 28rpx 0;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.btn-back::after {
  border: none;
}

.btn-generate {
  flex: 2;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 28rpx 0;
  border: none;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(99, 102, 241, 0.5);
}

.btn-generate::after {
  border: none;
}

.btn-generate.disabled {
  opacity: 0.5;
  box-shadow: none;
  background: #E5E7EB;
  color: #9CA3AF;
}

/* 素材选择弹层 */
.material-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.material-picker {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.picker-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.picker-content {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.loading-state,
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.material-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.material-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.material-item:active {
  border-color: #667eea;
  transform: scale(0.98);
}

.material-image {
  width: 100%;
  height: 200rpx;
}

.material-info {
  padding: 16rpx;
}

.material-code {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 4rpx;
}

.material-height {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.material-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.material-tag.disabled {
  color: #999;
  background: #f0f0f0;
}
