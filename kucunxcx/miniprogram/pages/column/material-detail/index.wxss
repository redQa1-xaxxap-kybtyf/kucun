/* 产品详情页面样式 */

.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 180rpx; /* 增加底部留白适配 iPhone X */
}

/* 加载中 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  font-size: 28rpx;
  color: #999;
}

/* 图片轮播 */
.image-section {
  position: relative;
  background: #fff;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.image-swiper {
  height: 640rpx; /* 稍微增加高度 */
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8rpx); /* 磨砂效果 */
  color: #ffffff;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* 基本信息卡片 */
.info-card {
  background: #ffffff;
  margin: 32rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx 32rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.info-main {
  flex: 1;
}

.material-code {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -1rpx;
}

.material-name {
  font-size: 28rpx;
  color: #666;
}

.favorite-btn {
  font-size: 40rpx;
  padding: 12rpx;
  border-radius: 50%;
  background: #f5f6fa;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.favorite-btn.active {
  background: #fff1f2;
  color: #f43f5e;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 32rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.cuttable-info {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  gap: 16rpx;
}

.cuttable-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-weight: 500;
}

.cuttable-badge.yes {
  color: #059669;
  background: #ecfdf5;
}

.cuttable-badge.no {
  color: #dc2626;
  background: #fef2f2;
}

.cuttable-hint {
  font-size: 24rpx;
  color: #999;
}

/* 应用场景卡片 */
.scene-card {
  background: #ffffff;
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

/* 装饰性标题前缀 */
.card-title::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  background: #3b82f6;
  margin-right: 12rpx;
  border-radius: 4rpx;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scene-item {
  font-size: 28rpx;
  color: #555;
  background: #f8fafc;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12rpx); /* 底部毛玻璃 */
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-btn {
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 56rpx; /* 更大的圆角 */
  padding: 28rpx 0;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3); /* 蓝色阴影 */
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(59, 130, 246, 0.2);
}

.action-btn.primary {
  /* 使用 Deep Purple Aurora 渐变 */
  background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
  color: #ffffff;
}
