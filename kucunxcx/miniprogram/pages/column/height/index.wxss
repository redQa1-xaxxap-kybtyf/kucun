/* Step 1: 输入高度样式 - Premium Redesign */

.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0 48rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e5e7eb;
  color: #9ca3af;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
  border: 4rpx solid #f5f6fa;
}

.step.active .step-num {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

.step-label {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 500;
}

.step.active .step-label {
  color: #6366f1;
  font-weight: 600;
}

.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #e5e7eb;
  margin: 0 8rpx;
  margin-bottom: 36rpx;
  border-radius: 2rpx;
}

/* 输入区域 - Premium Card */
.input-section {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 10rpx 30rpx -10rpx rgba(99, 102, 241, 0.15),
    0 4rpx 10rpx -4rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

/* 顶部装饰光纹 */
.input-card-wave {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(
    circle,
    rgba(99, 102, 241, 0.08) 0%,
    rgba(255, 255, 255, 0) 70%
  );
  border-radius: 50%;
  pointer-events: none;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  display: flex;
  align-items: baseline;
}

.title-tip {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 400;
  margin-left: 8rpx;
}

.height-range-badge {
  font-size: 20rpx;
  color: #6366f1;
  background: rgba(99, 102, 241, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.height-input-box {
  position: relative;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

/* 选中或输入时的高亮 */
.input-section:focus-within .height-input-box {
  background: #ffffff;
  border-color: #6366f1;
  box-shadow: 0 0 0 6rpx rgba(99, 102, 241, 0.1);
}

/* 刻度尺背景图案 */
.ruler-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 20rpx;
  background-image: repeating-linear-gradient(
    90deg,
    #e5e7eb 0,
    #e5e7eb 2rpx,
    transparent 0,
    transparent 20rpx
  );
  opacity: 0.6;
}

.input-row {
  display: flex;
  align-items: baseline;
  z-index: 1;
}

.height-input {
  font-size: 80rpx;
  font-weight: 700;
  color: #1f2937;
  height: 100rpx;
  min-width: 120rpx;
  text-align: center;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.input-placeholder {
  color: #e5e7eb;
}

.unit-text {
  font-size: 32rpx;
  color: #9ca3af;
  font-weight: 600;
  margin-left: 12rpx;
}

.error-toast {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #ef4444;
  font-size: 24rpx;
  background: #fef2f2;
  padding: 12rpx;
  border-radius: 12rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 快速选择 - Grid Layout */
.preset-section {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.preset-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.preset-card {
  background: #f9fafb;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.preset-card:active {
  transform: scale(0.98);
}

.preset-card.active {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

.preset-content {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.preset-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #374151;
}

.preset-unit {
  font-size: 24rpx;
  color: #9ca3af;
}

.preset-card.active .preset-value,
.preset-card.active .preset-unit {
  color: #ffffff;
}

.preset-check {
  width: 32rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 说明区域 - Clean Alert */
.info-alert {
  display: flex;
  align-items: flex-start;
  background: rgba(99, 102, 241, 0.04);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.1);
  margin-bottom: 40rpx;
}

.info-alert-icon {
  margin-right: 20rpx;
  padding-top: 2rpx;
}

.info-alert-content {
  flex: 1;
}

.info-alert-content text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  text-align: justify;
  display: block;
}

/* 底部操作按钮 */
.bottom-actions {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 0;
}

.btn-back {
  flex: 1;
  background: #ffffff;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 28rpx 0;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.btn-back::after {
  border: none;
}

.btn-next {
  flex: 2;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 28rpx 0;
  border: none;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(99, 102, 241, 0.5);
}

.btn-next::after {
  border: none;
}

.btn-next.disabled {
  opacity: 0.5;
  box-shadow: none;
  background: #e5e7eb;
  color: #9ca3af;
  color: #ffffff; /* 保持白色文字，或者改为灰色 */
}

/* 确认弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.modal-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 24rpx 0;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}
