.container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  background-color: #f5f5f7;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #f2f2f7;
  margin-right: 24rpx;
}

.base-info .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.base-info .role {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.field {
  padding: 16rpx 0;
  border-top: 1px solid #f2f2f7;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: #8e8e93;
}

.value {
  font-size: 26rpx;
  color: #1d1d1f;
}

.logout-section {
  margin-top: 40rpx;
}

.btn-logout {
  width: 100%;
  border-radius: 999rpx;
  background-color: #ff3b30;
  color: #ffffff;
  font-size: 30rpx;
}

