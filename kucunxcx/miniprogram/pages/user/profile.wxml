<!-- 用户中心页 -->
<view class="container {{ enableBackdropBlur ? '' : 'no-blur' }}">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav-bar" style="height: {{navBarHeight}}px;">
      <view class="custom-nav-title">我的</view>
    </view>
  </view>
  <!-- 占位，避免内容被 fixed 顶栏遮挡 -->
  <view class="custom-nav-placeholder" style="height: {{navHeight}}px;"></view>

  <!-- 顶部区域 -->
  <view class="header">
    <!-- 用户信息卡片 -->
    <view class="profile-card" bindtap="navigateToUserInfo">
      <image
        class="avatar"
        src="{{ isLoggedIn && userInfo && userInfo.avatar ? userInfo.avatar : 'https://img.yzcdn.cn/vant/user-active.png' }}"
        mode="aspectFill"
      />
      <view class="profile-text">
        <text class="profile-title">
          {{ isLoggedIn ? (userInfo.name || userInfo.username || '已登录') : '登录/注册' }}
        </text>
        <text class="profile-subtitle">
          {{ isLoggedIn ? (userInfo.role || '普通用户') : '登录后可同步收藏与浏览记录' }}
        </text>
      </view>
      <van-icon name="arrow" class="profile-arrow" size="18px" />
    </view>

    <!-- 两张快捷卡片（不新增功能，仅更换呈现） -->
    <view class="shortcut-row">
      <view class="shortcut-card shortcut-green" bindtap="navigateToFavorites">
        <view class="shortcut-icon">
          <van-icon name="star-o" size="20px" />
        </view>
        <view class="shortcut-text">
          <text class="shortcut-title">我的收藏</text>
          <text class="shortcut-desc">常用产品快速找</text>
        </view>
      </view>
      <view class="shortcut-card shortcut-orange" bindtap="navigateToHistory">
        <view class="shortcut-icon">
          <van-icon name="clock-o" size="20px" />
        </view>
        <view class="shortcut-text">
          <text class="shortcut-title">浏览历史</text>
          <text class="shortcut-desc">最近查看一键回到</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 我的内容（图标网格） -->
  <view class="section">
    <view class="section-title">我的内容</view>
    <view class="card">
      <view class="grid">
        <view class="grid-item" bindtap="navigateToUserInfo">
          <view class="grid-icon grid-icon-blue">
            <van-icon name="user-o" size="20px" />
          </view>
          <text class="grid-label">个人信息</text>
        </view>
        <view class="grid-item" bindtap="navigateToFavorites">
          <view class="grid-icon grid-icon-yellow">
            <van-icon name="star-o" size="20px" />
          </view>
          <text class="grid-label">我的收藏</text>
        </view>
        <view class="grid-item" bindtap="navigateToHistory">
          <view class="grid-icon grid-icon-purple">
            <van-icon name="clock-o" size="20px" />
          </view>
          <text class="grid-label">浏览历史</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section" wx:if="{{ isLoggedIn }}">
    <button class="ios-btn ios-btn-danger" bindtap="onLogout">退出登录</button>
  </view>

  <view class="logout-section" wx:else>
    <button class="ios-btn" bindtap="onLogin">立即登录</button>
  </view>

  <!-- Safe Area Spacer -->
  <view class="bottom-spacer" style="height: {{ dockSpacerHeightPx }}px;"></view>

  <!-- 底部导航 (Floating Dock) -->
  <view class="floating-dock">
    <view class="dock-item" bindtap="navigateToHome">
      <van-icon name="wap-home-o" size="22px" />
      <text>首页</text>
    </view>
    <view class="dock-item" bindtap="navigateToInventory">
      <van-icon name="search" size="22px" />
      <text>查询</text>
    </view>
    <view class="dock-main" bindtap="navigateToCreateProduct">
      <view class="dock-circle {{ canCreateProduct ? 'dock-circle-enabled' : 'dock-circle-disabled' }}">
        <van-icon name="plus" size="24px" color="#fff" />
      </view>
    </view>
    <view class="dock-item" bindtap="navigateToCategories">
      <van-icon name="label-o" size="22px" />
      <text>分类</text>
    </view>
    <view class="dock-item dock-item-active" bindtap="navigateToUser">
      <van-icon name="user-o" size="22px" />
      <text>我的</text>
    </view>
  </view>
</view>
