/**
 * 用户中心页样式 - 参考现代小程序风格
 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #dff5ee 0%, #f0faf7 18%, #f7f8fa 40%);
  padding-bottom: 220rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: linear-gradient(
    180deg,
    rgba(223, 245, 238, 0.98) 0%,
    rgba(240, 250, 247, 0.9) 70%,
    rgba(247, 248, 250, 0) 100%
  );
}

.custom-nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.custom-nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
  letter-spacing: 2rpx;
}

.custom-nav-placeholder {
  width: 100%;
}

/* 顶部区块 */
.header {
  padding: 24rpx 32rpx 24rpx;
}

/* 用户信息卡片（参考图风格：横向、圆角、轻阴影） */
.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 22rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  backdrop-filter: blur(10px);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #fff;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.profile-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.profile-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-subtitle {
  font-size: 24rpx;
  color: #86909c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-arrow {
  color: #c9cdd4 !important;
}

/* 快捷卡片 */
.shortcut-row {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.shortcut-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 18rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  background: #fff;
}

.shortcut-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.shortcut-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.shortcut-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d2129;
}

.shortcut-desc {
  font-size: 22rpx;
  color: rgba(29, 33, 41, 0.55);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shortcut-green {
  background: linear-gradient(135deg, rgba(132, 250, 176, 0.55), rgba(143, 211, 244, 0.45));
}
.shortcut-green .shortcut-icon {
  background: rgba(16, 185, 129, 0.9);
}

.shortcut-orange {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.55), rgba(253, 160, 133, 0.45));
}
.shortcut-orange .shortcut-icon {
  background: rgba(245, 158, 11, 0.9);
}

/* 通用分组 */
.section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d2129;
  margin: 10rpx 0 14rpx;
}

.card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 图标网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 18rpx 14rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 6rpx;
  border-radius: 16rpx;
}

.grid-item:active {
  background: rgba(0, 0, 0, 0.03);
}

.grid-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  margin-bottom: 10rpx;
}

.grid-label {
  font-size: 24rpx;
  color: #4e5969;
}

.grid-icon-blue {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
.grid-icon-yellow {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}
.grid-icon-purple {
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
}
.grid-icon-green {
  background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
}
.grid-icon-grey {
  background: #f2f3f5;
  color: #86909c;
}

/* 列表 */
.list {
  padding: 6rpx 0;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 18rpx;
}

.list-item:active {
  background: rgba(0, 0, 0, 0.03);
}

.list-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.list-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.list-text {
  font-size: 30rpx;
  color: #1d2129;
}

.list-arrow {
  color: #c9cdd4 !important;
}

.divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin-left: 90rpx;
}

.list-icon-blue {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
.list-icon-green {
  background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
}
.list-icon-grey {
  background: #f2f3f5;
  color: #86909c;
}

/* 退出登录区域 */
.logout-section {
  padding: 0 32rpx;
  margin-top: 28rpx;
}

/* 按钮样式 */
.ios-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.25);
  transition: all 0.2s ease;
}

.ios-btn::after {
  border: none;
}

.ios-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 危险按钮 - 退出登录 */
.ios-btn-danger {
  background: #fff;
  color: #f53f3f;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #ffece8;
}

.ios-btn-danger:active {
  background: #fff5f5;
}

/* Safe Area Spacer */
.bottom-spacer {
  height: 180rpx;
}

/* --- Floating Dock (Bottom Nav) --- */
.floating-dock {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  z-index: 999;
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: #6b7280;
  width: 80rpx;
}

.dock-item-active {
  color: #1d2129;
}

.dock-item text {
  font-size: 20rpx;
  font-weight: 500;
}

.dock-main {
  margin: 0 12rpx;
}

.dock-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  margin-top: -40rpx; /* Pop out effect */
  border: 6rpx solid #fff;
}

.dock-circle-enabled {
  background: linear-gradient(135deg, #d4a5d4 0%, #a8d8d0 100%);
  box-shadow:
    0 8rpx 24rpx rgba(168, 216, 208, 0.35),
    0 4rpx 12rpx rgba(212, 165, 212, 0.3);
}

.dock-circle-disabled {
  background:
    radial-gradient(circle at 20% 25%, rgba(59, 130, 246, 0.55) 0, rgba(59, 130, 246, 0) 55%),
    radial-gradient(circle at 75% 30%, rgba(110, 231, 183, 0.45) 0, rgba(110, 231, 183, 0) 60%),
    radial-gradient(circle at 30% 75%, rgba(249, 115, 115, 0.4) 0, rgba(249, 115, 115, 0) 60%),
    radial-gradient(circle at 80% 70%, rgba(249, 168, 212, 0.4) 0, rgba(249, 168, 212, 0) 60%),
    linear-gradient(
      135deg,
      #3b82f6 0%,
      #93c5fd 18%,
      #a5b4fc 30%,
      #6ee7b7 36%,
      #38bdf8 46%,
      #f97373 82%,
      #f9a8d4 90%,
      #fde68a 100%
    );
  background-size: 240% 240%;
  animation: dock-aurora 6s ease-in-out infinite;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.55);
  opacity: 0.96;
}

.dock-item:active {
  transform: scale(0.9);
  color: #1d2129;
}

.dock-circle:active {
  transform: scale(0.95);
}

@keyframes dock-aurora {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
