/* 用户中心页样式 - Apple Style */

.container {
  min-height: 100vh;
  background-color: var(--ios-bg);
  padding-bottom: 60rpx;
  overflow: hidden; /* clean edges */
}

/* 大标题 */
.page-title {
  padding: 40rpx 32rpx 20rpx; /* Reduced top padding */
  font-size: 68rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  letter-spacing: -1rpx;
}

/* 用户信息卡片 - 仿iOS Settings Top Item */
.user-profile-card {
  display: flex;
  align-items: center;
  background-color: var(--ios-card-bg);
  padding: 32rpx;
  margin: 16rpx 32rpx 48rpx;
  border-radius: 20rpx;
  box-shadow: none; /* Flat style */
  background: #fff;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 32rpx;
  background-color: #E5E5EA;
  border: 1rpx solid rgba(0,0,0,0.05);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ios-text-primary);
  line-height: 1.2;
}

.user-role {
  font-size: 28rpx;
  color: var(--ios-text-secondary);
}

/* Reuse global .ios-list-group, just tweak if needed */
.ios-list-group {
  margin-bottom: 48rpx;
}

/* Login/Logout Section */
.logout-section {
  padding: 0 32rpx;
  margin-top: 64rpx;
}

.ios-btn {
  width: 100%;
  height: 88rpx; /* Standard Height */
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  background-color: var(--ios-blue);
  color: #fff;
  border-radius: 44rpx; /* Full Pill */
  display: flex;
  align-items: center;
  justify-content: center;
}

.ios-btn-danger {
  background-color: rgba(255, 59, 48, 0.1); 
  color: var(--ios-red);
}

.ios-btn-danger:active {
  background-color: rgba(255, 59, 48, 0.2);
}

/* Vant overrides */
.van-cell {
  background-color: #ffffff !important;
  padding: 32rpx !important; /* Larger touch targets */
}

.van-cell-group {
  margin: 0 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.van-cell__title {
  font-size: 32rpx;
  color: var(--ios-text-primary);
}

.van-icon {
  color: var(--ios-text-secondary); /* Text color reset */
}

/* Icon Colors */
.icon-blue { color: #0071E3; }
.icon-yellow { color: #FF9500; }
.icon-purple { color: #AF52DE; }
.icon-green { color: #34C759; }
.icon-red { color: #FF3B30; }

.van-cell__left-icon-wrap {
    font-size: 40rpx; /* Larger icons */
    margin-right: 24rpx;
}
