<!-- 我的收藏 -->
<view class="container">
  <view wx:if="{{ loading }}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{ favorites.length === 0 }}" class="empty">
    <text class="empty-text">还没有收藏任何产品</text>
  </view>

  <scroll-view wx:else scroll-y class="list">
    <view
      class="item"
      wx:for="{{ favorites }}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{ item.id }}"
    >
      <image
        class="thumb"
        src="{{ item.thumbnailUrl || 'https://img.yzcdn.cn/vant/cat.jpeg' }}"
        mode="aspectFill"
      />
      <view class="info">
        <text class="name">{{ item.name }}</text>
        <text class="code">编码：{{ item.code }}</text>
        <text class="time">收藏时间：{{ item.addedAtText }}</text>
      </view>
    </view>
  </scroll-view>

  <view class="footer" wx:if="{{ favorites.length > 0 }}">
    <button class="btn-clear" bindtap="onClear">清空收藏</button>
  </view>
</view>
