.container {
  min-height: 100vh;
  padding: 16rpx 24rpx 80rpx;
  background-color: #f5f5f7;
  box-sizing: border-box;
}

.loading,
.empty {
  margin-top: 80rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}

.empty-text {
  color: #8e8e93;
}

.list {
  max-height: 100vh;
}

.item {
  display: flex;
  padding: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background-color: #f2f2f7;
  margin-right: 16rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.code {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b0b0b5;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 24rpx 24rpx;
  background: linear-gradient(
    to top,
    rgba(245, 245, 247, 0.98),
    rgba(245, 245, 247, 0)
  );
}

.btn-clear {
  width: 100%;
  border-radius: 999rpx;
  background-color: #ff3b30;
  color: #ffffff;
  font-size: 28rpx;
}

