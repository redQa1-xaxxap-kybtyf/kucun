<!-- 个人信息页 -->
<view class="container">
  <view class="card">
    <view class="avatar-row">
      <image
        class="avatar"
        src="{{ user.avatar || '/assets/images/default-avatar.png' }}"
        mode="aspectFill"
      />
      <view class="base-info">
        <text class="name">{{ user.name || user.username }}</text>
        <text class="role">{{ user.role || '普通用户' }}</text>
      </view>
    </view>

    <view class="field">
      <text class="label">用户名</text>
      <text class="value">{{ user.username }}</text>
    </view>
    <view class="field" wx:if="{{ user.email }}">
      <text class="label">邮箱</text>
      <text class="value">{{ user.email }}</text>
    </view>
    <view class="field">
      <text class="label">用户角色</text>
      <text class="value">{{ user.role || '普通用户' }}</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </view>
</view>

