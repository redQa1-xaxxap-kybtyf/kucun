/* 分类浏览页样式 - Apple Style */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--ios-bg);
}

/* 搜索区域 */
.search-section {
  background-color: var(--ios-bg);
  padding: 8rpx 0;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

/* 统计信息 */
.stats-section {
  display: flex;
  background-color: transparent;
  padding: 16rpx 32rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
  gap: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background-color: var(--ios-card-bg);
  padding: 24rpx;
  border-radius: var(--ios-radius);
  box-shadow: var(--ios-shadow);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ios-blue);
}

.stat-label {
  font-size: 24rpx;
  color: var(--ios-text-secondary);
}

/* 滚动容器 */
.scroll-container {
  flex: 1;
  height: 100%;
}

/* 分类列表 */
.category-list {
  padding: 0 32rpx 32rpx;
}

/* 一级分类 */
.category-item {
  background-color: var(--ios-card-bg);
  border-radius: var(--ios-radius);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--ios-shadow);
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  transition: background-color 0.2s;
}

.category-header:active {
  background-color: #F2F2F7;
}

.category-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.category-icon {
  flex-shrink: 0;
}

.category-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.category-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ios-text-primary);
}

.category-code {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
}

.category-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.product-count {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.count-number {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ios-green);
}

.count-unit {
  font-size: 20rpx;
  color: var(--ios-text-tertiary);
}

/* 二级分类 */
.sub-categories {
  background: linear-gradient(135deg,
    rgba(245, 232, 245, 0.3) 0%,
    rgba(229, 245, 240, 0.3) 100%);
  border-top: 2rpx solid rgba(212, 165, 212, 0.2);
  padding: 16rpx 0;
}

/* 父级分类提示 */
.parent-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  margin-bottom: 8rpx;
}

.parent-hint-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #d4a5d4;
  background: rgba(212, 165, 212, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.parent-hint-arrow {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
}

.sub-category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 20rpx 48rpx;
  transition: background-color 0.2s;
  border-bottom: 1rpx solid rgba(212, 165, 212, 0.1);
  position: relative;
}

.sub-category-item:last-child {
  border-bottom: none;
}

.sub-category-item:active {
  background: rgba(212, 165, 212, 0.15);
}

.sub-category-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

/* 树状连接线 */
.tree-line {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.tree-line-vertical {
  position: absolute;
  left: 16rpx;
  top: -20rpx;
  width: 2rpx;
  height: 32rpx;
  background: linear-gradient(to bottom,
    rgba(212, 165, 212, 0.3) 0%,
    rgba(168, 216, 208, 0.3) 100%);
}

.tree-line-horizontal {
  position: absolute;
  left: 16rpx;
  top: 15rpx;
  width: 16rpx;
  height: 2rpx;
  background: linear-gradient(to right,
    rgba(212, 165, 212, 0.3) 0%,
    rgba(168, 216, 208, 0.3) 100%);
}

.sub-icon {
  flex-shrink: 0;
}

.sub-category-name {
  font-size: 28rpx;
  color: var(--ios-text-primary);
  font-weight: 500;
}

.sub-product-count {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  background: rgba(212, 165, 212, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.sub-count {
  font-size: 26rpx;
  color: #d4a5d4;
  font-weight: 600;
}

.sub-count-unit {
  font-size: 20rpx;
  color: var(--ios-text-tertiary);
}
