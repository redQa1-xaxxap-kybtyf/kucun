/* 分类浏览页样式 - Apple Style */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--ios-bg);
}

/* 搜索区域 */
.search-section {
  background-color: var(--ios-bg);
  padding: 8rpx 0;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

/* 统计信息 */
.stats-section {
  display: flex;
  background-color: transparent;
  padding: 16rpx 32rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
  gap: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background-color: var(--ios-card-bg);
  padding: 24rpx;
  border-radius: var(--ios-radius);
  box-shadow: var(--ios-shadow);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ios-blue);
}

.stat-label {
  font-size: 24rpx;
  color: var(--ios-text-secondary);
}

/* 滚动容器 */
.scroll-container {
  flex: 1;
  height: 100%;
}

/* 分类列表 */
.category-list {
  padding: 0 32rpx 32rpx;
}

/* 一级分类 */
.category-item {
  background-color: var(--ios-card-bg);
  border-radius: var(--ios-radius);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--ios-shadow);
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  transition: background-color 0.2s;
}

.category-header:active {
  background-color: #F2F2F7;
}

.category-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.category-icon {
  flex-shrink: 0;
}

.category-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.category-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ios-text-primary);
}

.category-code {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
}

.category-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.product-count {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.count-number {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ios-green);
}

.count-unit {
  font-size: 20rpx;
  color: var(--ios-text-tertiary);
}

/* 二级分类 */
.sub-categories {
  background-color: #F9F9FB; /* Pretty light gray */
  border-top: 1rpx solid rgba(0,0,0,0.05);
}

.sub-category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 24rpx 88rpx; /* Indent */
  transition: background-color 0.2s;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.sub-category-item:last-child {
  border-bottom: none;
}

.sub-category-item:active {
  background-color: #E5E5EA;
}

.sub-category-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.sub-category-name {
  font-size: 30rpx;
  color: var(--ios-text-secondary);
}

.sub-product-count {
  display: flex;
  align-items: center;
}

.sub-count {
  font-size: 26rpx;
  color: var(--ios-green);
  font-weight: 500;
}
