/* 分类编辑页样式 - 复用创建页的现代化设计 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  background-attachment: fixed;
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
  position: relative;
}

/* 背景装饰元素 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.06) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  z-index: 1;
  position: relative;
}

.loading-spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 玻璃形态学卡片 */
.form-card {
  position: relative;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx) saturate(150%);
  -webkit-backdrop-filter: blur(20rpx) saturate(150%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.12),
    0 2rpx 8rpx rgba(0, 0, 0, 0.08),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  z-index: 1;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
  animation: fadeInUp 0.6s ease-out backwards;
}

.form-item:nth-child(1) { animation-delay: 0.1s; }
.form-item:nth-child(2) { animation-delay: 0.15s; }
.form-item:nth-child(3) { animation-delay: 0.2s; }
.form-item:nth-child(4) { animation-delay: 0.25s; }
.form-item:nth-child(5) { animation-delay: 0.3s; }
.form-item:nth-child(6) { animation-delay: 0.35s; }

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 输入框包装器 */
.input-wrapper {
  position: relative;
  padding-top: 8rpx;
}

/* 浮动标签 */
.label-float {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.45);
  margin-bottom: 12rpx;
  margin-left: 4rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

/* 标签激活状态 */
.input-wrapper.has-value .label-float {
  color: #667eea;
  font-weight: 600;
}

/* 输入框容器 */
.input-container {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 250, 252, 0.9) 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

/* 聚焦状态 */
.input-wrapper.has-value .input-container {
  border-color: rgba(102, 126, 234, 0.4);
  background: #ffffff;
  box-shadow:
    0 4rpx 20rpx rgba(102, 126, 234, 0.15),
    0 0 0 4rpx rgba(102, 126, 234, 0.05),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 1);
  transform: translateY(-2rpx);
}

/* 增强版输入框 */
.input-enhanced {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1d1d1f;
  background: transparent;
  border: none;
  font-weight: 500;
}

.input-readonly {
  color: #999;
}

/* 输入提示文字 */
.input-hint {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.3);
  margin-top: 12rpx;
  margin-left: 24rpx;
  font-weight: 400;
}

/* Placeholder样式 */
.input-placeholder {
  color: rgba(0, 0, 0, 0.25);
  font-weight: 400;
  font-size: 26rpx;
}

/* 文本域 */
.textarea-wrapper {
  position: relative;
  padding-top: 8rpx;
}

.textarea-wrapper .label-float {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.45);
  margin-bottom: 12rpx;
  margin-left: 4rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.textarea-wrapper.has-value .label-float {
  color: #667eea;
  font-weight: 600;
}

.textarea-container {
  position: relative;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 250, 252, 0.9) 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

.textarea-wrapper.has-value .textarea-container {
  border-color: rgba(102, 126, 234, 0.4);
  background: #ffffff;
  box-shadow:
    0 4rpx 20rpx rgba(102, 126, 234, 0.15),
    0 0 0 4rpx rgba(102, 126, 234, 0.05),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 1);
  transform: translateY(-2rpx);
}

.textarea-enhanced {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #1d1d1f;
  background: transparent;
  border: none;
  font-weight: 400;
  box-sizing: border-box;
}

/* 字数统计 */
.char-count {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.3);
  font-weight: 500;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.textarea-wrapper.has-value .char-count {
  color: #667eea;
  border-color: rgba(102, 126, 234, 0.3);
  background: rgba(102, 126, 234, 0.05);
}

/* 选择器 */
.picker-container {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 250, 252, 0.9) 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
  height: 88rpx;
}

.input-wrapper.has-value .picker-container,
.picker-container:active {
  border-color: rgba(102, 126, 234, 0.4);
  background: #ffffff;
  box-shadow:
    0 4rpx 20rpx rgba(102, 126, 234, 0.15),
    0 0 0 4rpx rgba(102, 126, 234, 0.05),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 1);
  transform: translateY(-2rpx);
}

.picker-value-enhanced {
  flex: 1;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
  padding-left: 24rpx;
  padding-right: 16rpx;
}

.picker-arrow {
  font-size: 40rpx;
  color: #667eea;
  font-weight: 300;
  margin-right: 20rpx;
  transform: rotate(90deg);
  transition: all 0.3s ease;
}

/* 清除按钮 */
.clear-parent {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* 状态切换 */
.status-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.status-label {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.65);
}

.status-toggle {
  display: flex;
  gap: 16rpx;
}

.status-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.3s ease;
  font-weight: 500;
}

.status-option.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.status-option.inactive {
  background: linear-gradient(135deg, #ff976a 0%, #ee6723 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 151, 106, 0.4);
}

/* 信息区域 */
.info-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.delete-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 40rpx;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #ee0a24;
  background: rgba(238, 10, 36, 0.08);
  border: none;
}

.delete-btn[disabled] {
  color: #ccc;
  background: #f5f5f5;
}

.submit-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  box-shadow:
    0 8rpx 24rpx rgba(102, 126, 234, 0.4),
    0 4rpx 12rpx rgba(118, 75, 162, 0.3);
}

.submit-btn[disabled] {
  opacity: 0.6;
}

/* 删除提示 */
.delete-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #ff976a;
  z-index: 1;
  position: relative;
}

/* 对话框内容 */
.dialog-content {
  padding: 32rpx;
  text-align: center;
}

.dialog-content text {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.dialog-warning {
  margin-top: 16rpx;
  font-size: 24rpx !important;
  color: #ee0a24 !important;
}
