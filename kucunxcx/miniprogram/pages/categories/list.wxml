<!-- 分类浏览页 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <van-search
      value="{{ searchValue }}"
      placeholder="搜索分类名称"
      bind:search="onSearch"
      bind:change="onSearchChange"
      shape="round"
    />
  </view>

  <!-- 统计信息 -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-value">{{ totalCategories }}</text>
      <text class="stat-label">全部分类</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{ activeCategories }}</text>
      <text class="stat-label">启用中</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{ totalProducts }}</text>
      <text class="stat-label">产品总数</text>
    </view>
  </view>

  <!-- 分类列表 -->
  <scroll-view class="scroll-container" scroll-y>
    <view class="category-list">
      <!-- 一级分类 -->
      <view
        wx:for="{{ categories }}"
        wx:key="id"
        class="category-item"
      >
        <view class="category-header" bindtap="onCategoryTap" data-id="{{ item.id }}" data-name="{{ item.name }}">
          <view class="category-info">
            <van-icon name="apps-o" size="20px" color="#1989fa" class="category-icon" />
            <view class="category-content">
              <text class="category-name">{{ item.name }}</text>
            </view>
          </view>
          <view class="category-meta">
            <view class="product-count">
              <text class="count-number">{{ item.productCount }}</text>
              <text class="count-unit">个产品</text>
            </view>
            <!-- 新增下级分类（仅管理员/销售显示） -->
            <van-icon
              wx:if="{{ canManageCategories && item.level < 3 }}"
              name="plus"
              size="18px"
              color="#1989fa"
              class="action-icon"
              catchtap="onAddChildCategory"
              data-id="{{ item.id }}"
              data-name="{{ item.name }}"
            />
            <van-icon
              wx:if="{{ item.children && item.children.length > 0 }}"
              name="{{ item.expanded ? 'arrow-down' : 'arrow' }}"
              size="16px"
              color="#969799"
              catchtap="toggleExpand"
              data-id="{{ item.id }}"
            />
            <van-icon
              wx:else
              name="arrow"
              size="16px"
              color="#969799"
            />
          </view>
        </view>

        <!-- 二级分类 -->
        <view wx:if="{{ item.expanded && item.children && item.children.length > 0 }}" class="sub-categories">
          <!-- 父级分类提示 -->
          <view class="parent-hint">
            <text class="parent-hint-text">{{ item.name }}</text>
            <text class="parent-hint-arrow">的子分类</text>
          </view>

          <block wx:for="{{ item.children }}" wx:key="id" wx:for-item="child">
            <view
              class="sub-category-item"
              bindtap="onCategoryTap"
              data-id="{{ child.id }}"
              data-name="{{ child.name }}"
            >
              <view class="sub-category-info">
                <!-- 连接线 -->
                <view class="tree-line">
                  <view class="tree-line-vertical"></view>
                  <view class="tree-line-horizontal"></view>
                </view>
                <van-icon name="circle" size="8px" color="#d4a5d4" class="sub-icon" />
                <text class="sub-category-name">{{ child.name }}</text>
              </view>
              <view class="sub-actions">
                <view class="sub-product-count">
                  <text class="sub-count">{{ child.productCount }}</text>
                  <text class="sub-count-unit">个</text>
                </view>
                <!-- 新增下级分类（2级 -> 3级） -->
                <van-icon
                  wx:if="{{ canManageCategories && child.level < 3 }}"
                  name="plus"
                  size="18px"
                  color="#1989fa"
                  class="action-icon"
                  catchtap="onAddChildCategory"
                  data-id="{{ child.id }}"
                  data-name="{{ child.name }}"
                />
                <!-- 展开/收起第3级 -->
                <van-icon
                  wx:if="{{ child.children && child.children.length > 0 }}"
                  name="{{ child.expanded ? 'arrow-down' : 'arrow' }}"
                  size="16px"
                  color="#969799"
                  class="action-icon"
                  catchtap="toggleExpand"
                  data-id="{{ child.id }}"
                />
              </view>
            </view>

            <!-- 三级分类 -->
            <view
              wx:if="{{ child.expanded && child.children && child.children.length > 0 }}"
              class="third-categories"
            >
              <view
                wx:for="{{ child.children }}"
                wx:key="id"
                wx:for-item="grandchild"
                class="third-category-item"
                bindtap="onCategoryTap"
                data-id="{{ grandchild.id }}"
                data-name="{{ grandchild.name }}"
              >
                <view class="third-category-info">
                  <!-- 连接线（三级） -->
                  <view class="tree-line tree-line-third">
                    <view class="tree-line-vertical"></view>
                    <view class="tree-line-horizontal"></view>
                  </view>
                  <van-icon name="circle" size="6px" color="#a8d8d0" class="third-icon" />
                  <text class="third-category-name">{{ grandchild.name }}</text>
                </view>
                <view class="third-product-count">
                  <text class="third-count">{{ grandchild.productCount }}</text>
                  <text class="third-count-unit">个</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- 空状态 -->
      <van-empty
        wx:if="{{ categories.length === 0 }}"
        description="暂无分类"
        image="search"
      />
    </view>
  </scroll-view>

  <!-- 新建顶级分类入口（仅管理员/销售显示） -->
  <view wx:if="{{ canManageCategories }}" class="fab" bindtap="onAddCategory">
    <van-icon name="plus" size="24px" color="#ffffff" />
  </view>
</view>
