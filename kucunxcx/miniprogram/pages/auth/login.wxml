<!-- 登录页面 -->
<view class="login-container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="title">登录</text>
    <text class="subtitle">欢迎回到库存管理系统</text>
  </view>

  <!-- 登录表单 -->
  <view class="form-container">
    <!-- 用户名输入 -->
    <view class="input-group">
      <view class="input-wrapper">
        <input
          class="input-field"
          type="text"
          placeholder="请输入用户名/手机号"
          value="{{ username }}"
          bindinput="onUsernameInput"
          maxlength="50"
        />
      </view>
    </view>

    <!-- 密码输入 -->
    <view class="input-group">
      <view class="input-wrapper">
        <input
          class="input-field"
          password="{{ !showPassword }}"
          placeholder="请输入密码"
          value="{{ password }}"
          bindinput="onPasswordInput"
          maxlength="50"
        />
        <van-icon
          name="{{ showPassword ? 'eye-o' : 'closed-eye' }}"
          class="toggle-password"
          bindtap="togglePasswordVisibility"
        />
      </view>
    </view>

    <!-- 忘记密码 -->
    <view class="forgot-password">
      <text class="link-text" bindtap="handleForgotPassword">忘记密码？</text>
    </view>

    <!-- 登录按钮 -->
    <button
      class="login-button {{ loading ? 'loading' : '' }}"
      bindtap="handleLogin"
      disabled="{{ loading }}"
    >
      <van-loading wx:if="{{ loading }}" type="spinner" size="20px" color="#fff" />
      <text wx:else>登录</text>
    </button>

    <!-- 测试账号提示 -->
    <view class="test-account-hint">
      <text class="hint-text" bindtap="showTestAccount">使用测试账号登录</text>
    </view>

    <!-- 注册链接（暂时隐藏） -->
    <!-- <view class="register-link">
      <text class="normal-text">还没有账号？</text>
      <text class="link-text" bindtap="navigateToRegister">立即注册</text>
    </view> -->
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">瓷砖行业库存管理系统</text>
    <text class="footer-text">Version 1.0.0</text>
  </view>
</view>
