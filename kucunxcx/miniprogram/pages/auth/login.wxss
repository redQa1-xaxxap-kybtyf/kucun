/* 登录页面样式 - 柔和色调 + 极光动画（2025 风格） */

/* 页面容器：柔和的粉紫→奶油白→青绿渐变 */
.login-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  /* 基础渐变 */
  background: linear-gradient(135deg,
    #e8c5e5 0%,
    #f5f0e8 50%,
    #c9e5de 100%);
  background-size: 200% 200%;
  background-attachment: fixed;
  animation: auroraBase 20s ease-in-out infinite;
}

/* 极光动画 - 基础层 */
@keyframes auroraBase {
  0%, 100% {
    background-position: 0% 0%;
  }
  25% {
    background-position: 100% 50%;
  }
  50% {
    background-position: 100% 100%;
  }
  75% {
    background-position: 50% 0%;
  }
}

/* 极光层 1 - 流动光晕（柔和粉紫色调） */
.login-container::before {
  content: '';
  position: fixed;
  top: -50%;
  left: -50%;
  right: -50%;
  bottom: -50%;
  background:
    radial-gradient(ellipse at 20% 30%, rgba(232, 197, 229, 0.4) 0%, transparent 40%),
    radial-gradient(ellipse at 80% 70%, rgba(201, 229, 222, 0.35) 0%, transparent 45%),
    radial-gradient(ellipse at 50% 50%, rgba(245, 240, 232, 0.3) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
  animation: aurora1 15s ease-in-out infinite alternate;
}

@keyframes aurora1 {
  0% {
    transform: translate(0, 0) rotate(0deg);
    opacity: 0.8;
  }
  50% {
    transform: translate(10%, 5%) rotate(5deg);
    opacity: 1;
  }
  100% {
    transform: translate(-5%, 10%) rotate(-3deg);
    opacity: 0.8;
  }
}

/* 极光层 2 - 次级光晕（柔和青绿色调） */
.login-container::after {
  content: '';
  position: fixed;
  top: -50%;
  left: -50%;
  right: -50%;
  bottom: -50%;
  background:
    radial-gradient(ellipse at 70% 20%, rgba(255, 255, 255, 0.25) 0%, transparent 35%),
    radial-gradient(ellipse at 30% 80%, rgba(232, 197, 229, 0.25) 0%, transparent 40%),
    radial-gradient(ellipse at 60% 60%, rgba(201, 229, 222, 0.2) 0%, transparent 45%);
  pointer-events: none;
  z-index: 0;
  animation: aurora2 18s ease-in-out infinite alternate-reverse;
}

@keyframes aurora2 {
  0% {
    transform: translate(0, 0) scale(1) rotate(0deg);
    opacity: 0.6;
  }
  50% {
    transform: translate(-8%, -5%) scale(1.1) rotate(-4deg);
    opacity: 0.9;
  }
  100% {
    transform: translate(5%, -8%) scale(0.95) rotate(2deg);
    opacity: 0.7;
  }
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  animation: fadeInDown 0.6s ease-out;
  position: relative;
  z-index: 1;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.logo-image {
  width: 120rpx;
  height: 120rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 400;
}

/* 顶部引导文案 */
.helper-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 表单容器 */
.form-container {
  width: 100%;
  max-width: 640rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.12);
  animation: fadeInUp 0.6s ease-out;
  position: relative;
  z-index: 1;
}

/* 输入组 */
.input-group {
  margin-bottom: 32rpx;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  transition: all 0.2s ease-out;
}

.input-wrapper:focus-within {
  background: #f5eff5;
  box-shadow: 0 0 0 4rpx rgba(212, 165, 212, 0.18);
}

.input-icon {
  font-size: 40rpx !important;
  color: #8e8e93;
  margin-right: 16rpx;
}

.input-field {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: #1d1d1f;
  background: transparent;
}

.input-field::placeholder {
  color: #c7c7cc;
}

.toggle-password {
  font-size: 40rpx !important;
  color: #8e8e93;
  padding: 16rpx;
  transition: color 0.2s;
}

.toggle-password:active {
  color: #d4a5d4;
}

/* 忘记密码 */
.forgot-password {
  text-align: right;
  margin-bottom: 40rpx;
}

.link-text {
  font-size: 26rpx;
  color: #d4a5d4;
  font-weight: 500;
  transition: opacity 0.2s;
}

.link-text:active {
  opacity: 0.7;
}

/* 登录按钮 - 柔和色调 */
.login-button {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #d4a5d4 0%, #a8d8d0 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(168, 216, 208, 0.35);
  transition: all 0.2s ease-out;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.login-button:active:not(.loading) {
  transform: scale(0.97);
  box-shadow: 0 8rpx 20rpx rgba(168, 216, 208, 0.3);
}

.login-button.loading {
  opacity: 0.7;
}

/* 测试账号提示 */
.test-account-hint {
  text-align: center;
  margin-top: 24rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #8e8e93;
  text-decoration: underline;
}

/* 注册链接 */
.register-link {
  text-align: center;
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #e5e5ea;
}

.normal-text {
  font-size: 26rpx;
  color: #8e8e93;
  margin-right: 8rpx;
}

/* 底部信息 */
.footer {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  text-align: center;
  animation: fadeIn 0.8s ease-out 0.3s both;
  z-index: 1;
}

.footer-text {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.8;
}

/* 动画 */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 隐私授权弹窗样式 */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.privacy-dialog {
  width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 40rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 24rpx;
}

.privacy-content {
  font-size: 26rpx;
  color: #3a3a3c;
  line-height: 1.8;
  margin-bottom: 32rpx;
}

.privacy-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.btn-cancel {
  min-width: 180rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #3a3a3c;
  background: #f2f2f7;
}

.btn-ok {
  min-width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #d4a5d4 0%, #a8d8d0 100%);
}

/* 极光动画关键帧 - 已移除，使用统一的动画 */
