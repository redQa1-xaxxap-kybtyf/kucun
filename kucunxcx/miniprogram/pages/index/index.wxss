/* 2025 Modern Design System - Index */

/* Global Reset */
page {
  background-color: #F5F5F7; /* Apple System Gray 6 */
  --primary: #007AFF;
  --text-main: #1D1D1F;
  --text-sub: #86868B;
  --card-bg: #FFFFFF;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 8rpx 24rpx rgba(0,0,0,0.06);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.page-container {
  min-height: 100vh;
  position: relative;
}

/* --- Sticky Header --- */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(245, 245, 247, 0.95);
  backdrop-filter: blur(20px);
  /* padding set inline via WXML for status bar */
  border-bottom: 0.5rpx solid rgba(0,0,0,0.05);
}

.nav-bar-content {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  /* padding-right set inline */
  box-sizing: border-box;
  gap: 24rpx; /* Space between title and search */
}

.nav-title {
  font-size: 34rpx; /* Standard nav title size, maybe larger if emphasis needed, but space is limited */
  font-weight: 700;
  color: #000;
  white-space: nowrap;
}

/* Search Box - Compact & Aligned */
.search-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 100rpx; /* Pill */
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 24rpx; /* Compact padding */
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: var(--text-main);
  margin: 0 16rpx;
}

.search-placeholder {
  color: #AEAEB2;
}

.scan-icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid rgba(0,0,0,0.1);
  padding-left: 16rpx;
}

/* --- Main Content --- */
.main-scroll {
  height: 100vh;
}

.scroll-content {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 48rpx; /* Section spacing */
}

/* Section 1: Dashboard Grid */
.section-grid-stats {
  display: flex;
  gap: 24rpx;
  height: 320rpx;
}

.stat-tile {
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.stat-tile.primary {
  flex: 1.4;
  background: linear-gradient(135deg, #007AFF 0%, #0055B3 100%);
  color: #fff;
}

.stat-tile.primary .stat-label {
  color: rgba(255,255,255,0.8);
}

.stat-tile.primary .stat-num {
  color: #fff;
}

.trend-badge {
  background: rgba(255,255,255,0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.stat-num.big {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-icon-overlay {
  position: absolute;
  right: -20rpx;
  bottom: -20rpx;
  opacity: 0.6;
}

.stat-tile-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stat-tile.small {
  flex: 1;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.stat-text-group {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.stat-desc {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* Section 2: Banner */
.section-banner {
  width: 100%;
  height: 280rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.modern-swiper {
  height: 100%;
}

.modern-banner-card {
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  background-size: cover;
}

.banner-txt {
  position: relative;
  z-index: 2;
  color: #fff;
}

.b-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  display: block;
}

.b-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
  display: block;
}

.b-btn {
  display: inline-block;
  background: #fff;
  color: #000;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
}

/* Section 3: Categories */
.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.section-h1 {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-link {
  font-size: 28rpx;
  color: var(--primary);
}

.cat-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx;
  width: calc(100% + 64rpx);
}

.cat-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 32rpx 20rpx;
}

.cat-chip {
  padding: 16rpx 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  color: var(--text-sub);
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.cat-chip.active {
  background: var(--text-main);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.15);
  transform: scale(1.02);
}

/* Section 4: Hot Products */
.hot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-top: 24rpx;
}

.hot-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  /* box-shadow: var(--shadow-sm); Removed for cleaner look */
  display: flex;
  flex-direction: column;
}

.card-img-box {
  width: 100%;
  padding-bottom: 100%; /* Square */
  position: relative;
  background: #F2F2F7;
}

.card-img-box image {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.stock-tag {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(255,255,255,0.9);
  color: #FF3B30;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.card-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-code {
  font-size: 22rpx;
  color: #8E8E93;
}

.card-stock {
  font-size: 24rpx;
  color: #0071E3; /* Accent Color */
  font-weight: 500;
  margin-top: 4rpx;
}

/* --- Floating Dock (Bottom Nav) --- */
.floating-dock {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.12);
  border: 1rpx solid rgba(255,255,255,0.5);
  z-index: 999;
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: var(--text-sub);
  width: 80rpx;
}

.dock-item text {
  font-size: 20rpx;
  font-weight: 500;
}

.dock-main {
  margin: 0 12rpx;
}

.dock-circle {
  width: 96rpx;
  height: 96rpx;
  background: var(--text-main);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.25);
  margin-top: -40rpx; /* Pop out effect */
  border: 6rpx solid #fff;
}

/* 启用状态：销售/管理员 */
.dock-circle-enabled {
  background: var(--text-main);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.25);
}

/* 禁用状态：访客 */
.dock-circle-disabled {
  background: #C7C7CC;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  opacity: 0.9;
}

.dock-item:active {
  transform: scale(0.9);
  color: var(--text-main);
}

.dock-circle:active {
  transform: scale(0.95);
}
