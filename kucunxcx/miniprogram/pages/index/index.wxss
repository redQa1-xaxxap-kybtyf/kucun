/* 2025 Modern Design System - Index - 中性色调（建材友好版） */

/* Global Reset */
page {
  background: linear-gradient(180deg, #f7f7f8 0%, #ffffff 50%, #f5f5f7 100%);
  background-attachment: fixed;
  /* 2025 中性色板 - 建材友好 */
  --primary: #6b7280;
  --primary-light: #9ca3af;
  --primary-soft: #f3f4f6;
  --accent: #d4a5d4; /* 品牌点缀色，仅用于Header装饰 */
  --accent-light: #a8d8d0;
  --text-main: #1f2937;
  --text-sub: #6b7280;
  --text-muted: #9ca3af;
  --border: #e5e7eb;
  --card-bg: rgba(255, 255, 255, 0.98);
  --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  font-family:
    -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  height: 100vh; /* 关键：锁死高度 */
  overflow: hidden; /* 关键：禁止 Page 滚动，只允许 scroll-view 滚动 */
}

.page-container {
  height: 100vh;
  width: 100vw;
  position: relative;
  overflow: hidden;
}

/* --- Sticky Header (Overlay) --- */
.sticky-header {
  position: absolute; /* 覆盖在 scroll-view 之上 */
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box; /* 关键修复：防止 padding 撑大高度 */
}

/* 导航栏背景 - 玻璃拟态 + 中性色调 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 中性渐变背景 + 玻璃效果 */
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.92) 0%,
    rgba(249, 250, 251, 0.92) 50%,
    rgba(243, 244, 246, 0.92) 100%
  );
  backdrop-filter: blur(30rpx) saturate(150%);
  -webkit-backdrop-filter: blur(30rpx) saturate(150%);
  z-index: 0;
  transition: opacity 0.3s ease;
  border-bottom: 1rpx solid rgba(229, 231, 235, 0.5);
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

/* 极光渐变动效层 - 保留品牌色点缀，但降低强度 */
.header-bg::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    120deg,
    rgba(212, 165, 212, 0.08) 0%,
    rgba(168, 216, 208, 0.06) 25%,
    rgba(255, 255, 255, 0.05) 50%,
    rgba(168, 216, 208, 0.07) 75%,
    rgba(212, 165, 212, 0.08) 100%
  );
  background-size: 200% 200%;
  animation: aurora-flow 8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes aurora-flow {
  0%,
  100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

.nav-bar-content {
  position: relative;
  z-index: 10;
  width: 100%;
  padding-left: 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

/* Center Title (Initial State) */
.nav-center-title {
  position: absolute;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  pointer-events: none;
  z-index: 2;
  transition: opacity 0.2s ease-out;
  margin-left: -32rpx;
}

/* Left Container (Scrolled State) */
.nav-left-container {
  display: flex;
  align-items: center;
  flex: 1;
  width: 100%;
  transition: all 0.2s ease-out;
  will-change: opacity, transform;
}

.nav-title-left {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* Mini Search Box in Header - 柔和色调 */
.search-box-mini {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 24rpx;
  max-width: 400rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.search-mini-input {
  flex: 1;
  height: 100%;
  font-size: 26rpx;
  color: var(--text-main);
  margin-left: 12rpx;
}

/* 搜索框清空按钮 */
.search-clear-icon {
  margin-left: 8rpx;
}

/* --- Hero Section --- */
.hero-section {
  padding: 16rpx 0 24rpx;
}

.hero-search-bar {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx) saturate(180%);
  -webkit-backdrop-filter: blur(20rpx) saturate(180%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.08),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.15s ease-out;
}

.hero-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-main);
  margin-left: 16rpx;
}

/* 快捷功能入口 - Aurora Style */
.quick-entry-section {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.quick-entry-card {
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  /* 极光渐变背景 */
  background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow:
    0 8rpx 20rpx -6rpx rgba(139, 92, 246, 0.5),
    0 4rpx 12rpx -4rpx rgba(236, 72, 153, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 增加玻璃光泽感 */
.quick-entry-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0.15) 0%,
    rgba(255, 255, 255, 0.05) 40%,
    rgba(255, 255, 255, 0) 100%
  );
  pointer-events: none;
}

.quick-entry-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.3);
}

.quick-entry-icon-box {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.quick-entry-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.quick-entry-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.quick-entry-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.quick-entry-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #8b5cf6;
  background: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.quick-entry-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.quick-entry-action {
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.action-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}

/* --- Main Content Structure --- */
.main-scroll {
  height: 100vh;
}

.scroll-content {
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* Section 2: Sticky Filter Bar */
/* 分类导航卡片（一级 + 二级）- Premium Glass Style */
.section-categories {
  margin-top: 16rpx;
}

.home-category-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.03),
    0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
}

.home-category-card:active {
  transform: scale(0.99);
  background: #f9fafb;
}

.home-category-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.home-category-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.5rpx;
  position: relative;
  padding-left: 24rpx;
}

/* 左侧装饰条 */
.home-category-name::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #8b5cf6 0%, #ec4899 100%);
  border-radius: 4rpx;
}

.home-category-right {
  display: flex;
  align-items: center;
}

.home-all-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
  transition: all 0.2s;
}

.home-all-btn text {
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7280;
}

.home-all-btn:active {
  background: #e5e7eb;
}

/* 2级分类：Tag 改版 */
.home-subcategory-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.home-subcategory-pill {
  padding: 12rpx 28rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  font-size: 26rpx;
  font-weight: 500;
  color: #4b5563;
  border: 1rpx solid #f3f4f6;
  transition: all 0.2s;
}

.home-subcategory-pill:active {
  background: #f3f4f6;
  transform: scale(0.96);
}

/* 右侧固定展开按钮 */
/* Section 3: Hot Products */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-h1 {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
  position: relative;
  display: flex;
  align-items: center;
}

/* 标题装饰点 */
.section-h1::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  background: #ef4444;
  border-radius: 50%;
  margin-left: 12rpx;
  display: inline-block;
  opacity: 0.8;
}

.section-hint {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 500;
}

.hot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.hot-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.03),
    0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  display: flex;
  flex-direction: column;
  transition: all 0.2s ease;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.hot-card:active {
  transform: scale(0.98);
  box-shadow: none;
}

.card-img-box {
  width: 100%;
  padding-bottom: 100%; /* Square */
  position: relative;
  background: #f3f4f6;
}

.card-img-box image {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}

.stock-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  bottom: auto; /* 重置旧样式 */
  right: auto;
}

.card-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-code {
  font-size: 22rpx;
  color: #9ca3af;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.card-stock {
  font-size: 24rpx;
  color: #6366f1;
  font-weight: 700;
  margin-top: 4rpx;
}

/* --- Floating Dock (Bottom Nav) --- */
.floating-dock {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  z-index: 999;
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: var(--text-sub);
  width: 80rpx;
}

.dock-item-active {
  color: var(--text-main);
}

.dock-item text {
  font-size: 20rpx;
  font-weight: 500;
}

.dock-main {
  margin: 0 12rpx;
}

.dock-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  margin-top: -40rpx; /* Pop out effect */
  border: 6rpx solid #fff;
}

/* 启用状态：销售/管理员 - 柔和色调渐变 */
.dock-circle-enabled {
  background: linear-gradient(135deg, #d4a5d4 0%, #a8d8d0 100%);
  box-shadow:
    0 8rpx 24rpx rgba(168, 216, 208, 0.35),
    0 4rpx 12rpx rgba(212, 165, 212, 0.3);
}

/* 禁用状态：访客 / 普通用户
 * 显示柔和的极光渐变特效，不可点击、无任何提示
 */
.dock-circle-disabled {
  /* 实心渐变圆：不透明的 Aurora 风格 + 圆内扩散光晕（不跑出圆外） */
  background:
    /* 蓝色扩散斑块 */
    radial-gradient(
      circle at 20% 25%,
      rgba(59, 130, 246, 0.55) 0,
      rgba(59, 130, 246, 0) 55%
    ),
    /* 绿色扩散斑块 */
      radial-gradient(
        circle at 75% 30%,
        rgba(110, 231, 183, 0.45) 0,
        rgba(110, 231, 183, 0) 60%
      ),
    /* 红色扩散斑块 */
      radial-gradient(
        circle at 30% 75%,
        rgba(249, 115, 115, 0.4) 0,
        rgba(249, 115, 115, 0) 60%
      ),
    /* 粉色 / 金黄扩散斑块 */
      radial-gradient(
        circle at 80% 70%,
        rgba(249, 168, 212, 0.4) 0,
        rgba(249, 168, 212, 0) 60%
      ),
    /* 主线性渐变底色 */
      linear-gradient(
        135deg,
        #3b82f6 0%,
        /* 品牌深蓝 */ #93c5fd 18%,
        /* 浅蓝 */ #a5b4fc 30%,
        /* 淡紫蓝 */ #6ee7b7 36%,
        /* 柔和薄荷绿（区间再缩窄一点） */ #38bdf8 46%,
        /* 亮蓝 / 青蓝，提早接管主色 */ #f97373 82%,
        /* 柔和珊瑚红 */ #f9a8d4 90%,
        /* 粉色 */ #fde68a 100% /* 淡金黄收尾 */
      );
  /* 稍微放大背景尺寸，让颜色在动画时有“扩散”感（但都限制在圆内） */
  background-size: 240% 240%;
  animation: dock-aurora 6s ease-in-out infinite;
  /* 保留轻微中性阴影，只做“悬浮”效果，不再让彩色发光跑出圆外 */
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.55);
  /* 透明度略微降低，让极光更柔和但仍然偏“实心” */
  opacity: 0.96;
}

.dock-item:active {
  transform: scale(0.9);
  color: var(--text-main);
}

.dock-circle:active {
  transform: scale(0.95);
}

/* 底部中间按钮极光动画（仅访客 / 普通用户） */
@keyframes dock-aurora {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
