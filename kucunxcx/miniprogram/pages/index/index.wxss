/* 2025 Modern Design System - Index - 柔和色调 */

/* Global Reset */
page {
  background: linear-gradient(135deg,
    #f5e8f5 0%,
    #faf8f5 50%,
    #e5f5f0 100%);
  background-attachment: fixed;
  /* 2025 柔和色板 */
  --primary: #d4a5d4;
  --primary-light: #a8d8d0;
  --primary-soft: #f5eff5;
  --text-main: #3a3a3c;
  --text-sub: #6B7280;
  --text-muted: #9CA3AF;
  --border: #E5E7EB;
  --card-bg: rgba(255, 255, 255, 0.95);
  --shadow-sm: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-md: 0 8rpx 24rpx rgba(0,0,0,0.1);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  height: 100vh; /* 关键：锁死高度 */
  overflow: hidden; /* 关键：禁止 Page 滚动，只允许 scroll-view 滚动 */
}

.page-container {
  height: 100vh;
  width: 100vw;
  position: relative;
  overflow: hidden;
}

/* --- Sticky Header (Overlay) --- */
.sticky-header {
  position: absolute; /* 覆盖在 scroll-view 之上 */
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box; /* 关键修复：防止 padding 撑大高度 */
}

/* 导航栏背景 - 玻璃拟态 + 柔和色调（更浅） */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 柔和渐变背景 + 玻璃效果（更浅的色调） */
  background: linear-gradient(135deg,
    rgba(245, 232, 245, 0.88) 0%,
    rgba(250, 248, 245, 0.88) 50%,
    rgba(229, 245, 240, 0.88) 100%);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  z-index: 0;
  transition: opacity 0.3s ease;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 极光渐变动效层 - 柔和色调（更浅） */
.header-bg::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    120deg,
    rgba(245, 232, 245, 0.25) 0%,
    rgba(229, 245, 240, 0.22) 25%,
    rgba(250, 248, 245, 0.20) 50%,
    rgba(212, 165, 212, 0.23) 75%,
    rgba(245, 232, 245, 0.25) 100%
  );
  background-size: 200% 200%;
  animation: aurora-flow 8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes aurora-flow {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

.nav-bar-content {
  position: relative;
  z-index: 10;
  width: 100%;
  padding-left: 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

/* Center Title (Initial State) */
.nav-center-title {
  position: absolute;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  pointer-events: none;
  z-index: 2;
  transition: opacity 0.2s ease-out;
  margin-left: -32rpx; 
}

/* Left Container (Scrolled State) */
.nav-left-container {
  display: flex;
  align-items: center;
  flex: 1;
  width: 100%;
  transition: all 0.2s ease-out;
  will-change: opacity, transform;
}

.nav-title-left {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* Mini Search Box in Header - 柔和色调 */
.search-box-mini {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 24rpx;
  max-width: 400rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.search-mini-input {
  flex: 1;
  height: 100%;
  font-size: 26rpx;
  color: var(--text-main);
  margin-left: 12rpx;
}

/* 搜索框清空按钮 */
.search-clear-icon {
  margin-left: 8rpx;
}

/* --- Hero Section --- */
.hero-section {
  padding: 16rpx 32rpx 24rpx;
}

.hero-search-bar {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx) saturate(180%);
  -webkit-backdrop-filter: blur(20rpx) saturate(180%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08), inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.15s ease-out;
}

.hero-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-main);
  margin-left: 16rpx;
}

/* --- Main Content Structure --- */
.main-scroll {
  height: 100vh;
}

.scroll-content {
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx; 
}

/* Section 2: Sticky Filter Bar */
/* 分类导航卡片（一级 + 二级）- 玻璃形态学 */
.section-categories {
  margin-top: 8rpx;
}

.home-category-card {
  background: var(--card-bg);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: 28rpx; /* 增大圆角 */
  padding: 28rpx;
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  margin-bottom: 24rpx; /* 增加间距 */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.home-category-card:active {
  transform: scale(0.98);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.06),
    0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.home-category-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 6rpx;
}

.home-category-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-all-btn {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(212, 165, 212, 0.1);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--primary);
  transition: all 0.2s ease;
}

.home-all-btn:active {
  background: rgba(212, 165, 212, 0.2);
}

.home-category-icon {
  width: 48rpx; /* 增大图标 */
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

/* 1级分类：柔和色调渐变圆形图标 */
.icon-level1 {
  background: linear-gradient(135deg, #d4a5d4 0%, #a8d8d0 100%);
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 212, 0.3);
}

.home-category-name {
  font-size: 30rpx; /* 增大字号 */
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 0.3rpx;
}

/* 2级分类：柔和色调胶囊按钮（更浅） */
.home-subcategory-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx; /* 增大间距 */
  padding-top: 12rpx;
}

.home-subcategory-pill {
  padding: 10rpx 24rpx; /* 增大内边距 */
  border-radius: 999rpx;
  background: linear-gradient(135deg,
    rgba(245, 232, 245, 0.08) 0%,
    rgba(229, 245, 240, 0.06) 100%);
  font-size: 26rpx; /* 增大字号 */
  font-weight: 500;
  color: var(--text-sub);
  border: 1rpx solid rgba(212, 165, 212, 0.15);
  transition: all 0.2s ease;
}

.home-subcategory-pill:active {
  transform: scale(0.95);
  background: linear-gradient(135deg,
    rgba(245, 232, 245, 0.15) 0%,
    rgba(229, 245, 240, 0.12) 100%);
}

/* "全部"胶囊：用柔和色调描边，更突出 */
.home-subcategory-pill-all {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 右侧固定展开按钮 */
/* Section 3: Hot Products */
.section-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-h1 {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-hint {
  font-size: 24rpx;
  color: var(--text-muted);
}


.hot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-top: 12rpx;
}

.hot-card {
  background: var(--card-bg);
  backdrop-filter: blur(20rpx) saturate(180%);
  -webkit-backdrop-filter: blur(20rpx) saturate(180%);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  flex-direction: column;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.hot-card:active {
  transform: scale(0.98);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.06),
    0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.card-img-box {
  width: 100%;
  padding-bottom: 100%; /* Square */
  position: relative;
  background: #F2F2F7;
}

.card-img-box image {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.stock-tag {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(255,255,255,0.9);
  color: #FF3B30;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.card-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-code {
  font-size: 22rpx;
  color: var(--text-muted);
}

.card-stock {
  font-size: 24rpx;
  color: var(--primary); /* Accent Color */
  font-weight: 500;
  margin-top: 4rpx;
}

/* --- Floating Dock (Bottom Nav) --- */
.floating-dock {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.12);
  border: 1rpx solid rgba(255,255,255,0.5);
  z-index: 999;
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: var(--text-sub);
  width: 80rpx;
}

.dock-item text {
  font-size: 20rpx;
  font-weight: 500;
}

.dock-main {
  margin: 0 12rpx;
}

.dock-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.25);
  margin-top: -40rpx; /* Pop out effect */
  border: 6rpx solid #fff;
}

/* 启用状态：销售/管理员 - 柔和色调渐变 */
.dock-circle-enabled {
  background: linear-gradient(135deg, #d4a5d4 0%, #a8d8d0 100%);
  box-shadow:
    0 8rpx 24rpx rgba(168, 216, 208, 0.35),
    0 4rpx 12rpx rgba(212, 165, 212, 0.3);
}

/* 禁用状态：访客 / 普通用户
 * 显示柔和的极光渐变特效，不可点击、无任何提示
 */
.dock-circle-disabled {
  /* 实心渐变圆：不透明的 Aurora 风格 + 圆内扩散光晕（不跑出圆外） */
  background:
    /* 蓝色扩散斑块 */
    radial-gradient(circle at 20% 25%, rgba(59, 130, 246, 0.55) 0, rgba(59, 130, 246, 0) 55%),
    /* 绿色扩散斑块 */
    radial-gradient(circle at 75% 30%, rgba(110, 231, 183, 0.45) 0, rgba(110, 231, 183, 0) 60%),
    /* 红色扩散斑块 */
    radial-gradient(circle at 30% 75%, rgba(249, 115, 115, 0.4) 0, rgba(249, 115, 115, 0) 60%),
    /* 粉色 / 金黄扩散斑块 */
    radial-gradient(circle at 80% 70%, rgba(249, 168, 212, 0.4) 0, rgba(249, 168, 212, 0) 60%),
    /* 主线性渐变底色 */
    linear-gradient(
      135deg,
      #3B82F6 0%,   /* 品牌深蓝 */
      #93C5FD 18%,  /* 浅蓝 */
      #A5B4FC 30%,  /* 淡紫蓝 */
      #6EE7B7 36%,  /* 柔和薄荷绿（区间再缩窄一点） */
      #38BDF8 46%,  /* 亮蓝 / 青蓝，提早接管主色 */
      #F97373 82%,  /* 柔和珊瑚红 */
      #F9A8D4 90%,  /* 粉色 */
      #FDE68A 100%  /* 淡金黄收尾 */
    );
  /* 稍微放大背景尺寸，让颜色在动画时有“扩散”感（但都限制在圆内） */
  background-size: 240% 240%;
  animation: dock-aurora 6s ease-in-out infinite;
  /* 保留轻微中性阴影，只做“悬浮”效果，不再让彩色发光跑出圆外 */
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.55);
  /* 透明度略微降低，让极光更柔和但仍然偏“实心” */
  opacity: 0.96;
}

.dock-item:active {
  transform: scale(0.9);
  color: var(--text-main);
}

.dock-circle:active {
  transform: scale(0.95);
}

/* 底部中间按钮极光动画（仅访客 / 普通用户） */
@keyframes dock-aurora {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
