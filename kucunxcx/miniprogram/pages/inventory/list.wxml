<!-- 库存查询页 -->
<wxs src="../../utils/format.wxs" module="fmt" />

<view class="container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <van-search
      value="{{ searchValue }}"
      placeholder="搜索产品名称/产品编号"
      bind:search="onSearch"
      bind:change="onSearchChange"
      shape="round"
      background="transparent"
    />
  </view>

  <!-- 筛选 -->
  <van-dropdown-menu class="filter-section" active-color="#007aff">
    <van-dropdown-item value="{{ filterProduct }}" options="{{ productOptions }}" bind:change="onProductChange" />
    <van-dropdown-item value="{{ filterStatus }}" options="{{ statusOptions }}" bind:change="onStatusChange" />
  </van-dropdown-menu>

  <!-- 库存列表 - 使用scroll-view -->
  <scroll-view class="scroll-container" scroll-y>
    <view class="inventory-list">
      <view
        wx:for="{{ inventoryList }}"
        wx:key="id"
        class="inventory-item"
        bindtap="navigateToDetail"
        data-id="{{ item.id }}"
      >
        <view class="item-header">
          <text class="product-name">{{ item.product.name }}</text>
          <van-tag type="{{ item.statusType }}" size="medium">
            {{ item.statusText }}
          </van-tag>
        </view>

        <van-cell-group border="{{ false }}">
          <van-cell title="产品编号" value="{{ item.product.code }}" />
          <!-- 访客模式不展示批次号，仅内部账号可见 -->
          <van-cell
            wx:if="{{ canViewNumericInventory }}"
            title="批次号"
            value="{{ item.batchNumber }}"
          />
          <van-cell
            title="每件片数"
            value="{{ item.batchPiecesPerUnit ? (item.batchPiecesPerUnit + '片/件') : (item.product.piecesPerUnit ? (item.product.piecesPerUnit + '片/件') : '-') }}"
          />
          <van-cell
            title="每件重量"
            value="{{ item.weight ? (item.weight + 'kg/件') : '—' }}"
          />
          <van-cell
            title="总库存"
            value="{{ canViewNumericInventory ? fmt.formatQuantityWithPieces(item.quantity, item.product.unit, item.batchPiecesPerUnit || item.product.piecesPerUnit) : (item.availableQuantity > 0 ? '有货' : '缺货') }}"
          />
          <van-cell
            title="可用库存"
            value="{{ canViewNumericInventory ? fmt.formatQuantityWithPieces(item.availableQuantity, item.product.unit, item.batchPiecesPerUnit || item.product.piecesPerUnit) : (item.availableQuantity > 0 ? '有货' : '缺货') }}"
          />
          <van-cell title="更新时间" value="{{ item.updatedAt }}" label-class="time-label" />
        </van-cell-group>
      </view>

      <!-- 空状态 -->
      <van-empty
        wx:if="{{ inventoryList.length === 0 }}"
        description="暂无库存数据"
        image="search"
      />
    </view>
  </scroll-view>
</view>
