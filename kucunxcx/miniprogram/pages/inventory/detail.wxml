<!-- 库存详情页 -->
<wxs src="../../utils/format.wxs" module="fmt" />

<view class="container">
  <block wx:if="{{ inventory }}">
    <!-- 产品信息卡片 -->
    <view class="info-card">
      <view class="item-header">
        <view class="title-col">
          <text class="product-name">
            {{ inventory.product.name }}
          </text>
          <text class="product-code">
            编码：{{ inventory.product.code }}
          </text>
        </view>
        <van-tag
          type="{{ fmt.getStockStatusType(inventory.availableQuantity) }}"
          size="medium"
        >
          {{ fmt.formatStockStatus(inventory.availableQuantity) }}
        </van-tag>
      </view>

      <van-cell-group border="{{ false }}">
        <van-cell
          title="单位"
          value="{{ fmt.formatUnit(inventory.product.unit) }}"
        />
        <van-cell
          title="分类"
          value="{{ inventory.product.category ? inventory.product.category.name : '未分类' }}"
        />
        <van-cell
          title="规格"
          value="{{ inventory.product.specification || '默认规格' }}"
        />
      </van-cell-group>
    </view>

    <!-- 库存信息卡片 -->
    <view class="info-card">
      <view class="card-title">库存信息</view>
      <van-cell-group border="{{ false }}">
        <van-cell
          title="总库存"
          value="{{ canViewNumericInventory ? fmt.formatQuantity(inventory.quantity, inventory.product.unit, inventory.batchPiecesPerUnit || inventory.product.piecesPerUnit) : (inventory.availableQuantity > 0 ? '有货' : '缺货') }}"
        />
        <van-cell
          title="预留库存"
          value="{{ canViewNumericInventory ? fmt.formatQuantity(inventory.reservedQuantity, inventory.product.unit, inventory.batchPiecesPerUnit || inventory.product.piecesPerUnit) : (inventory.availableQuantity > 0 ? '有货' : '缺货') }}"
        />
        <van-cell
          title="可用库存"
          value="{{ canViewNumericInventory ? fmt.formatQuantity(inventory.availableQuantity, inventory.product.unit, inventory.batchPiecesPerUnit || inventory.product.piecesPerUnit) : (inventory.availableQuantity > 0 ? '有货' : '缺货') }}"
        />
        <van-cell
          title="每件片数"
          value="{{ inventory.batchPiecesPerUnit ? (inventory.batchPiecesPerUnit + '片/件') : (inventory.product.piecesPerUnit ? (inventory.product.piecesPerUnit + '片/件') : '-') }}"
        />
        <van-cell
          title="每件重量"
          value="{{ inventory.weight ? (inventory.weight + 'kg/件') : '—' }}"
        />
        <!-- 访客模式不展示批次号，仅内部账号可见 -->
        <van-cell
          wx:if="{{ canViewNumericInventory }}"
          title="批次号"
          value="{{ inventory.batchNumber || '—' }}"
        />
        <van-cell
          title="更新时间"
          value="{{ inventory.updatedAt }}"
        />
      </van-cell-group>
    </view>

    <!-- 扩展信息 -->
    <view class="info-card" wx:if="{{ inventory.weight }}">
      <view class="card-title">扩展信息</view>
      <van-cell-group border="{{ false }}">
        <van-cell title="重量(kg)" value="{{ inventory.weight }}" />
      </van-cell-group>
    </view>
  </block>

  <!-- 空状态 -->
  <van-empty
    wx:if="{{ !loading && !inventory }}"
    description="暂无库存数据"
    image="search"
  />
</view>
