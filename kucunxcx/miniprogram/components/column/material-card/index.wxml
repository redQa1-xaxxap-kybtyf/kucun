<!-- 素材卡片组件 -->
<view 
  class="material-card {{mode}} {{selected ? 'selected' : ''}}"
  bindtap="onTap"
  bindlongpress="onLongPress"
>
  <!-- 图片 -->
  <image 
    class="card-image" 
    src="{{material.image || material.thumbnailUrl}}" 
    mode="aspectFill"
  />

  <!-- 信息区域 -->
  <view class="card-info">
    <text class="card-code">{{material.code}}</text>
    <text class="card-name" wx:if="{{mode === 'list'}}">{{material.name}}</text>
    <view class="card-meta">
      <text class="meta-tag">{{material.slotName}}</text>
      <text class="meta-height">{{material.height}}mm</text>
    </view>
    <view class="cuttable-badge {{material.cuttable ? 'yes' : 'no'}}" wx:if="{{mode === 'list'}}">
      {{material.cuttable ? '可切' : '不可切'}}
    </view>
  </view>

  <!-- 添加按钮 -->
  <view 
    class="add-btn" 
    wx:if="{{showAddButton}}"
    catchtap="onAdd"
  >
    +
  </view>

  <!-- 选中标记 -->
  <view class="selected-mark" wx:if="{{selected}}">
    <text>✓</text>
  </view>
</view>
