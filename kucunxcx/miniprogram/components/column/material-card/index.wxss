/* 素材卡片组件样式 */

.material-card {
  position: relative;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.material-card.selected {
  border: 3rpx solid #667eea;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.2);
}

.material-card:active {
  transform: scale(0.98);
}

/* 列表模式 */
.material-card.list {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.material-card.list .card-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.material-card.list .card-info {
  flex: 1;
  min-width: 0;
}

.material-card.list .card-code {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 4rpx;
}

.material-card.list .card-name {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-card.list .card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

/* 网格模式 */
.material-card.grid {
  display: flex;
  flex-direction: column;
}

.material-card.grid .card-image {
  width: 100%;
  height: 200rpx;
}

.material-card.grid .card-info {
  padding: 16rpx;
}

.material-card.grid .card-code {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.material-card.grid .card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

/* 通用样式 */
.meta-tag {
  font-size: 22rpx;
  color: #999;
  background: #f5f6fa;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.meta-height {
  font-size: 22rpx;
  color: #667eea;
}

.cuttable-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.cuttable-badge.yes {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
}

.cuttable-badge.no {
  color: #999;
  background: #f0f0f0;
}

/* 添加按钮 */
.add-btn {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.material-card.grid .add-btn {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  font-size: 32rpx;
}

/* 选中标记 */
.selected-mark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #667eea;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
