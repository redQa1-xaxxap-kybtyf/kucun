/* 底部导航组件样式 (Floating Dock) */
.floating-dock {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  z-index: 999;
}

.floating-dock.no-blur {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: #6b7280;
  width: 80rpx;
}

.dock-item-active {
  color: #1d2129;
}

.dock-item-text {
  font-size: 20rpx;
  font-weight: 500;
}

.dock-main {
  margin: 0 12rpx;
}

.dock-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  margin-top: -40rpx;
  border: 6rpx solid #fff;
}

.dock-circle-enabled {
  background: linear-gradient(135deg, #d4a5d4 0%, #a8d8d0 100%);
  box-shadow:
    0 8rpx 24rpx rgba(168, 216, 208, 0.35),
    0 4rpx 12rpx rgba(212, 165, 212, 0.3);
}

/* 禁用状态：访客 / 普通用户 - 墨绿流动渐变 + 祖母绿外圈特效 */
.dock-circle-disabled {
  position: relative;
  background:
    radial-gradient(
      circle at 25% 30%,
      rgba(34, 197, 94, 0.35) 0%,
      transparent 50%
    ),
    radial-gradient(
      circle at 75% 70%,
      rgba(16, 185, 129, 0.3) 0%,
      transparent 55%
    ),
    radial-gradient(
      circle at 50% 50%,
      rgba(21, 128, 61, 0.25) 0%,
      transparent 60%
    ),
    linear-gradient(
      135deg,
      #0f3d1a 0%,
      #15803d 20%,
      #166534 35%,
      #0f3d1a 50%,
      #14532d 65%,
      #166534 80%,
      #0f3d1a 100%
    );
  background-size: 200% 200%;
  animation: darkGreenFlow 5s ease-in-out infinite;
  box-shadow:
    0 8rpx 24rpx rgba(15, 61, 26, 0.5),
    0 0 40rpx rgba(22, 101, 52, 0.3);
}

/* 祖母绿外圈跑动特效 */
.dock-circle-disabled::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    transparent 270deg,
    #50c878 270deg,
    #2e8b57 300deg,
    #3cb371 330deg,
    transparent 360deg
  );
  animation: emeraldRing 6s linear infinite;
  animation-delay: 2.5s;
  opacity: 0;
  z-index: -1;
}

@keyframes darkGreenFlow {
  0%,
  100% {
    background-position: 0% 50%;
  }
  25% {
    background-position: 50% 0%;
  }
  50% {
    background-position: 100% 50%;
  }
  75% {
    background-position: 50% 100%;
  }
}

@keyframes emeraldRing {
  0% {
    opacity: 0;
    transform: rotate(0deg);
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: rotate(360deg);
  }
}

.dock-item:active {
  transform: scale(0.9);
  color: #1d2129;
}

.dock-circle:active {
  transform: scale(0.95);
}
