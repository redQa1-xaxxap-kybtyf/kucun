<!-- 底部导航组件 (Floating Dock) -->
<view class="floating-dock {{ enableBackdropBlur ? '' : 'no-blur' }}">
  <view
    class="dock-item {{ active === 'home' ? 'dock-item-active' : '' }}"
    bindtap="navigateToHome"
  >
    <van-icon name="wap-home-o" size="22px" />
    <text class="dock-item-text">首页</text>
  </view>
  <view
    class="dock-item {{ active === 'categories' ? 'dock-item-active' : '' }}"
    bindtap="navigateToCategories"
  >
    <van-icon name="label-o" size="22px" />
    <text class="dock-item-text">分类</text>
  </view>
  <view class="dock-main" bindtap="onCenterTap">
    <view class="dock-circle {{ canCreateProduct ? 'dock-circle-enabled' : 'dock-circle-disabled' }}">
      <van-icon name="{{ canCreateProduct ? 'plus' : 'photo-o' }}" size="24px" color="#fff" />
    </view>
  </view>
  <view
    class="dock-item {{ active === 'inventory' ? 'dock-item-active' : '' }}"
    bindtap="navigateToInventory"
  >
    <van-icon name="search" size="22px" />
    <text class="dock-item-text">查询</text>
  </view>
  <view
    class="dock-item {{ active === 'user' ? 'dock-item-active' : '' }}"
    bindtap="navigateToUser"
  >
    <van-icon name="user-o" size="22px" />
    <text class="dock-item-text">我的</text>
  </view>
</view>
