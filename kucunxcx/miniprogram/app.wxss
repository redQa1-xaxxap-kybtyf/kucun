/**app.wxss**/
/* CSS Variables for Apple/iOS Design System */
page {
  /* Colors - Refined for "Simple & Elegant" (Apple/JD Clean) */
  --ios-bg: #f5f5f7; /* Apple system background */
  --ios-card-bg: #ffffff;
  --ios-text-primary: #1d1d1f; /* Apple text black */
  --ios-text-secondary: #86868b;
  --ios-text-tertiary: #c7c7cc;

  /* Accents - Using a sophisticated Blue as primary, similar to Apple Store app */
  --ios-blue: #0071e3;
  --ios-green: #34c759;
  --ios-red: #ff3b30;
  --ios-orange: #ff9500;
  --ios-purple: #af52de;

  --ios-separator: rgba(60, 60, 67, 0.36);

  /* Spacing & Layout */
  --ios-radius: 20rpx; /* Refined radius */
  --ios-padding: 32rpx;

  /* Shadows - Softer, more diffuse */
  --ios-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  --ios-shadow-active: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);

  /* Global Font Settings */
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    'Helvetica Neue',
    Helvetica,
    Segoe UI,
    Arial,
    Roboto,
    'PingFang SC',
    'Hiragino Sans GB',
    'Microsoft Yahei',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  background-color: var(--ios-bg);
  color: var(--ios-text-primary);
}

.container {
  height: 100%;
  box-sizing: border-box;
}

/* Utility Classes */
.ios-card {
  background-color: var(--ios-card-bg);
  border-radius: var(--ios-radius);
  padding: var(--ios-padding);
  box-shadow: var(--ios-shadow);
  margin-bottom: 24rpx;
}

.text-primary {
  color: var(--ios-text-primary);
}
.text-secondary {
  color: var(--ios-text-secondary);
}
.text-blue {
  color: var(--ios-blue);
}

/* 性能优化：低性能设备关闭毛玻璃（Android 部分机型 backdrop-filter 掉帧/不生效） */
.no-blur view {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}
