.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  padding: 8rpx 2rpx 22rpx;
  box-sizing: border-box;
}

.page-header__copy {
  flex: 1;
  min-width: 0;
}

.page-header__eyebrow {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e6e9dd;
  color: #1a4035;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
}

.page-header__title {
  margin-top: 10rpx;
  color: #1f2328;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: 0.5rpx;
}

.page-header__desc {
  margin-top: 10rpx;
  color: #73716d;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.45;
}
