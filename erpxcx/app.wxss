@import './styles/tokens.wxss';

page {
  min-height: 100%;
  background: var(--bg-page);
  color: var(--text-primary);
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial,
    sans-serif;
  letter-spacing: 0;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

input,
textarea {
  color: var(--text-primary);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.text-muted {
  color: var(--text-secondary);
}

.line-clamp-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.loading-spinner {
  width: 34rpx;
  height: 34rpx;
  margin: 0 auto;
  border: 4rpx solid var(--border-subtle);
  border-top-color: var(--brand-500);
  border-radius: 999rpx;
  animation: spin 800ms linear infinite;
  box-sizing: border-box;
}

.loading-spinner.small {
  width: 24rpx;
  height: 24rpx;
  margin: 0;
  border-width: 3rpx;
}

.page-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 100vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.loading-text {
  color: var(--text-secondary);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.share-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
}

.share-icon-hover {
  opacity: 0.72;
}

.share-mark {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.share-dot,
.share-line {
  position: absolute;
  background: var(--brand-500);
}

.share-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
}

.share-dot.start {
  left: 1rpx;
  top: 12rpx;
}

.share-dot.top {
  right: 1rpx;
  top: 2rpx;
}

.share-dot.bottom {
  right: 1rpx;
  bottom: 2rpx;
}

.share-line {
  left: 10rpx;
  width: 22rpx;
  height: 3rpx;
  border-radius: 999rpx;
  transform-origin: left center;
}

.share-line.top {
  top: 13rpx;
  transform: rotate(-28deg);
}

.share-line.bottom {
  top: 19rpx;
  transform: rotate(28deg);
}
