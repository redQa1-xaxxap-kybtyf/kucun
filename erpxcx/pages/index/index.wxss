.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f4f5f4;
  color: #13252f;
}

button::after {
  border: 0;
}

.header {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 18rpx 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 70rpx;
  padding: 0 20rpx 0 28rpx;
  border-radius: 999rpx;
  background: #f2f5f7;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  color: #13252f;
  font-size: 27rpx;
  font-weight: 400;
}

.search-clear {
  flex: none;
  height: 44rpx;
  margin: 0 14rpx 0 0;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #e6ecef;
  color: #6b7880;
  font-size: 21rpx;
  line-height: 44rpx;
}

.search-icon {
  position: relative;
  flex: none;
  width: 31rpx;
  height: 31rpx;
  border: 2rpx solid #68727c;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 15rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #68727c;
  content: '';
  transform: rotate(45deg);
}

.admin-entry {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  margin: 0;
  border-radius: 8rpx;
  background: #1f5a50;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.notice {
  margin: 18rpx 20rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #f0b8a8;
  border-radius: 8rpx;
  background: #fff5f1;
  color: #b42318;
  font-size: 25rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 28rpx 20rpx 16rpx;
}

.section-title {
  color: #13252f;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.24;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #6b7880;
  font-size: 24rpx;
  font-weight: 400;
}

.state-card {
  margin: 22rpx 20rpx 0;
  padding: 52rpx 28rpx;
  border: 1rpx solid #e6ebed;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
}

.state-card.slim {
  margin: 20rpx 0 0;
  padding: 42rpx 24rpx;
}

.state-card.slim .state-title,
.state-card .state-title:first-child {
  margin-top: 0;
}

.state-title {
  margin-top: 16rpx;
  color: #13252f;
  font-size: 28rpx;
  font-weight: 700;
}

.state-text {
  margin-top: 10rpx;
  color: #6b7880;
  font-size: 24rpx;
  line-height: 1.45;
}

.home-loading {
  min-height: calc(100vh - 92rpx);
}

.shelf {
  display: grid;
  grid-template-columns: 164rpx minmax(0, 1fr);
  height: calc(100vh - 92rpx);
  min-height: 650rpx;
  background: #f4f5f4;
}

.color-rail {
  height: 100%;
  background: #fff;
  box-sizing: border-box;
}

.color-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 16rpx 12rpx 28rpx;
  box-sizing: border-box;
}

.color-item.active {
  background: #f4f5f4;
}

.color-name {
  width: 100%;
  overflow: hidden;
  color: #68727c;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.color-item.active .color-name {
  color: #236152;
  font-weight: 700;
}

.shelf-main {
  position: relative;
  height: 100%;
  padding: 18rpx 16rpx 100rpx;
  background: #f4f5f4;
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  height: 176rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #dfe4e3;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #60706a;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 26rpx 26rpx 20rpx;
  background: linear-gradient(
    180deg,
    rgba(12, 25, 32, 0),
    rgba(12, 25, 32, 0.56)
  );
  box-sizing: border-box;
}

.hero-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 1.2;
}

.shelf-content {
  min-height: 100%;
  padding: 20rpx 0 28rpx;
  transition: opacity 120ms ease;
}

.shelf-content.muted {
  opacity: 0.45;
}

.loading-pill {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #5f6c74;
  font-size: 21rpx;
  line-height: 46rpx;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.group-card {
  padding: 24rpx 22rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.group-title {
  flex: 1;
  min-width: 0;
  color: #1d3441;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.32;
}

.group-summary {
  flex: none;
  max-width: 180rpx;
  color: #6b7880;
  font-size: 21rpx;
  line-height: 1.32;
  text-align: right;
}

.product-mini-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 20rpx;
  row-gap: 24rpx;
}

.mini-product {
  min-width: 0;
}

.mini-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  overflow: hidden;
  border-radius: 8rpx;
  background: #f1f3f3;
}

.mini-image {
  width: 100%;
  height: 100%;
}

.mini-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 30rpx;
  background: rgba(224, 238, 232, 0.92);
  color: #3d625a;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

.mini-title {
  margin-top: 13rpx;
  color: #1d3441;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.26;
  text-align: center;
}

.group-empty {
  padding: 34rpx 20rpx;
  border-radius: 8rpx;
  background: #f5f7f7;
  color: #6b7880;
  font-size: 24rpx;
  text-align: center;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx;
}

.search-grid {
  margin: 18rpx 20rpx 0;
  padding-bottom: 30rpx;
}

.product-card {
  min-width: 0;
}

.product-media {
  position: relative;
  width: 100%;
  height: 118rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #f1f3f3;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-info {
  padding-top: 13rpx;
  box-sizing: border-box;
}

.product-name {
  color: #13252f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.product-code {
  margin-top: 6rpx;
  color: #236152;
  font-size: 21rpx;
  line-height: 1.25;
}

.product-meta,
.product-spec {
  margin-top: 5rpx;
  color: #6b7880;
  font-size: 20rpx;
  line-height: 1.3;
}

.product-pack {
  margin-top: 7rpx;
  color: #236152;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.3;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #98a2b3;
  font-size: 21rpx;
  text-align: center;
}
