.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

button::after {
  border: 0;
}

.header {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 18rpx 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 70rpx;
  padding: 0 20rpx 0 28rpx;
  border-radius: 999rpx;
  background: var(--bg-subtle);
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  overflow: hidden;
  color: #1f2328;
  font-size: 27rpx;
  font-weight: 400;
}

.search-clear {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 42rpx;
  margin: 0 14rpx 0 10rpx;
  border-radius: 999rpx;
  background: rgba(39, 89, 79, 0.1);
  color: #27594f;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 42rpx;
  box-sizing: border-box;
}

.search-icon {
  position: relative;
  flex: none;
  width: 31rpx;
  height: 31rpx;
  border: 2rpx solid #73716d;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 15rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #73716d;
  content: '';
  transform: rotate(45deg);
}

.admin-entry {
  width: 96rpx;
  min-width: 96rpx;
  height: 64rpx;
  flex: none;
  margin: 0;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.notice {
  margin: 18rpx 20rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #f0b8a8;
  border-radius: 12rpx;
  background: #fff5f1;
  color: #b42318;
  font-size: 25rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 28rpx 20rpx 16rpx;
}

.section-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.section-title {
  color: #1f2328;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.24;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 24rpx;
  font-weight: 400;
}

.state-card {
  margin: 22rpx 20rpx 0;
  padding: 52rpx 28rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
}

.state-card.slim {
  margin: 20rpx 0 0;
  padding: 42rpx 24rpx;
}

.state-card.slim .state-title,
.state-card .state-title:first-child {
  margin-top: 0;
}

.state-title {
  margin-top: 16rpx;
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 700;
}

.state-text {
  margin-top: 10rpx;
  color: #73716d;
  font-size: 24rpx;
  line-height: 1.45;
}

.home-loading {
  min-height: calc(100vh - 92rpx);
}

.shelf {
  display: grid;
  grid-template-columns: 200rpx minmax(0, 1fr);
  height: calc(100vh - 92rpx);
  min-height: 650rpx;
  overflow: hidden;
  background: #f8f6f1;
}

.color-rail {
  height: 100%;
  overflow: hidden;
  overscroll-behavior: contain;
  background: #efece4;
  box-sizing: border-box;
}

.color-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 14rpx 16rpx 14rpx 20rpx;
  border-left: 6rpx solid transparent;
  box-sizing: border-box;
  transition: background-color 160ms ease;
}

.color-item.active {
  border-left-color: #27594f;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(15, 30, 40, 0.04);
}

.color-name {
  display: -webkit-box;
  width: 100%;
  overflow: hidden;
  color: #4b4945;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.32;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.color-item.active .color-name {
  color: #1a4035;
  font-weight: 700;
}

.shelf-main {
  position: relative;
  height: 100%;
  overflow: hidden;
  overscroll-behavior: contain;
  padding: 18rpx 16rpx 100rpx;
  background: #f8f6f1;
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  height: 176rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #e7e0d6;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-fallback {
  background: linear-gradient(180deg, #dde5e2, #899592);
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 26rpx 26rpx 20rpx;
  background: linear-gradient(
    180deg,
    rgba(12, 25, 32, 0),
    rgba(12, 25, 32, 0.56)
  );
  box-sizing: border-box;
}

.hero-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 1.2;
}

.component-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.component-row {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 4rpx;
}

.component-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 92rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b4945;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
  box-sizing: border-box;
}

.component-chip.active {
  border-color: #27594f;
  background: #e6e9dd;
  color: #1a4035;
}

.component-count {
  color: #a09a8a;
  font-size: 20rpx;
  font-weight: 700;
}

.component-chip.active .component-count {
  color: #27594f;
}

.shelf-content {
  min-height: 100%;
  padding: 20rpx 0 28rpx;
  transition: opacity 120ms ease;
}

.shelf-content.muted {
  opacity: 0.45;
}

.loading-pill {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #73716d;
  font-size: 22rpx;
  line-height: 46rpx;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.group-card {
  padding: 24rpx 22rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.group-card.compact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 20rpx 18rpx;
}

.group-content {
  flex: 1;
  min-width: 0;
}

.group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.group-card.compact .group-head {
  align-items: center;
  margin-bottom: 0;
}

.group-title {
  flex: 1;
  min-width: 0;
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.32;
}

.group-summary {
  flex: none;
  max-width: 220rpx;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.32;
  text-align: right;
}

.product-mini-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 20rpx;
  row-gap: 24rpx;
}

.mini-product {
  min-width: 0;
}

.mini-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--bg-subtle);
}

.mini-image {
  width: 100%;
  height: 100%;
}

.mini-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 30rpx;
  background: rgba(224, 238, 232, 0.92);
  color: #1a4035;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

.mini-title {
  margin-top: 13rpx;
  overflow: hidden;
  color: #1f2328;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.26;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-title.wrap {
  display: -webkit-box;
  min-height: 60rpx;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.group-empty {
  padding: 34rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #73716d;
  font-size: 24rpx;
  text-align: center;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx;
}

.search-grid {
  margin: 18rpx 20rpx 0;
  padding-bottom: 30rpx;
}

.search-back {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #efece4;
  color: #4b4945;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.result-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
  margin: 16rpx 20rpx 120rpx;
}

.result-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 40, 0.06);
  box-sizing: border-box;
}

.result-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--bg-subtle);
}

.result-image {
  width: 100%;
  height: 100%;
}

.result-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-disabled);
  font-size: 26rpx;
  background: var(--bg-subtle);
}

.plan-action {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  height: 46rpx;
  min-width: 104rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-sm);
  color: var(--gold-600);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  line-height: 46rpx;
  box-sizing: border-box;
}

.plan-action.joined {
  background: var(--brand-100);
  color: var(--brand-700);
}

.plan-action-icon {
  font-size: 27rpx;
  line-height: 1;
}

.result-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 154rpx;
  padding: 16rpx 18rpx 18rpx;
  box-sizing: border-box;
}

.result-head-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.result-code {
  flex: 1 1 auto;
  min-width: 0;
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.25;
}

.result-spec-stack {
  flex: 0 1 160rpx;
  max-width: 52%;
  min-width: 104rpx;
  text-align: right;
}

.result-spec {
  min-width: 0;
  overflow: visible;
  color: #73716d;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
  text-overflow: clip;
  white-space: normal;
  word-break: break-word;
}

.result-name {
  margin-top: 8rpx;
  color: #4b4945;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
}

.result-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  width: 100%;
  margin-top: 10rpx;
  box-sizing: border-box;
}

.stock-note {
  margin-top: 7rpx;
  color: #b84a3d;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.stock-note.out {
  font-weight: 600;
}

.result-fact {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 8rpx;
  width: 100%;
  min-width: 0;
}

.result-fact.single {
  grid-template-columns: minmax(0, 1fr);
}

.fact-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
  max-width: 100%;
  min-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: var(--bg-subtle);
  box-sizing: border-box;
}

.fact-label {
  flex: none;
  color: #a09a8a;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.fact-value {
  min-width: 0;
  color: #4b4945;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 34rpx;
  white-space: nowrap;
}

.kw-hit {
  color: #b42318;
  font-weight: 700;
}

.load-more {
  padding: 2rpx 0 34rpx;
  color: #73716d;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
}

.plan-entry {
  position: fixed;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  width: 126rpx;
  height: 70rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-500);
  color: var(--text-on-brand);
  box-shadow: var(--shadow-brand);
  box-sizing: border-box;
}

.plan-entry-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 30rpx 30rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/><path d='M3 6h18'/><path d='M16 10a4 4 0 0 1-8 0'/></svg>");
}

.plan-entry-text {
  color: var(--text-on-brand);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  line-height: 1;
  white-space: nowrap;
}

.plan-count {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: var(--gold-500);
  color: var(--text-on-brand);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  line-height: 32rpx;
  box-sizing: border-box;
}

.product-card {
  min-width: 0;
}

.product-media {
  position: relative;
  width: 100%;
  height: 118rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #efece4;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-info {
  padding-top: 13rpx;
  box-sizing: border-box;
}

.product-name {
  color: #1f2328;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.product-code {
  margin-top: 6rpx;
  color: #1a4035;
  font-size: 22rpx;
  line-height: 1.25;
}

.product-meta,
.product-spec {
  margin-top: 5rpx;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.3;
}

.product-pack {
  margin-top: 7rpx;
  color: #1a4035;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a8a195;
  font-size: 22rpx;
  text-align: center;
}
