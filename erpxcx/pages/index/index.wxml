<view class="page">
  <view class="header">
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="搜瓷砖型号 / 名称 / 规格"
        value="{{search}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{search}}" class="search-clear" bindtap="onClearSearch">清空</view>
      <view class="search-icon" bindtap="onSearchIconTap"></view>
    </view>
    <button wx:if="{{hasAdminSession}}" class="admin-entry" bindtap="onAdminTap">工作台</button>
  </view>

  <view wx:if="{{loading}}" class="page-loading home-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中</view>
  </view>

  <view wx:elif="{{error}}" class="notice error-state">
    <view class="notice-title">加载失败</view>
    <view class="notice-text">{{error}}</view>
    <button class="retry-btn" bindtap="onRetryTap">重新加载</button>
  </view>

  <block wx:elif="{{isSearching}}">
    <view class="section-head">
      <view>
        <view class="section-title">搜索结果</view>
        <view class="section-subtitle">{{searchKeyword}}</view>
      </view>
      <view class="search-back" bindtap="onClearSearch">返回</view>
    </view>

    <view wx:if="{{!hasProducts}}" class="state-card">
      <view class="state-title">{{emptyTitle}}</view>
      <view class="state-text">{{emptyText}}</view>
    </view>

    <view wx:else class="product-grid result-grid">
      <view
        wx:for="{{products}}"
        wx:key="id"
        class="result-card"
        data-id="{{item.id}}"
        bindtap="onProductTap"
        bindlongpress="onProductLongpress"
      >
        <view class="result-media">
          <image
            wx:if="{{item.thumbnailUrl}}"
            class="result-image"
            src="{{item.thumbnailUrl}}"
            mode="aspectFit"
            lazy-load
          />
          <view wx:else class="result-image result-image-fallback">暂无图片</view>
          <view
            class="plan-action {{item.inPlan ? 'joined' : ''}}"
            data-id="{{item.id}}"
            catchtap="onAddPlanTap"
          >
            <text class="plan-action-icon">{{item.inPlan ? '✓' : '+'}}</text>
            <text>{{item.inPlan ? '已加入' : '报货'}}</text>
          </view>
        </view>
        <view class="result-info">
          <view class="result-head-row">
            <view class="result-code line-clamp-1">
              <block wx:if="{{item.codeParts && item.codeParts.length > 0}}">
                <text
                  wx:for="{{item.codeParts}}"
                  wx:for-item="part"
                  wx:key="index"
                  class="{{part.hit ? 'kw-hit' : ''}}"
                >{{part.text}}</text>
              </block>
              <block wx:else>{{item.code}}</block>
            </view>
            <view wx:if="{{item.specification}}" class="result-spec-stack">
              <view class="result-spec">
                <block wx:if="{{item.specParts && item.specParts.length > 0}}">
                  <text
                    wx:for="{{item.specParts}}"
                    wx:for-item="part"
                    wx:key="index"
                    class="{{part.hit ? 'kw-hit' : ''}}"
                  >{{part.text}}</text>
                </block>
                <block wx:else>{{item.specification}}</block>
              </view>
            </view>
          </view>
          <view wx:if="{{item.name}}" class="result-name line-clamp-1">
            <block wx:if="{{item.nameParts && item.nameParts.length > 0}}">
              <text
                wx:for="{{item.nameParts}}"
                wx:for-item="part"
                wx:key="index"
                class="{{part.hit ? 'kw-hit' : ''}}"
              >{{part.text}}</text>
            </block>
            <block wx:else>{{item.name}}</block>
          </view>
          <view wx:if="{{item.stockText && item.stockBadgeClass == 'out'}}" class="stock-note out">
            {{item.stockText}}
          </view>
          <view wx:if="{{item.factTags.length > 0}}" class="result-meta">
            <view wx:if="{{item.factTags.length > 0}}" class="result-fact {{item.factTags.length == 1 ? 'single' : ''}}">
              <view
                wx:for="{{item.factTags}}"
                wx:key="label"
                wx:for-item="fact"
                class="fact-item"
              >
                <text class="fact-label">{{fact.label}}</text>
                <text class="fact-value">{{fact.value}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{hasProducts && (loadMoreText || loadingMoreProducts)}}" class="load-more">
      {{loadingMoreProducts ? '正在加载...' : loadMoreText}}
    </view>
    <view wx:if="{{hasProducts || planCount > 0}}" class="plan-entry" bindtap="onPlanTap">
      <view class="plan-entry-icon"></view>
      <text class="plan-entry-text">报货</text>
      <text wx:if="{{planCount > 0}}" class="plan-count">{{planCount}}</text>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!hasSeries}}" class="state-card">
      <view class="state-title">{{emptyTitle}}</view>
      <view class="state-text">{{emptyText}}</view>
    </view>

    <view wx:else class="shelf" catchtouchmove="noop">
      <scroll-view class="color-rail" scroll-y enhanced enable-flex>
        <view
          wx:for="{{visibleSeries}}"
          wx:key="id"
          class="color-item {{selectedSeriesId == item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSeriesTap"
        >
          <view class="color-name">{{item.name}}</view>
        </view>
      </scroll-view>

      <scroll-view class="shelf-main" scroll-y enhanced enable-flex>
        <view class="hero-card">
          <image wx:if="{{bannerCoverUrl}}" class="hero-image" src="{{bannerCoverUrl}}" mode="aspectFill" />
          <view wx:else class="hero-image hero-fallback"></view>
          <view class="hero-mask">
            <view class="hero-title">{{selectedSeriesName}}</view>
            <view class="hero-subtitle">{{selectedSeriesProductCount}} 款产品</view>
          </view>
          <view wx:if="{{shelfLoading}}" class="loading-pill">
            <view class="loading-spinner small"></view>
            <text>加载中</text>
          </view>
        </view>

        <view class="shelf-content {{shelfLoading ? 'muted' : ''}}">
          <view wx:if="{{!hasGroups}}" class="state-card slim">
            <view class="state-title">暂无产品</view>
            <view class="state-text">{{selectedSeriesName}}</view>
          </view>

          <view wx:else class="group-list">
            <view
              wx:for="{{groups}}"
              wx:key="id"
              wx:for-item="group"
              class="group-card {{group.componentTags.length == 0 ? 'compact' : ''}}"
              data-id="{{group.id}}"
              data-kind="{{group.kind}}"
              data-series-id="{{group.colorSeries.id}}"
              data-component-count="{{group.componentCount}}"
              data-first-component-id="{{group.firstComponentId}}"
              bindtap="onGroupTap"
            >
              <view class="group-content">
                <view class="group-head">
                  <view class="group-title line-clamp-1">{{group.displayTitle}}</view>
                  <view class="group-summary">{{group.displaySummary}}</view>
                </view>

                <view wx:if="{{group.componentTags.length > 0}}" class="product-mini-grid">
                  <view
                    wx:for="{{group.componentTags}}"
                    wx:key="id"
                    wx:for-item="component"
                    class="mini-product"
                    data-id="{{group.colorSeries.id}}__{{component.id}}"
                    catchtap="onComponentGroupTap"
                  >
                    <view class="mini-media">
                      <image wx:if="{{component.coverUrl}}" class="mini-image" src="{{component.coverUrl}}" mode="aspectFit" lazy-load />
                      <view wx:else class="mini-image fallback">暂无图片</view>
                      <view class="mini-badge">共有 {{component.productCount || 0}} 款</view>
                    </view>
                    <view class="mini-title {{component.titleClass}}">{{component.label}}</view>
                  </view>
                </view>

              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
