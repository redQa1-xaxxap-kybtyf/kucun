.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 136rpx;
  box-sizing: border-box;
  background: #f8f6f1;
}

.empty {
  padding: 180rpx 32rpx;
  color: #8a8175;
  font-size: 28rpx;
  text-align: center;
}

.error {
  color: #9a3412;
}

.poster-page {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-frame {
  padding: 18rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 18rpx 44rpx rgba(31, 35, 40, 0.08);
}

.poster-canvas {
  display: block;
  overflow: hidden;
  border-radius: 18rpx;
  background: #fff;
}

.poster-tip {
  margin-top: 18rpx;
  color: #8a8175;
  font-size: 24rpx;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee7dd;
  background: rgba(248, 246, 241, 0.96);
}

.primary {
  width: 100%;
  height: 82rpx;
  border-radius: 999rpx;
  background: #27594f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}
