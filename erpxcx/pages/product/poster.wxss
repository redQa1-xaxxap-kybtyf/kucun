.page {
  min-height: 100vh;
  padding: 18rpx 18rpx 136rpx;
  box-sizing: border-box;
  background: #f8f6f1;
}

.empty {
  padding: 180rpx 32rpx;
  color: #73716d;
  font-size: 28rpx;
  text-align: center;
}

.empty.overlay {
  position: relative;
  z-index: 2;
}

.error {
  color: #b42318;
}

.error-panel {
  margin: 96rpx 16rpx 0;
  padding: 36rpx 28rpx;
  border: 1rpx solid #f3b8a6;
  border-radius: 12rpx;
  background: #fff4ef;
  text-align: center;
}

.error-title {
  color: #b42318;
  font-size: 30rpx;
  font-weight: 700;
}

.error-text {
  margin-top: 14rpx;
  color: #7a2e1f;
  font-size: 24rpx;
  line-height: 1.45;
}

.error-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.retry-btn,
.back-btn {
  height: 74rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 74rpx;
}

.retry-btn {
  background: #b42318;
  color: #fff;
}

.back-btn {
  border: 1rpx solid #f3b8a6;
  background: #fff;
  color: #b42318;
}

.poster-page {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-page.muted {
  position: absolute;
  left: -9999rpx;
  opacity: 0;
  pointer-events: none;
}

.poster-frame {
  padding: 12rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.poster-canvas {
  display: block;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
}

.poster-tip {
  margin-top: 16rpx;
  color: #73716d;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: center;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7e0d6;
  background: rgba(255, 255, 255, 0.96);
}

.primary {
  width: 100%;
  height: 82rpx;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.primary::after,
.retry-btn::after,
.back-btn::after {
  border: 0;
}
