<view class="page">
  <view wx:if="{{loading}}" class="page-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中</view>
  </view>
  <view wx:elif="{{error}}" class="state-block">
    <view class="state-block__title">产品暂时看不到</view>
    <view class="state-block__text">{{error}}</view>
    <view class="state-block__actions">
      <button class="state-block__primary" bindtap="onRetryLoadTap">重试</button>
      <button class="state-block__ghost" bindtap="onBackHomeTap">返回首页</button>
    </view>
  </view>

  <view wx:elif="{{product}}">
    <view class="gallery-wrap">
      <swiper
        class="gallery"
        current="{{currentImage}}"
        bindchange="onImageChange"
        indicator-dots="{{galleryImageUrls.length > 1}}"
        indicator-color="#d6cdbf"
        indicator-active-color="#27594f"
      >
        <swiper-item wx:for="{{galleryImageUrls}}" wx:key="*this">
          <image
            class="gallery-image"
            src="{{item}}"
            mode="aspectFit"
            lazy-load
            data-current="{{item}}"
            bindtap="onPreviewGallery"
          />
        </swiper-item>
        <swiper-item wx:if="{{galleryImageUrls.length == 0}}">
          <view class="gallery-image fallback">暂无图片</view>
        </swiper-item>
      </swiper>
      <view wx:if="{{imageTotal > 1}}" class="image-counter">{{currentImageNumber}}/{{imageTotal}}</view>
    </view>

    <view wx:if="{{imageTotal > 1}}" class="thumb-panel">
      <view class="thumb-row">
        <image
          wx:for="{{galleryImageUrls}}"
          wx:key="*this"
          wx:for-index="index"
          class="thumb-image {{currentImage == index ? 'active' : ''}}"
          src="{{item}}"
          mode="aspectFit"
          lazy-load
          data-index="{{index}}"
          bindtap="onThumbTap"
        />
      </view>
    </view>

    <view class="info-card">
      <view class="product-code-main" bindtap="onCopyProductModel">
        <text class="code-label">型号</text>
        <text class="code-value">{{product.code}}</text>
        <text wx:if="{{product.name}}" class="name-divider">·</text>
        <text wx:if="{{product.name}}" class="product-name-inline line-clamp-1">{{product.name}}</text>
        <text class="copy-hint">复制</text>
      </view>
      <view class="tag-row">
        <view class="tag">{{product.colorSeries.name}}</view>
        <view class="tag">{{product.componentType.label}}</view>
        <view wx:if="{{product.stockText}}" class="tag stock-tag {{product.stockBadgeClass}}">
          <text>{{product.stockText}}</text>
        </view>
      </view>
      <view class="product-info-grid">
        <view class="info-item wide">
          <view class="info-label">规格</view>
          <view class="info-value">{{product.specification || '未填写'}}</view>
        </view>
        <view class="info-item" wx:if="{{product.packageText}}">
          <view class="info-label">包装片数</view>
          <view class="info-value">{{product.packageText}}</view>
        </view>
        <view class="info-item" wx:if="{{product.weightText}}">
          <view class="info-label">重量</view>
          <view class="info-value">{{product.weightText}}</view>
        </view>
      </view>
      <view class="shelf-link" bindtap="onSeriesShelfTap">
        <view class="shelf-link-text">查看 {{product.colorSeries.name}} 同色系其他品种</view>
        <view class="shelf-link-arrow">›</view>
      </view>
    </view>

    <view class="section" wx:if="{{product.effectImageUrls.length > 0}}">
      <view class="section-title">效果案例</view>
      <view class="case-grid">
        <image
          wx:for="{{product.effectImageUrls}}"
          wx:key="*this"
          class="case-image"
          src="{{item}}"
          mode="aspectFit"
          lazy-load
          data-current="{{item}}"
          bindtap="onPreviewEffectImage"
        />
      </view>
    </view>

    <view class="section" wx:if="{{product.description}}">
      <view class="section-title">产品介绍</view>
      <view class="description">{{product.description}}</view>
    </view>

    <view class="section" wx:if="{{product.relatedGroups.length > 0}}">
      <view class="section-title">同色配套</view>
      <view class="match-grid">
        <view
          wx:for="{{product.relatedGroups}}"
          wx:key="id"
          class="match-card"
          data-id="{{item.id}}"
          bindtap="onRelatedGroupTap"
        >
          <view class="match-media">
            <image wx:if="{{item.coverUrl}}" class="match-cover" src="{{item.coverUrl}}" mode="aspectFit" lazy-load />
            <view wx:else class="match-cover fallback">暂无图片</view>
          </view>
          <view class="match-name line-clamp-2">{{item.componentType.label}}</view>
          <view class="match-code">查看产品</view>
        </view>
      </view>
    </view>

    <view class="bottom-actions safe-bottom">
      <view class="action-icon" bindtap="onPosterTap">
        <view class="action-icon-symbol poster"></view>
        <view class="action-icon-label">海报</view>
      </view>
      <view class="action-icon" bindtap="onPlanTap">
        <view class="action-icon-symbol plan"></view>
        <view wx:if="{{planCount > 0}}" class="action-icon-badge">{{planCount}}</view>
        <view class="action-icon-label">报货计划</view>
      </view>
      <button class="primary {{isInPlan ? 'joined' : ''}}" bindtap="onAddPlanTap">
        {{isInPlan ? '✓ 已加入计划' : '加入报货计划'}}
      </button>
    </view>
  </view>
</view>
