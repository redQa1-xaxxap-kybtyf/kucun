<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载产品...</view>
  <view wx:elif="{{error}}" class="empty error">{{error}}</view>

  <view wx:elif="{{product}}">
    <view class="gallery-wrap">
      <swiper
        class="gallery"
        current="{{currentImage}}"
        bindchange="onImageChange"
        indicator-dots="{{galleryImageUrls.length > 1}}"
        indicator-color="rgba(255,255,255,0.45)"
        indicator-active-color="#ffffff"
      >
        <swiper-item wx:for="{{galleryImageUrls}}" wx:key="*this">
          <image
            class="gallery-image"
            src="{{item}}"
            mode="aspectFill"
            data-current="{{item}}"
            bindtap="onPreviewGallery"
          />
        </swiper-item>
        <swiper-item wx:if="{{galleryImageUrls.length == 0}}">
          <view class="gallery-image fallback">暂无图片</view>
        </swiper-item>
      </swiper>
      <view wx:if="{{imageTotal > 1}}" class="image-counter">{{currentImageNumber}}/{{imageTotal}}</view>
    </view>

    <scroll-view wx:if="{{imageTotal > 1}}" scroll-x enhanced class="thumb-scroll">
      <view class="thumb-row">
        <image
          wx:for="{{galleryImageUrls}}"
          wx:key="*this"
          wx:for-index="index"
          class="thumb-image {{currentImage == index ? 'active' : ''}}"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="onThumbTap"
        />
      </view>
    </scroll-view>

    <view class="info-card">
      <view class="tag-row">
        <view class="tag">{{product.colorSeries.name}}</view>
        <view class="tag">{{product.componentType.label}}</view>
      </view>
      <view class="product-name">{{product.name}}</view>
      <view class="product-code">型号 {{product.code}}</view>
      <view class="spec">{{product.specification || '未填写规格'}}</view>
      <view class="shelf-link" bindtap="onSeriesShelfTap">
        <view class="shelf-link-text">看{{product.colorSeries.name}}全部款式</view>
        <view class="shelf-link-arrow">›</view>
      </view>
    </view>

    <view class="section" wx:if="{{product.effectImageUrls.length > 0}}">
      <view class="section-title">效果案例</view>
      <view class="case-grid">
        <image
          wx:for="{{product.effectImageUrls}}"
          wx:key="*this"
          class="case-image"
          src="{{item}}"
          mode="aspectFill"
          lazy-load
          data-current="{{item}}"
          bindtap="onPreviewEffectImage"
        />
      </view>
    </view>

    <view class="section" wx:if="{{product.description}}">
      <view class="section-title">产品介绍</view>
      <view class="description">{{product.description}}</view>
    </view>

    <view class="section" wx:if="{{product.relatedGroups.length > 0}}">
      <view class="section-title">同色配套</view>
      <view class="match-grid">
        <view
          wx:for="{{product.relatedGroups}}"
          wx:key="id"
          class="match-card"
          data-id="{{item.id}}"
          bindtap="onRelatedGroupTap"
        >
          <image wx:if="{{item.coverUrl}}" class="match-cover" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="match-cover fallback">图</view>
          <view class="match-name line-clamp-2">{{item.title}}</view>
          <view class="match-code">{{item.productCount}}款</view>
        </view>
      </view>
    </view>

    <view class="bottom-actions safe-bottom">
      <button class="secondary" open-type="share">分享产品</button>
      <button class="primary" open-type="contact">咨询</button>
    </view>
  </view>
</view>
