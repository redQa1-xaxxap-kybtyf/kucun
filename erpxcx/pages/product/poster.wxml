<view class="page">
  <view wx:if="{{loading}}" class="empty overlay">正在生成产品海报...</view>
  <view wx:if="{{error}}" class="error-panel overlay">
    <view class="error-title">海报生成失败</view>
    <view class="error-text">{{error}}</view>
    <view class="error-actions">
      <button class="retry-btn" bindtap="onRetryTap">重试</button>
      <button class="back-btn" bindtap="onBackDetailTap">返回详情</button>
    </view>
  </view>

  <view class="poster-page {{loading || error ? 'muted' : ''}}">
    <view class="poster-frame">
      <canvas
        id="posterCanvas"
        canvas-id="posterCanvas"
        type="2d"
        class="poster-canvas"
        style="width: {{canvasStyleWidth}}px; height: {{canvasStyleHeight}}px;"
        bindtap="onPreviewPoster"
      ></canvas>
    </view>
    <view class="poster-tip">保存后可直接发给客户，产品信息会自动带上。</view>
  </view>

  <view wx:if="{{product && !error}}" class="bottom-bar safe-bottom">
    <button
      class="primary"
      loading="{{saving || drawing}}"
      disabled="{{saving || drawing}}"
      bindtap="onSavePoster"
    >
      保存海报
    </button>
  </view>
</view>
