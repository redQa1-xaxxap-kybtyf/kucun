.page {
  min-height: 100vh;
  padding-bottom: 128rpx;
  background: #f8f6f1;
}

.empty {
  padding: 160rpx 32rpx;
  color: #8a8175;
  font-size: 28rpx;
  text-align: center;
}

.error {
  color: #9a3412;
}

.gallery {
  width: 100%;
  height: 720rpx;
  background: #e7e0d6;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a9388;
  font-size: 28rpx;
}

.info-card {
  margin: -42rpx 22rpx 0;
  padding: 24rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 18rpx 44rpx rgba(31, 35, 40, 0.08);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag,
.stock {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: #f6f1e8;
  color: #7a6b58;
  font-size: 22rpx;
  font-weight: 800;
}

.stock {
  background: #e8f5ef;
  color: #27594f;
}

.stock.out_of_stock {
  background: #f2eee8;
  color: #8a8175;
}

.product-name {
  margin-top: 20rpx;
  color: #1f2328;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.product-code {
  margin-top: 12rpx;
  color: #b68a45;
  font-family: monospace;
  font-size: 28rpx;
  font-weight: 900;
}

.spec {
  margin-top: 14rpx;
  color: #73716d;
  font-size: 26rpx;
  line-height: 1.6;
}

.section {
  margin: 26rpx 22rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #1f2328;
  font-size: 32rpx;
  font-weight: 900;
}

.description {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #5f5a53;
  font-size: 26rpx;
  line-height: 1.7;
}

.related-scroll {
  width: 100%;
  white-space: nowrap;
}

.related-row {
  display: flex;
  gap: 16rpx;
}

.related-card {
  flex: 0 0 auto;
  width: 230rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #fff;
}

.related-cover {
  width: 100%;
  height: 166rpx;
  border-radius: 16rpx;
  background: #efe8dc;
}

.related-name {
  margin-top: 12rpx;
  color: #1f2328;
  font-size: 24rpx;
  font-weight: 800;
}

.related-code {
  margin-top: 6rpx;
  color: #b68a45;
  font-family: monospace;
  font-size: 22rpx;
  font-weight: 800;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 22rpx 22rpx;
  border-top: 1rpx solid #eee7dd;
  background: rgba(248, 246, 241, 0.96);
}

.secondary,
.primary {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.secondary {
  background: #fff;
  color: #27594f;
}

.primary {
  background: #27594f;
  color: #fff;
}
