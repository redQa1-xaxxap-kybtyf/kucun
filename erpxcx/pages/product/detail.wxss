.page {
  min-height: 100vh;
  padding-bottom: 128rpx;
  background: #f8f6f1;
}

.empty {
  padding: 160rpx 32rpx;
  color: #73716d;
  font-size: 28rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.state-block {
  margin: 64rpx 24rpx 0;
  padding: 48rpx 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 40, 0.06);
  text-align: center;
}

.state-block__title {
  color: #1f2328;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.32;
}

.state-block__text {
  margin-top: 16rpx;
  color: #73716d;
  font-size: 26rpx;
  line-height: 1.55;
}

.state-block__actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.state-block__primary,
.state-block__ghost {
  height: 84rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.state-block__primary {
  background: #27594f;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(39, 89, 79, 0.22);
}

.state-block__ghost {
  border: 1rpx solid #e7e0d6;
  background: #ffffff;
  color: #4b4945;
}

.gallery-wrap {
  position: relative;
  padding: 22rpx 20rpx 0;
  background: #f8f6f1;
}

.gallery {
  width: 100%;
  height: 520rpx;
  overflow: hidden;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.04);
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a8a195;
  font-size: 26rpx;
  font-weight: 700;
}

.image-counter {
  position: absolute;
  right: 42rpx;
  bottom: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(16, 24, 40, 0.72);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
}

.thumb-panel {
  margin-top: 14rpx;
}

.thumb-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 22rpx 4rpx;
}

.thumb-image {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border: 4rpx solid transparent;
  border-radius: 12rpx;
  background: var(--bg-subtle);
  box-sizing: border-box;
}

.thumb-image.active {
  border-color: #27594f;
}

.info-card {
  margin: 18rpx 20rpx 0;
  padding: 26rpx 24rpx 24rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.035);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 7rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--stone-100);
  color: var(--text-secondary);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}

.stock-tag {
  background: var(--success-50);
  color: var(--success-500);
}

.stock-tag.out {
  background: var(--danger-50);
  color: var(--danger-500);
}

.product-code-main {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  color: var(--text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.24;
}

.code-label {
  flex: none;
  padding: 5rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--stone-100);
  color: var(--text-tertiary);
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial,
    sans-serif;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.code-value {
  flex: none;
  min-width: 0;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  word-break: break-all;
}

.name-divider {
  flex: none;
  color: var(--text-tertiary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}

.product-name-inline {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.24;
}

.copy-hint {
  flex: none;
  padding: 5rpx 10rpx;
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial,
    sans-serif;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.product-info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.info-item {
  min-width: 0;
  padding: 18rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-mute);
}

.info-item.wide {
  grid-column: 1 / -1;
}

.info-label {
  color: var(--text-tertiary);
  font-size: var(--font-xs);
  font-weight: var(--weight-regular);
}

.info-value {
  margin-top: 6rpx;
  color: var(--text-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  line-height: 1.35;
  word-break: break-all;
}

.shelf-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #efece4;
}

.shelf-link-text {
  min-width: 0;
  overflow: hidden;
  color: #27594f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.shelf-link-arrow {
  flex: none;
  color: #27594f;
  font-size: 38rpx;
  font-weight: 300;
}

.section {
  margin: 30rpx 20rpx 0;
}

.section-title {
  margin-bottom: 16rpx;
  color: #1f2328;
  font-size: 31rpx;
  font-weight: 700;
}

.description {
  padding: 22rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  color: #4b4945;
  font-size: 26rpx;
  line-height: 1.7;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.case-image {
  width: 100%;
  height: 232rpx;
  border-radius: 12rpx;
  background: var(--bg-subtle);
}

.match-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.match-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.match-media {
  width: 100%;
  height: 170rpx;
  padding: 8rpx;
  background: var(--bg-subtle);
  box-sizing: border-box;
}

.match-cover {
  width: 100%;
  height: 100%;
}

.match-name {
  min-height: 62rpx;
  margin: 12rpx 12rpx 0;
  color: #1f2328;
  font-size: 24rpx;
  font-weight: 700;
}

.match-code {
  margin: 6rpx 12rpx 14rpx;
  color: #27594f;
  font-size: 22rpx;
  font-weight: 700;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 110rpx 110rpx 1fr;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 24rpx 22rpx;
  border-top: 1rpx solid #e7e0d6;
  background: rgba(255, 255, 255, 0.96);
}

.action-icon {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 82rpx;
  color: #4b4945;
  font-size: 22rpx;
  line-height: 1.2;
}

.action-icon-symbol {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.action-icon-symbol.poster {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2327594f' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2'/><circle cx='8.5' cy='9' r='1.6' fill='%2327594f'/><path d='M21 16l-5-5-9 9'/></svg>");
}

.action-icon-symbol.plan {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2327594f' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/><path d='M3 6h18'/><path d='M16 10a4 4 0 0 1-8 0'/></svg>");
}

.action-icon-badge {
  position: absolute;
  top: -2rpx;
  right: 4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #b42318;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.action-icon-label {
  margin-top: 2rpx;
  color: #4b4945;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.primary {
  height: 88rpx;
  margin: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6e5d 0%, #27594f 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(30, 142, 115, 0.36);
}

.primary.joined {
  background: #efece4;
  color: #27594f;
  font-size: 28rpx;
  box-shadow: none;
}
