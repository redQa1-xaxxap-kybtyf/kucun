.page {
  min-height: 100vh;
  padding-bottom: 128rpx;
  background: #f4f6f5;
}

.empty {
  padding: 160rpx 32rpx;
  color: #667085;
  font-size: 28rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.gallery-wrap {
  position: relative;
  padding: 22rpx 20rpx 0;
  background: #f4f6f5;
}

.gallery {
  width: 100%;
  height: 520rpx;
  overflow: hidden;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.04);
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #98a2b3;
  font-size: 26rpx;
  font-weight: 900;
}

.image-counter {
  position: absolute;
  right: 42rpx;
  bottom: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(16, 24, 40, 0.72);
  color: #fff;
  font-size: 23rpx;
  font-weight: 900;
}

.thumb-panel {
  margin-top: 14rpx;
}

.thumb-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 22rpx 4rpx;
}

.thumb-image {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border: 4rpx solid transparent;
  border-radius: 8rpx;
  background: #f4f6f5;
  box-sizing: border-box;
}

.thumb-image.active {
  border-color: #1f5a50;
}

.info-card {
  margin: 18rpx 20rpx 0;
  padding: 24rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.035);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  background: #edf6f3;
  color: #1f5a50;
  font-size: 22rpx;
  font-weight: 900;
}

.package-tag {
  background: #f4f1e8;
  color: #7a4d12;
}

.product-code-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  color: #101828;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.24;
}

.code-label {
  flex: none;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #edf6f3;
  color: #1f5a50;
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial,
    sans-serif;
  font-size: 20rpx;
  font-weight: 900;
}

.code-value {
  min-width: 0;
  word-break: break-all;
}

.copy-hint {
  flex: none;
  padding: 5rpx 10rpx;
  border: 1rpx solid #cfe3dd;
  border-radius: 8rpx;
  color: #1f5a50;
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial,
    sans-serif;
  font-size: 20rpx;
  font-weight: 900;
}

.product-name-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #1f5a50;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
}

.name-label {
  flex: none;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: #edf6f3;
  color: #1f5a50;
  font-size: 20rpx;
  line-height: 1.35;
}

.name-value {
  min-width: 0;
  word-break: break-all;
}

.info-section-title {
  margin-top: 22rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 900;
}

.product-info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.info-item {
  min-width: 0;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f7f9f8;
}

.info-item.wide {
  grid-column: 1 / -1;
}

.info-label {
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.info-value {
  margin-top: 8rpx;
  color: #101828;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.shelf-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  background: #edf6f3;
}

.shelf-link-text {
  min-width: 0;
  overflow: hidden;
  color: #1f5a50;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.shelf-link-arrow {
  flex: none;
  color: #1f5a50;
  font-size: 38rpx;
  font-weight: 300;
}

.section {
  margin: 30rpx 20rpx 0;
}

.section-title {
  margin-bottom: 16rpx;
  color: #101828;
  font-size: 31rpx;
  font-weight: 900;
}

.description {
  padding: 22rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  background: #fff;
  color: #475467;
  font-size: 26rpx;
  line-height: 1.7;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.case-image {
  width: 100%;
  height: 232rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
}

.match-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.match-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  background: #fff;
}

.match-media {
  width: 100%;
  height: 170rpx;
  padding: 8rpx;
  background: #f4f6f5;
  box-sizing: border-box;
}

.match-cover {
  width: 100%;
  height: 100%;
}

.match-name {
  min-height: 62rpx;
  margin: 12rpx 12rpx 0;
  color: #101828;
  font-size: 24rpx;
  font-weight: 900;
}

.match-code {
  margin: 6rpx 12rpx 14rpx;
  color: #1f5a50;
  font-size: 22rpx;
  font-weight: 900;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 176rpx 128rpx 1fr;
  gap: 14rpx;
  padding: 18rpx 20rpx 22rpx;
  border-top: 1rpx solid #dbe4e0;
  background: rgba(255, 255, 255, 0.96);
}

.secondary,
.primary {
  height: 82rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.secondary {
  border: 1rpx solid #dbe4e0;
  background: #fff;
  color: #1f5a50;
}

.primary {
  background: #1f5a50;
  color: #fff;
}
