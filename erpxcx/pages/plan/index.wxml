<view class="page">
  <view class="summary">
    <view>
      <view class="title">报货计划</view>
      <view class="subtitle">{{hasItems ? summaryText : '还没有选择产品'}}</view>
      <view wx:if="{{hasItems && weightNote}}" class="summary-note">{{weightNote}}</view>
    </view>
    <button wx:if="{{hasItems}}" class="clear-btn" bindtap="onClearTap">清空</button>
  </view>

  <view wx:if="{{!hasItems}}" class="empty">
    <view class="empty-title">暂无产品</view>
    <view class="empty-text">从产品列表或详情页加入报货计划。</view>
    <button class="home-btn" bindtap="onBackHomeTap">去选产品</button>
  </view>

  <view wx:else class="plan-list">
    <view
      wx:for="{{planItems}}"
      wx:key="id"
      class="plan-card"
    >
      <view class="card-main">
        <image wx:if="{{item.thumbnailUrl}}" class="cover" src="{{item.thumbnailUrl}}" mode="aspectFit" bindtap="onProductTap" data-id="{{item.id}}" />
        <view wx:else class="cover fallback" bindtap="onProductTap" data-id="{{item.id}}">暂无图片</view>
        <view class="info">
          <view class="code line-clamp-1" bindtap="onProductTap" data-id="{{item.id}}">{{item.code}}</view>
          <view class="name">{{item.name}}</view>
          <view class="meta line-clamp-1">{{item.specification || '未填写规格'}}</view>
          <view wx:if="{{item.packageText}}" class="meta line-clamp-1">包装 {{item.packageText}}</view>
          <view wx:if="{{item.weightText}}" class="meta line-clamp-1">重量 {{item.weightText}}</view>
        </view>
      </view>

      <view class="edit-row">
        <view wx:if="{{item.canSwitchUnit}}" class="unit-switch">
          <view
            class="unit-option {{item.quantityUnit == 'package' ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-unit="package"
            bindtap="onQuantityUnitTap"
          >件</view>
          <view
            class="unit-option {{item.quantityUnit == 'sheet' ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-unit="sheet"
            bindtap="onQuantityUnitTap"
          >片</view>
        </view>
        <view wx:else class="unit-pill">{{item.quantityUnitLabel}}</view>
        <view class="quantity-control">
          <view class="step-btn" data-id="{{item.id}}" bindtap="onQuantityMinus">-</view>
          <input
            class="quantity-input"
            type="number"
            value="{{item.quantity}}"
            data-id="{{item.id}}"
            bindblur="onQuantityInput"
          />
          <view class="step-btn" data-id="{{item.id}}" bindtap="onQuantityPlus">+</view>
        </view>
        <button class="remove-btn" data-id="{{item.id}}" bindtap="onRemoveTap">删除</button>
      </view>

      <view
        wx:if="{{item.packageInfoText || item.convertedPiecesText || item.itemWeightText}}"
        class="plan-stats"
      >
        <text wx:if="{{item.packageInfoText}}">{{item.packageInfoText}}</text>
        <text wx:if="{{item.convertedPiecesText}}">{{item.convertedPiecesText}}</text>
        <text wx:if="{{item.itemWeightText}}">重量{{item.itemWeightText}}</text>
      </view>

      <input
        class="remark-input"
        placeholder="备注：如装车顺序、客户要求"
        value="{{item.remark}}"
        data-id="{{item.id}}"
        bindblur="onRemarkInput"
      />
    </view>
  </view>

  <view wx:if="{{hasItems}}" class="bottom-actions safe-bottom">
    <button class="secondary" bindtap="onBackHomeTap">继续选</button>
    <button class="primary" bindtap="onCopyPlanTap">复制报货计划</button>
  </view>
</view>
