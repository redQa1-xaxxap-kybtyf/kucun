.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(230rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #efece4;
  color: #1f2328;
}

button::after {
  border: 0;
}

.summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  color: #1f2328;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 24rpx;
  line-height: 1.35;
}

.summary-note {
  margin-top: 6rpx;
  color: #9a6a11;
  font-size: 22rpx;
  line-height: 1.35;
}

.clear-btn {
  width: 104rpx;
  height: 64rpx;
  flex: none;
  border-radius: var(--radius-sm);
  background: var(--danger-50);
  color: var(--danger-500);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  line-height: 64rpx;
}

.empty {
  margin-top: 140rpx;
  text-align: center;
}

.empty-art {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 28rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' fill='none' stroke='%2327594f' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M30 38L24 50v52a6 6 0 0 0 6 6h60a6 6 0 0 0 6-6V50l-6-12z' fill='%23f8f6f1'/><path d='M24 50h72'/><path d='M44 38h32' stroke='%23b68a45'/><path d='M76 62a16 16 0 0 1-32 0'/><circle cx='84' cy='34' r='10' fill='%23b68a45' stroke='none'/><path d='M80 34l3 3 5-6' stroke='white' stroke-width='2.4'/></svg>");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.empty-title {
  color: #1f2328;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 12rpx;
  color: #73716d;
  font-size: 26rpx;
  line-height: 1.5;
}

.home-btn {
  width: 280rpx;
  height: 88rpx;
  margin: 32rpx auto 0;
  border-radius: 999rpx;
  background: #27594f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-shadow: 0 8rpx 24rpx rgba(39, 89, 79, 0.22);
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
  padding-bottom: 20rpx;
}

.plan-card {
  padding: 18rpx;
  border-radius: 10rpx;
  background: #fff;
  box-sizing: border-box;
}

.card-main {
  display: flex;
  gap: 16rpx;
}

.cover {
  width: 148rpx;
  height: 148rpx;
  flex: none;
  border-radius: 12rpx;
  background: #efece4;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a8a195;
  font-size: 23rpx;
  text-align: center;
}

.info {
  flex: 1;
  min-width: 0;
}

.code {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.25;
}

.name {
  margin-top: 8rpx;
  color: #526273;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.meta {
  margin-top: 8rpx;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.3;
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}

.unit-switch {
  display: flex;
  width: 128rpx;
  height: 70rpx;
  flex: none;
  padding: 4rpx;
  border-radius: 12rpx;
  background: #efece4;
  box-sizing: border-box;
}

.unit-option {
  width: 60rpx;
  height: 62rpx;
  border-radius: 6rpx;
  color: #526273;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
}

.unit-option.active {
  background: #fff;
  color: #27594f;
}

.unit-pill {
  width: 72rpx;
  height: 70rpx;
  flex: none;
  border-radius: 12rpx;
  background: #efece4;
  color: #526273;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 70rpx;
  text-align: center;
}

.quantity-control {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 70rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.step-btn {
  width: 66rpx;
  height: 70rpx;
  flex: none;
  background: #efece4;
  color: #27594f;
  font-size: 32rpx;
  line-height: 70rpx;
  text-align: center;
  box-sizing: border-box;
}

.quantity-input {
  width: 0;
  min-width: 0;
  height: 70rpx;
  flex: 1;
  padding: 0 12rpx;
  color: #1f2328;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 70rpx;
  text-align: center;
  box-sizing: border-box;
}

.remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  min-width: 96rpx;
  height: 70rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-sm);
  background: var(--danger-50);
  color: var(--danger-500);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  line-height: 1;
  box-sizing: border-box;
}

.plan-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
  margin-top: 12rpx;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.35;
}

.remark-input {
  width: 100%;
  height: 66rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 24rpx;
  box-sizing: border-box;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  padding: 16rpx 18rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7e0d6;
  background: #fff;
  box-shadow: 0 -10rpx 28rpx rgba(15, 30, 40, 0.08);
  box-sizing: border-box;
}

.bottom-actions .primary,
.bottom-actions .secondary {
  width: 100%;
  min-width: 0;
  height: 84rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 84rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.bottom-actions .primary {
  background: #27594f;
  color: #fff;
}

.bottom-actions .secondary {
  border: 1rpx solid #e7e0d6;
  background: #fff;
  color: #27594f;
}
