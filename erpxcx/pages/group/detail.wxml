<view class="page">
  <view wx:if="{{loading}}" class="page-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中</view>
  </view>
  <view wx:elif="{{error}}" class="state-block">
    <view class="state-block__title">
      {{errorType === 'missing' ? '这个组合暂时看不到' : '加载失败'}}
    </view>
    <view class="state-block__text">
      <block wx:if="{{errorType === 'missing'}}">
        可能是产品还没有设置花色/品种，或者已经下架。请联系管理员在「商城管理 · 产品展示设置」里把产品归到对应分类。
      </block>
      <block wx:else>{{error}}</block>
    </view>
    <view class="state-block__actions">
      <button class="state-block__primary" bindtap="onBackHomeTap">返回首页</button>
      <button wx:if="{{errorType !== 'missing'}}" class="state-block__ghost" bindtap="onRetryLoadTap">重试</button>
    </view>
  </view>

  <view wx:elif="{{group}}">
    <view class="search-panel">
      <view class="search-bar">
        <view class="search-icon"></view>
        <input
          class="search-input"
          placeholder="搜全部产品 型号 / 名称 / 规格"
          value="{{productSearch}}"
          confirm-type="search"
          bindinput="onProductSearchInput"
          bindconfirm="onProductSearchConfirm"
        />
        <view wx:if="{{productSearch}}" class="search-clear" bindtap="onClearProductSearch">清空</view>
      </view>
    </view>

    <view class="group-head">
      <view class="list-head">
        <view class="list-title line-clamp-1">{{group.title || group.componentType.label}}</view>
        <view class="list-count">{{listCountText}}</view>
      </view>

      <view class="related-strip" wx:if="{{group.relatedGroups.length > 0}}">
        <view class="related-strip-title">同色可选</view>
        <scroll-view class="related-scroll" scroll-x enhanced>
          <view class="related-row">
            <view
              wx:for="{{group.relatedGroups}}"
              wx:key="id"
              class="related-chip"
              data-id="{{item.id}}"
              bindtap="onRelatedGroupTap"
            >
              <text class="related-name">{{item.componentType.label}}</text>
              <text class="related-count">{{item.productCount}}款</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="section">
      <view wx:if="{{visibleProducts.length == 0}}" class="empty-card">
        <view class="empty-title">暂无产品</view>
      </view>
      <view wx:else class="product-grid">
        <view
          wx:for="{{visibleProducts}}"
          wx:key="id"
          class="product-card"
          data-id="{{item.id}}"
          bindtap="onProductTap"
          bindlongpress="onProductLongpress"
        >
          <view class="product-media">
            <image
              wx:if="{{item.thumbnailUrl}}"
              class="product-image"
              src="{{item.thumbnailUrl}}"
              mode="aspectFit"
              lazy-load
            />
            <view wx:else class="product-image fallback">暂无图片</view>
            <view
              class="plan-action {{item.inPlan ? 'joined' : ''}}"
              data-id="{{item.id}}"
              catchtap="onAddPlanTap"
            >
              <text class="plan-action-icon">{{item.inPlan ? '✓' : '+'}}</text>
              <text>{{item.inPlan ? '已加入' : '加计划'}}</text>
            </view>
          </view>
          <view class="product-info">
            <view class="head-row">
              <view class="code-value">
                <block wx:if="{{item.codeParts && item.codeParts.length > 0}}">
                  <text
                    wx:for="{{item.codeParts}}"
                    wx:for-item="part"
                    wx:key="index"
                    class="{{part.hit ? 'kw-hit' : ''}}"
                  >{{part.text}}</text>
                </block>
                <block wx:else>{{item.code}}</block>
              </view>
              <view wx:if="{{item.specText || item.specification}}" class="spec-stack">
                <view class="spec-inline">
                  <block wx:if="{{item.specParts && item.specParts.length > 0}}">
                    <text
                      wx:for="{{item.specParts}}"
                      wx:for-item="part"
                      wx:key="index"
                      class="{{part.hit ? 'kw-hit' : ''}}"
                    >{{part.text}}</text>
                  </block>
                  <block wx:else>{{item.specText || item.specification}}</block>
                </view>
              </view>
            </view>
            <view wx:if="{{item.name}}" class="name-line line-clamp-1">
              <block wx:if="{{item.nameParts && item.nameParts.length > 0}}">
                <text
                  wx:for="{{item.nameParts}}"
                  wx:for-item="part"
                  wx:key="index"
                  class="{{part.hit ? 'kw-hit' : ''}}"
                >{{part.text}}</text>
              </block>
              <block wx:else>{{item.name}}</block>
            </view>
            <view wx:if="{{item.stockText && item.stockBadgeClass == 'out'}}" class="stock-note out">
              {{item.stockText}}
            </view>
            <view wx:if="{{item.factTags.length > 0}}" class="product-meta">
              <view wx:if="{{item.factTags.length > 0}}" class="fact-row {{item.factTags.length == 1 ? 'single' : ''}}">
                <view
                  wx:for="{{item.factTags}}"
                  wx:key="label"
                  wx:for-item="fact"
                  class="fact-item"
                >
                  <text class="fact-label">{{fact.label}}</text>
                  <text class="fact-value">{{fact.value}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{visibleProducts.length > 0 && (loadMoreText || loadingMoreProducts)}}" class="load-more">
        {{loadingMoreProducts ? '正在加载...' : loadMoreText}}
      </view>
    </view>

    <view class="plan-entry" bindtap="onPlanTap">
      <view class="plan-entry-icon"></view>
      <text class="plan-entry-text">报货</text>
      <text wx:if="{{planCount > 0}}" class="plan-count">{{planCount}}</text>
    </view>
  </view>
</view>
