.page {
  min-height: 100vh;
  padding: 0 0 48rpx;
  box-sizing: border-box;
  background: #f3f5f6;
  color: #1f2d3d;
}

button::after {
  border: 0;
}

.empty {
  padding: 160rpx 32rpx;
  color: #6b7785;
  font-size: 28rpx;
  text-align: center;
}

.empty.small {
  padding: 80rpx 32rpx;
}

.error {
  color: #b42318;
}

.search-panel {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 18rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #e7ebee;
  background: #fff;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 22rpx 0 30rpx;
  border-radius: 999rpx;
  background: #f3f6f8;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: #1f2d3d;
  font-size: 27rpx;
}

.search-clear {
  flex: none;
  height: 44rpx;
  margin-right: 14rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #e6ecef;
  color: #6b7785;
  font-size: 21rpx;
  line-height: 44rpx;
}

.search-icon {
  position: relative;
  flex: none;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #7a858f;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 15rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #7a858f;
  content: '';
  transform: rotate(45deg);
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 28rpx 0;
  box-sizing: border-box;
}

.list-title {
  min-width: 0;
  color: #1f2d3d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.list-count {
  flex: none;
  color: #6b7785;
  font-size: 23rpx;
  line-height: 1.2;
}

.section {
  padding: 20rpx 28rpx 0;
  box-sizing: border-box;
}

.related-strip {
  margin: 16rpx 0 0;
  padding: 0 0 0 28rpx;
  box-sizing: border-box;
}

.related-strip-title {
  color: #526273;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.25;
}

.related-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.related-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 28rpx;
}

.related-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d7e6e1;
  border-radius: 8rpx;
  background: #eef8f4;
  box-sizing: border-box;
}

.related-name {
  color: #1f5a50;
  font-size: 24rpx;
  font-weight: 700;
}

.related-count {
  color: #6b7785;
  font-size: 21rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 12rpx;
}

.product-card {
  min-width: 0;
  overflow: hidden;
  border-radius: 10rpx;
  background: #fff;
  box-sizing: border-box;
}

.product-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  overflow: hidden;
  background: #9dafad;
}

.product-image {
  width: 100%;
  height: 100%;
}

.share-tip {
  position: absolute;
  right: 0;
  bottom: 0;
  height: 40rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 8rpx 0 0 0;
  background: rgba(27, 38, 48, 0.82);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.plan-add {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 40rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 0 8rpx 0 0;
  background: rgba(31, 90, 80, 0.9);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b97a1;
  font-size: 24rpx;
  text-align: center;
}

.product-info {
  min-height: 250rpx;
  padding: 20rpx 18rpx 18rpx;
  box-sizing: border-box;
}

.model-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.model-label {
  flex: none;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 5rpx;
  background: #eef8f4;
  color: #1f5a50;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.product-code {
  flex: 1;
  min-width: 0;
  color: #1f2d3d;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.25;
}

.product-name {
  margin-top: 12rpx;
  color: #526273;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.title-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.product-spec {
  min-width: 0;
  color: #66758b;
  font-size: 23rpx;
  line-height: 1.25;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 42rpx;
  margin-top: 14rpx;
}

.stock-tag {
  height: 38rpx;
  padding: 0 10rpx;
  border-radius: 5rpx;
  background: #d9f7df;
  color: #18733d;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 38rpx;
  box-sizing: border-box;
}

.fact-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 30rpx;
  margin-top: 14rpx;
  color: #526273;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.plan-fab {
  position: fixed;
  right: 28rpx;
  bottom: 34rpx;
  z-index: 10;
  min-width: 166rpx;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #1f5a50;
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 70rpx;
  box-sizing: border-box;
}
