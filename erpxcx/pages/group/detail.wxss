.page {
  min-height: 100vh;
  padding-bottom: 128rpx;
  background: #f8f6f1;
}

.empty {
  padding: 160rpx 32rpx;
  color: #8a8175;
  font-size: 28rpx;
  text-align: center;
}

.error {
  color: #9a3412;
}

.hero {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background: #e7e0d6;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a9388;
  font-size: 26rpx;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.58));
}

.hero-content {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 34rpx;
  color: #fff;
}

.hero-tag {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  opacity: 0.88;
}

.hero-shelf-link {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #27594f;
  font-size: 24rpx;
  font-weight: 900;
}

.share-btn {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #27594f;
  font-size: 26rpx;
  font-weight: 800;
}

.section {
  margin: 22rpx;
}

.section-title {
  margin: 28rpx 2rpx 16rpx;
  color: #1f2328;
  font-size: 32rpx;
  font-weight: 900;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-head .section-title {
  margin-bottom: 16rpx;
}

.section-count {
  color: #8a8175;
  font-size: 24rpx;
  font-weight: 800;
}

.product-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 22rpx;
  background: #fff;
}

.product-cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: #efe8dc;
}

.product-body {
  flex: 1;
  min-width: 0;
}

.product-name {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 800;
}

.product-code {
  margin-top: 8rpx;
  color: #b68a45;
  font-size: 24rpx;
  font-weight: 800;
}

.product-spec {
  margin-top: 8rpx;
  color: #73716d;
  font-size: 23rpx;
}

.product-extra {
  margin-top: 8rpx;
  color: #8a8175;
  font-size: 22rpx;
  font-weight: 700;
}

.match-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.match-card {
  min-width: 0;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #fff;
}

.match-cover {
  width: 100%;
  height: 168rpx;
  border-radius: 16rpx;
  background: #efe8dc;
}

.match-name {
  margin-top: 12rpx;
  color: #1f2328;
  font-size: 24rpx;
  font-weight: 800;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 22rpx 22rpx;
  border-top: 1rpx solid #eee7dd;
  background: rgba(248, 246, 241, 0.96);
}

.primary {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.primary {
  background: #27594f;
  color: #fff;
}
