.page {
  min-height: 100vh;
  padding: 0 0 132rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

button::after {
  border: 0;
}

.state-block {
  margin: 64rpx 24rpx 0;
  padding: 48rpx 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 40, 0.06);
  text-align: center;
}

.state-block__title {
  color: #1f2328;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.32;
}

.state-block__text {
  margin-top: 16rpx;
  color: #73716d;
  font-size: 26rpx;
  line-height: 1.55;
  text-align: left;
}

.state-block__actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.state-block__primary,
.state-block__ghost {
  height: 84rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.state-block__primary {
  background: #27594f;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(30, 142, 115, 0.22);
}

.state-block__ghost {
  border: 1rpx solid #e7e0d6;
  background: #ffffff;
  color: #4b4945;
}

.search-panel {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 16rpx 24rpx 14rpx;
  background: #f8f6f1;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(15, 30, 40, 0.05);
  box-sizing: border-box;
}

.search-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #a8a195;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #a8a195;
  content: '';
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #1f2328;
  font-size: 27rpx;
}

.search-clear {
  flex: none;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #efece4;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.2;
}

.group-head {
  margin: 6rpx 24rpx 0;
  padding: 8rpx 0 2rpx;
  box-sizing: border-box;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.list-title {
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.3;
}

.list-count {
  display: inline-flex;
  align-items: center;
  flex: none;
  height: 34rpx;
  color: #8a8376;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.list-count::before {
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: #d2c8b4;
  content: '';
}

.related-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-top: 14rpx;
  box-sizing: border-box;
}

.related-strip-title {
  flex: none;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #ebe6dc;
  color: var(--text-secondary);
  font-size: 21rpx;
  font-weight: var(--weight-semibold);
  line-height: 36rpx;
}

.related-scroll {
  flex: 1;
  min-width: 0;
  width: 0;
  white-space: nowrap;
}

.related-row {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 2rpx;
}

.related-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border: 1rpx solid #eee7dc;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 10rpx rgba(39, 89, 79, 0.05);
  box-sizing: border-box;
}

.related-name {
  color: #27594f;
  font-size: 24rpx;
  font-weight: 700;
}

.related-count {
  color: #a09a8a;
  font-size: 22rpx;
}

.section {
  padding: 22rpx 24rpx 0;
  box-sizing: border-box;
}

.empty-card {
  padding: 96rpx 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #73716d;
  font-size: 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  color: #4b4945;
  font-weight: 600;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 40, 0.06);
  box-sizing: border-box;
}

.product-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  overflow: hidden;
  background: var(--bg-subtle);
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-image.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-disabled);
  font-size: 26rpx;
  background: var(--bg-subtle);
}

.plan-action {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  height: 46rpx;
  min-width: 104rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-sm);
  color: var(--gold-600);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  line-height: 46rpx;
  box-sizing: border-box;
}

.plan-action.joined {
  background: var(--brand-100);
  color: var(--brand-700);
}

.plan-action-icon {
  font-size: 27rpx;
  line-height: 1;
}

.product-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 154rpx;
  padding: 16rpx 18rpx 18rpx;
  box-sizing: border-box;
}

.head-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.code-value {
  flex: 1 1 auto;
  min-width: 0;
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.25;
  word-break: break-all;
}

.spec-stack {
  flex: 0 0 auto;
  max-width: 52%;
  text-align: right;
}

.spec-inline {
  min-width: 0;
  overflow: visible;
  color: #73716d;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
  text-overflow: clip;
  white-space: nowrap;
}

.name-line {
  margin-top: 8rpx;
  color: #4b4945;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
}

.product-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  width: 100%;
  margin-top: 10rpx;
  box-sizing: border-box;
}

.stock-note {
  margin-top: 7rpx;
  color: #b84a3d;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.stock-note.out {
  font-weight: 600;
}

.fact-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 8rpx;
  width: 100%;
  min-width: 0;
}

.fact-row.single {
  grid-template-columns: minmax(0, 1fr);
}

.fact-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
  max-width: 100%;
  min-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #f7f3ea;
  box-sizing: border-box;
}

.fact-label {
  flex: none;
  color: #a09a8a;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.fact-value {
  min-width: 0;
  color: #4b4945;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 34rpx;
  white-space: nowrap;
}

.kw-hit {
  color: #b42318;
  font-weight: 700;
}

.load-more {
  padding: 26rpx 0 8rpx;
  color: var(--text-tertiary);
  font-size: var(--font-sm);
  line-height: 1.35;
  text-align: center;
}

.plan-entry {
  position: fixed;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  width: 126rpx;
  height: 70rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-500);
  color: var(--text-on-brand);
  box-shadow: var(--shadow-brand);
  box-sizing: border-box;
}

.plan-entry-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 30rpx 30rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/><path d='M3 6h18'/><path d='M16 10a4 4 0 0 1-8 0'/></svg>");
}

.plan-entry-text {
  color: var(--text-on-brand);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  line-height: 1;
  white-space: nowrap;
}

.plan-count {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: var(--gold-500);
  color: var(--text-on-brand);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  line-height: 32rpx;
  box-sizing: border-box;
}
