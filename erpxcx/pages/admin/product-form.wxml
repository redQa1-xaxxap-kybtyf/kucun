<view class="page">
  <view class="header">
    <view>
      <view class="eyebrow">产品维护</view>
      <view class="title">{{isEdit ? '编辑产品' : '新增产品'}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载...</view>

  <view wx:else class="form-card">
    <view class="field">
      <view class="label">产品编码</view>
      <input
        class="input"
        placeholder="如 YSB-RMZ-001"
        value="{{form.code}}"
        data-field="code"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="label">产品名称</view>
      <input
        class="input"
        placeholder="如 雅士白罗马柱"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="label">规格</view>
      <input
        class="input"
        placeholder="如 300x600"
        value="{{form.specification}}"
        data-field="specification"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="label">分类</view>
      <picker
        mode="selector"
        range="{{categories}}"
        range-key="name"
        value="{{categoryIndex}}"
        bindchange="onCategoryChange"
      >
        <view class="picker-value {{categoryIndex >= 0 ? '' : 'placeholder'}}">
          {{selectedCategoryName}}
        </view>
      </picker>
    </view>

    <view class="field">
      <view class="label">产品封面</view>
      <view class="image-uploader">
        <image wx:if="{{form.thumbnailUrl}}" class="cover-preview" src="{{form.thumbnailUrl}}" mode="aspectFill" />
        <view wx:else class="cover-preview placeholder">封面</view>
        <view class="upload-side">
          <button
            class="upload-btn"
            loading="{{uploadingKind == 'thumbnail'}}"
            disabled="{{isUploading}}"
            bindtap="onUploadThumbnail"
          >
            上传封面
          </button>
          <input
            class="url-input"
            placeholder="也可粘贴图片地址"
            value="{{form.thumbnailUrl}}"
            data-field="thumbnailUrl"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

    <view class="field">
      <view class="section-head">
        <view class="label">产品主图</view>
        <button
          class="small-btn"
          loading="{{uploadingKind == 'main'}}"
          disabled="{{isUploading}}"
          bindtap="onUploadMainImage"
        >
          添加
        </button>
      </view>
      <view wx:if="{{mainImages.length == 0}}" class="image-empty">未添加主图</view>
      <view wx:else class="image-grid">
        <view wx:for="{{mainImages}}" wx:key="url" class="image-item">
          <image class="image-thumb" src="{{item.url}}" mode="aspectFill" />
          <button
            class="image-remove"
            data-type="main"
            data-index="{{index}}"
            catchtap="onRemoveImage"
          >
            删除
          </button>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="section-head">
        <view class="label">效果案例</view>
        <button
          class="small-btn"
          loading="{{uploadingKind == 'effect'}}"
          disabled="{{isUploading}}"
          bindtap="onUploadEffectImage"
        >
          添加
        </button>
      </view>
      <view wx:if="{{effectImages.length == 0}}" class="image-empty">未添加效果案例</view>
      <view wx:else class="image-grid">
        <view wx:for="{{effectImages}}" wx:key="url" class="image-item">
          <image class="image-thumb" src="{{item.url}}" mode="aspectFill" />
          <button
            class="image-remove"
            data-type="effect"
            data-index="{{index}}"
            catchtap="onRemoveImage"
          >
            删除
          </button>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="label">备注</view>
      <textarea
        class="textarea"
        placeholder="可填写花色、用途或注意事项"
        value="{{form.description}}"
        data-field="description"
        bindinput="onInput"
      />
    </view>

    <view class="status-row">
      <view>
        <view class="label">前台展示</view>
        <view class="hint">{{form.status == 'active' ? '正常展示' : '已下架'}}</view>
      </view>
      <switch checked="{{form.status == 'active'}}" color="#27594f" bindchange="onStatusChange" />
    </view>

    <button
      class="submit"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="onSubmit"
    >
      保存
    </button>
  </view>
</view>
