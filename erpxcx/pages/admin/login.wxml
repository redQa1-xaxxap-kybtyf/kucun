<view class="page">
  <view class="login-head">
    <view class="brand-title">外墙罗马柱瓷砖</view>
    <view class="title">管理员登录</view>
    <view class="desc">用于库存、开单、收款和小程序资料维护。</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">账号</view>
      <input class="input" placeholder="请输入登录账号" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="field">
      <view class="label">密码</view>
      <input
        class="input"
        placeholder="请输入登录密码"
        password
        value="{{password}}"
        bindinput="onPasswordInput"
        confirm-type="done"
        bindconfirm="onSubmit"
      />
    </view>
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">登录</button>
    <button class="plain-btn" bindtap="onHomeTap">返回首页</button>
  </view>
</view>
