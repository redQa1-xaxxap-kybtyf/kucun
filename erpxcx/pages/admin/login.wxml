<view class="page">
  <view class="card">
    <view class="title">管理员工作台</view>
    <view class="desc">登录后可快速查库存，后续接入开销售单、收付款和产品维护。</view>
    <input class="input" placeholder="账号" value="{{username}}" bindinput="onUsernameInput" />
    <input class="input" placeholder="密码" password value="{{password}}" bindinput="onPasswordInput" />
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">登录</button>
  </view>
</view>
