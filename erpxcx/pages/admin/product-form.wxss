.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

.header {
  padding: 8rpx 2rpx 22rpx;
}

.eyebrow {
  color: #73716d;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 38rpx;
  font-weight: 600;
}

.empty {
  padding: 180rpx 20rpx;
  color: #73716d;
  font-size: 27rpx;
  text-align: center;
}

.load-error {
  margin-top: 28rpx;
  padding: 36rpx 28rpx;
  border: 1rpx solid #f3b8a6;
  border-radius: 12rpx;
  background: #fff4ef;
  text-align: center;
}

.load-error-title {
  color: #b42318;
  font-size: 30rpx;
  font-weight: 700;
}

.load-error-text {
  margin-top: 14rpx;
  color: #7a2e1f;
  font-size: 24rpx;
  line-height: 1.45;
}

.load-error-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.retry-btn,
.back-btn {
  height: 74rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 74rpx;
}

.retry-btn {
  background: #b42318;
  color: #fff;
}

.back-btn {
  border: 1rpx solid #f3b8a6;
  background: #fff;
  color: #b42318;
}

.form-stack {
  padding-bottom: 34rpx;
}

.section {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.section-title {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.3;
}

.section-caption {
  margin-top: 4rpx;
  color: #73716d;
  font-size: 23rpx;
  line-height: 1.35;
}

.field {
  margin-bottom: 22rpx;
}

.field.last {
  margin-bottom: 0;
}

.label {
  margin-bottom: 12rpx;
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 600;
}

.input,
.picker-value,
.readonly-value {
  height: 78rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 27rpx;
  line-height: 78rpx;
  box-sizing: border-box;
}

.picker-value {
  position: relative;
  padding-right: 58rpx;
}

.picker-value::after {
  position: absolute;
  right: 22rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #a8a195;
  border-bottom: 2rpx solid #a8a195;
  content: '';
  transform: translateY(-65%) rotate(45deg);
}

.picker-value.placeholder {
  color: #a8a195;
}

.select-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 78rpx;
  padding: 0 18rpx 0 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  box-sizing: border-box;
}

.select-value.disabled {
  opacity: 0.55;
}

.select-text {
  flex: 1;
  overflow: hidden;
  color: #1f2328;
  font-size: 27rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-value.placeholder .select-text {
  color: #a8a195;
}

.select-action {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #e6e9dd;
  color: #27594f;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.2;
}

.readonly-value {
  overflow: hidden;
  color: #4b4945;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-readonly,
.category-picker {
  height: auto;
  min-height: 78rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  line-height: 1.35;
  white-space: normal;
  word-break: break-all;
}

.readonly-block {
  min-height: 92rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #4b4945;
  font-size: 27rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.status-readonly {
  flex: none;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #e6e9dd;
  color: #27594f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.textarea {
  width: 100%;
  height: 150rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 27rpx;
  box-sizing: border-box;
}

.switch-row,
.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.switch-row {
  margin-bottom: 20rpx;
}

.status-row {
  padding-top: 2rpx;
}

.hint {
  color: #73716d;
  font-size: 24rpx;
  line-height: 1.4;
}

.field-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
}

.catalog-preview {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  position: relative;
  margin-bottom: 22rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #e6e9dd;
}

.preview-cell {
  min-width: 0;
}

.preview-label {
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.3;
}

.preview-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: #1a4035;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-tag {
  grid-column: 1 / span 2;
  justify-self: start;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: #c8d6cf;
  color: #27594f;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.selector-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 24, 40, 0.36);
}

.selector-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 14rpx 22rpx 28rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 12rpx;
  background: #e7e0d6;
}

.selector-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.selector-title {
  color: #1f2328;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.3;
}

.selector-close {
  flex: none;
  color: #27594f;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
}

.selector-search {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 27rpx;
  box-sizing: border-box;
}

.selector-list {
  height: 56vh;
  margin-top: 16rpx;
}

.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 82rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #efece4;
  box-sizing: border-box;
}

.selector-row.selected {
  background: #e6e9dd;
}

.selector-row-main {
  flex: 1;
  min-width: 0;
}

.selector-row-title {
  overflow: hidden;
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-row-subtitle {
  margin-top: 4rpx;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.3;
}

.selector-check {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: #c8d6cf;
  color: #27594f;
  font-size: 22rpx;
  font-weight: 600;
}

.selector-empty {
  padding: 80rpx 20rpx;
  color: #73716d;
  font-size: 26rpx;
  text-align: center;
}

.image-uploader {
  display: flex;
  gap: 18rpx;
}

.cover-preview {
  width: 156rpx;
  height: 156rpx;
  flex: none;
  border-radius: 12rpx;
  background: #efece4;
}

.cover-preview.placeholder {
  color: #a8a195;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 156rpx;
  text-align: center;
}

.upload-side {
  flex: 1;
  min-width: 0;
}

.readonly-side {
  display: flex;
  align-items: center;
  color: #73716d;
  font-size: 24rpx;
  line-height: 1.35;
}

.auto-btn,
.upload-btn,
.small-btn {
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.auto-btn {
  width: 150rpx;
  flex: none;
  background: #e6e9dd;
  color: #27594f;
}

.upload-btn,
.small-btn {
  background: #27594f;
  color: #fff;
}

.url-input {
  height: 70rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 24rpx;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-head .label {
  margin-bottom: 0;
}

.small-btn {
  width: 116rpx;
  flex: none;
}

.image-empty {
  margin-top: 14rpx;
  padding: 30rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #73716d;
  font-size: 24rpx;
  text-align: center;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  background: #efece4;
}

.image-thumb {
  display: block;
  width: 100%;
  height: 154rpx;
}

.image-remove {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: rgba(16, 24, 40, 0.72);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.submit {
  height: 84rpx;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.auto-btn::after,
.upload-btn::after,
.small-btn::after,
.image-remove::after,
.submit::after,
.retry-btn::after,
.back-btn::after {
  border: 0;
}
