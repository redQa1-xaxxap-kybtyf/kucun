.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f8f6f1;
}

.header {
  padding: 8rpx 2rpx 22rpx;
}

.eyebrow {
  color: #8a8175;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 42rpx;
  font-weight: 900;
}

.empty {
  padding: 120rpx 20rpx;
  color: #8a8175;
  font-size: 27rpx;
  text-align: center;
}

.form-card {
  padding: 24rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 24rpx;
  background: #fff;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 900;
}

.input,
.picker-value {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 27rpx;
  line-height: 76rpx;
  box-sizing: border-box;
}

.picker-value.placeholder {
  color: #9b948b;
}

.textarea {
  width: 100%;
  height: 150rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 27rpx;
  box-sizing: border-box;
}

.image-uploader {
  display: flex;
  gap: 18rpx;
}

.cover-preview {
  width: 156rpx;
  height: 156rpx;
  flex: none;
  border-radius: 20rpx;
  background: #f1ece4;
}

.cover-preview.placeholder {
  color: #b68a45;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 156rpx;
  text-align: center;
}

.upload-side {
  flex: 1;
  min-width: 0;
}

.upload-btn,
.small-btn {
  height: 64rpx;
  border-radius: 16rpx;
  background: #27594f;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
}

.url-input {
  height: 70rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 24rpx;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-head .label {
  margin-bottom: 0;
}

.small-btn {
  width: 116rpx;
  flex: none;
}

.image-empty {
  margin-top: 14rpx;
  padding: 30rpx 20rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #8a8175;
  font-size: 24rpx;
  text-align: center;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f1ece4;
}

.image-thumb {
  display: block;
  width: 100%;
  height: 154rpx;
}

.image-remove {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(31, 35, 40, 0.72);
  color: #fff;
  font-size: 21rpx;
  font-weight: 800;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0 26rpx;
}

.hint {
  color: #8a8175;
  font-size: 24rpx;
}

.submit {
  height: 82rpx;
  border-radius: 20rpx;
  background: #27594f;
  color: #fff;
  font-size: 29rpx;
  font-weight: 900;
}
