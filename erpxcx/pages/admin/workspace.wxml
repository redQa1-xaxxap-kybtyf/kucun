<view class="page">
  <view class="header">
    <view class="identity">
      <view class="eyebrow">{{user.name || user.username || '系统管理员'}}</view>
      <view class="title">管理工作台</view>
    </view>
    <view class="desc">库存、开单、收款、产品资料</view>
    <view class="header-actions">
      <view class="text-btn" bindtap="onHomeTap">前台</view>
      <view class="text-btn danger" bindtap="onLogout">退出</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">常用操作</view>
    <view class="quick-grid">
      <view class="quick-card primary" bindtap="onInventoryTap">
        <view class="quick-title">查库存</view>
        <view class="quick-desc">编码、名称、批次</view>
      </view>
      <view class="quick-card" bindtap="onSalesOrderTap">
        <view class="quick-title">开销售单</view>
        <view class="quick-desc">录入客户订单</view>
      </view>
      <view class="quick-card" bindtap="onPaymentTap">
        <view class="quick-title">登记收款</view>
        <view class="quick-desc">订单收款记录</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">资料维护</view>
    <view class="menu-list">
      <view class="menu-row" bindtap="onProductsTap">
        <view class="menu-main">
          <view class="menu-title">产品维护</view>
          <view class="menu-desc">产品资料、图片、规格、上下架</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
      <view class="menu-row" bindtap="onCatalogTap">
        <view class="menu-main">
          <view class="menu-title">小程序展示设置</view>
          <view class="menu-desc">花色、品种、缩略图、展示顺序</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
    </view>
  </view>
</view>
