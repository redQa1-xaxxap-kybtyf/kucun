.page {
  min-height: 100vh;
  padding: 86rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

.login-head {
  margin-bottom: 36rpx;
}

.brand-title {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e6e9dd;
  color: #1a4035;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 18rpx;
  color: #1f2328;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.16;
}

.desc {
  margin-top: 14rpx;
  color: #73716d;
  font-size: 26rpx;
  line-height: 1.5;
}

.card {
  padding: 30rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.045);
}

.field + .field {
  margin-top: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #2c2b28;
  font-size: 24rpx;
  font-weight: 700;
}

.input {
  height: 84rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 28rpx;
  box-sizing: border-box;
}

.primary {
  height: 86rpx;
  margin-top: 30rpx;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 86rpx;
}

.plain-btn {
  height: 74rpx;
  margin-top: 16rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  color: #73716d;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 74rpx;
}
