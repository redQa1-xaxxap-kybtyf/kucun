.page {
  min-height: 100vh;
  padding: 22rpx 20rpx 44rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 22rpx;
}

.eyebrow {
  color: #73716d;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 36rpx;
  font-weight: 600;
}

.desc {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 23rpx;
  line-height: 1.35;
}

.search-card {
  position: sticky;
  top: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(15, 30, 40, 0.05);
}

.search-input {
  flex: 1;
  height: 76rpx;
  color: #1f2328;
  font-size: 26rpx;
}

.search-clear {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #efece4;
  color: #4b4945;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.status-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-tab {
  flex: 1 1 128rpx;
  min-width: 128rpx;
  height: 72rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  color: #4b4945;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.status-tab.active {
  border-color: #27594f;
  background: #e6e9dd;
  color: #27594f;
}

.batch-toolbar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.batch-entry,
.batch-light {
  height: 72rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.batch-entry {
  width: 160rpx;
  background: #27594f;
  color: #fff;
}

.batch-light {
  flex: 1 1 144rpx;
  min-width: 0;
  padding: 0 16rpx;
  border: 1rpx solid #e7e0d6;
  background: #fff;
  color: #4b4945;
}

.batch-light.primary {
  border-color: #27594f;
  background: #e6e9dd;
  color: #1a4035;
}

.batch-light[disabled] {
  opacity: 0.55;
}

.batch-count {
  flex: 1 0 100%;
  color: #27594f;
  font-size: 24rpx;
  font-weight: 700;
}

.batch-progress {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #e6e9dd;
  color: #1a4035;
  font-size: 22rpx;
  font-weight: 600;
}

.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #f3b8a6;
  border-radius: 12rpx;
  background: #fff4ef;
  color: #b42318;
  font-size: 24rpx;
}

.notice-text {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.notice-action {
  width: 112rpx;
  height: 60rpx;
  flex: none;
  margin: 0;
  border-radius: 12rpx;
  background: #b42318;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.empty {
  padding: 120rpx 20rpx;
  color: #73716d;
  font-size: 27rpx;
  text-align: center;
}

.product-list {
  margin-top: 16rpx;
  padding-bottom: 40rpx;
}

.product-list.batching {
  padding-bottom: 420rpx;
}

.product-card {
  margin-bottom: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.display-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.mini-status,
.display-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.mini-status.visible {
  background: #e6e9dd;
  color: #1a4035;
}

.mini-status.unconfigured {
  background: #eef4ff;
  color: #2458b8;
}

.mini-status.hidden,
.mini-status.inactive {
  background: #efece4;
  color: #73716d;
}

.display-badge.configured {
  background: #e6e9dd;
  color: #1a4035;
}

.display-badge.unconfigured {
  background: #fdf3e1;
  color: #9a6a11;
}

.display-badge.hidden,
.display-badge.inactive {
  background: #efece4;
  color: #73716d;
}

.product-card.selected {
  border-color: #27594f;
  background: #f7fbf9;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.select-dot {
  width: 42rpx;
  height: 42rpx;
  flex: none;
  margin-top: 25rpx;
  border: 2rpx solid #d6cdbf;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.select-dot.active {
  border-color: #27594f;
  background: #27594f;
}

.cover {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  border-radius: 12rpx;
  background: #efece4;
}

.cover.fallback {
  color: #a8a195;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 92rpx;
  text-align: center;
}

.main {
  flex: 1;
  min-width: 0;
}

.name {
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.code {
  margin-top: 6rpx;
  color: #2c2b28;
  font-family: monospace;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.25;
}

.spec {
  margin-top: 5rpx;
  color: #73716d;
  font-size: 23rpx;
  line-height: 1.25;
}

.badge {
  flex: none;
  padding: 7rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.badge.off {
  background: #efece4;
  color: #73716d;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.meta-line {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: 6rpx 14rpx;
  min-width: 0;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.35;
}

.action-btn {
  width: 200rpx;
  height: 68rpx;
  flex: none;
  border: 1rpx solid #c8d6cf;
  border-radius: 12rpx;
  background: #e6e9dd;
  color: #27594f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.search-clear::after,
.action-btn::after,
.batch-entry::after,
.batch-light::after,
.batch-save::after,
.notice-action::after {
  border: 0;
}

.list-more {
  padding: 26rpx;
  color: #73716d;
  font-size: 24rpx;
  text-align: center;
}

.batch-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 22rpx 22rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  box-shadow: 0 -8rpx 28rpx rgba(16, 24, 40, 0.14);
  box-sizing: border-box;
}

.batch-panel-title {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 700;
}

.batch-panel-subtitle {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 22rpx;
}

.batch-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.batch-picker,
.batch-visible {
  min-height: 70rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 23rpx;
  box-sizing: border-box;
}

.batch-picker {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.batch-visible {
  grid-column: 1 / 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.batch-save {
  width: 100%;
  height: 72rpx;
  margin: 18rpx 0 0;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
}
