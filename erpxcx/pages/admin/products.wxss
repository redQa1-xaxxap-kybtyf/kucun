.page {
  min-height: 100vh;
  padding: 22rpx 20rpx 44rpx;
  box-sizing: border-box;
  background: #f6f7f6;
  color: #101828;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 22rpx;
}

.eyebrow {
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #101828;
  font-size: 36rpx;
  font-weight: 800;
}

.desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.35;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dfe4e2;
  border-radius: 8rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  height: 76rpx;
  color: #101828;
  font-size: 26rpx;
}

.search-clear {
  height: 52rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #eef2f0;
  color: #475467;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.status-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-tab {
  flex: 1;
  height: 56rpx;
  border: 1rpx solid #dfe4e2;
  border-radius: 8rpx;
  background: #fff;
  color: #475467;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  text-align: center;
}

.status-tab.active {
  border-color: #176b5b;
  background: #eef7f4;
  color: #176b5b;
}

.notice {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #f3b8a6;
  border-radius: 8rpx;
  background: #fff4ef;
  color: #b42318;
  font-size: 24rpx;
}

.empty {
  padding: 120rpx 20rpx;
  color: #667085;
  font-size: 27rpx;
  text-align: center;
}

.product-list {
  margin-top: 16rpx;
  padding-bottom: 40rpx;
}

.product-card {
  margin-bottom: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #e1e6e4;
  border-radius: 8rpx;
  background: #fff;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.cover {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  border-radius: 8rpx;
  background: #eef2f0;
}

.cover.fallback {
  color: #98a2b3;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 92rpx;
  text-align: center;
}

.main {
  flex: 1;
  min-width: 0;
}

.name {
  color: #101828;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.code {
  margin-top: 6rpx;
  color: #344054;
  font-family: monospace;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.25;
}

.spec {
  margin-top: 5rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.25;
}

.badge {
  flex: none;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.badge.off {
  background: #eef2f0;
  color: #667085;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.meta-line {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: 6rpx 14rpx;
  min-width: 0;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.35;
}

.action-btn {
  width: 180rpx;
  height: 54rpx;
  flex: none;
  border: 1rpx solid #cfe3dd;
  border-radius: 8rpx;
  background: #f7fbf9;
  color: #176b5b;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.search-clear::after,
.action-btn::after {
  border: 0;
}

.list-more {
  padding: 26rpx;
  color: #667085;
  font-size: 24rpx;
  text-align: center;
}
