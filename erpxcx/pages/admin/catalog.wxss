.page {
  min-height: 100vh;
  padding: 22rpx 20rpx 72rpx;
  box-sizing: border-box;
  background: #f5f6f5;
  color: #101828;
}

button::after {
  border: 0;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 2rpx 18rpx;
}

.header-copy {
  min-width: 0;
}

.eyebrow {
  color: #667085;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.18;
}

.desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

.preview-btn {
  width: 116rpx;
  height: 60rpx;
  flex: none;
  margin: 0;
  border: 1rpx solid #d8dedb;
  border-radius: 8rpx;
  background: #fff;
  color: #176b5b;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.actions {
  margin-top: 12rpx;
}

.primary,
.secondary {
  width: 100%;
  height: 72rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.primary {
  background: #176b5b;
  color: #fff;
}

.secondary {
  border: 1rpx solid #d9dfdd;
  background: #fff;
  color: #176b5b;
}

.notice {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #f3b8a6;
  border-radius: 8rpx;
  background: #fff4ef;
  color: #b42318;
  font-size: 24rpx;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  padding: 40rpx 20rpx;
  color: #667085;
  font-size: 27rpx;
  text-align: center;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 6rpx;
  margin-top: 16rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  background: #e9eeeb;
}

.tab {
  min-width: 0;
  padding: 14rpx 10rpx 12rpx;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  background: transparent;
  text-align: center;
  box-sizing: border-box;
}

.tab.active {
  border-color: #176b5b;
  background: #fff;
}

.tab-title {
  color: #101828;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.25;
}

.tab-count {
  margin-top: 4rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.2;
}

.panel {
  margin-top: 22rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 0 16rpx;
}

.section-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
}

.section-note {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.35;
}

.section-add {
  width: 150rpx;
  height: 60rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #176b5b;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.blank-state {
  padding: 42rpx 20rpx;
  border: 1rpx solid #e1e6e4;
  border-radius: 8rpx;
  background: #fff;
  color: #667085;
  font-size: 25rpx;
  text-align: center;
}

.category-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 112rpx;
  padding: 16rpx;
  border: 1rpx solid #e1e6e4;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
}

.cover {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 8rpx;
  background: #eef2f0;
}

.fallback {
  color: #98a2b3;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
}

.category-main {
  flex: 1;
  min-width: 0;
}

.category-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.category-title {
  overflow: hidden;
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-chip {
  flex: none;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.category-desc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.dot {
  color: #c2c8c5;
}

.card-side {
  display: flex;
  flex: none;
  align-items: flex-end;
  flex-direction: column;
  gap: 8rpx;
}

.status {
  flex: none;
  min-width: 64rpx;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.status.active {
  background: #eef7f4;
  color: #176b5b;
}

.edit-text {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.2;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.42);
}

.editor-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 18rpx 24rpx 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d0d5dd;
}

.sheet-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 700;
}

.field {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #101828;
  font-size: 25rpx;
  font-weight: 700;
}

.input {
  width: 100%;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  color: #101828;
  font-size: 27rpx;
  box-sizing: border-box;
}

.url-input {
  margin-top: 14rpx;
  font-size: 24rpx;
}

.cover-editor {
  display: flex;
  gap: 16rpx;
}

.cover-preview {
  width: 156rpx;
  height: 156rpx;
  flex: none;
  border-radius: 8rpx;
  background: #eef2f0;
}

.cover-preview.placeholder {
  color: #98a2b3;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 156rpx;
  text-align: center;
}

.cover-actions {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.upload-btn,
.clear-btn {
  height: 68rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.upload-btn {
  background: #176b5b;
  color: #fff;
}

.clear-btn {
  border: 1rpx solid #d9dfdd;
  background: #fff;
  color: #667085;
}

.row-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hint {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 30rpx;
}

.cancel-btn,
.save-btn {
  height: 78rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 78rpx;
}

.cancel-btn {
  border: 1rpx solid #d9dfdd;
  background: #fff;
  color: #667085;
}

.save-btn {
  background: #176b5b;
  color: #fff;
}

.delete-btn {
  width: 100%;
  height: 74rpx;
  margin: 22rpx 0 0;
  border-radius: 8rpx;
  background: #fff1f0;
  color: #b42318;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 74rpx;
}
