<view class="page">
  <view class="header">
    <view>
      <view class="eyebrow">小程序管理</view>
      <view class="title">产品展示设置</view>
      <view class="desc">产品资料在 ERP 维护，这里只设置客户怎么找</view>
    </view>
  </view>

  <view class="search-card">
    <input
      class="search-input"
      placeholder="搜编码、名称、规格"
      value="{{search}}"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <button wx:if="{{search}}" class="search-clear" bindtap="onClearSearch">清空</button>
  </view>

  <view class="status-tabs">
    <view
      wx:for="{{statusTabs}}"
      wx:key="value"
      class="status-tab {{status == item.value ? 'active' : ''}}"
      data-status="{{item.value}}"
      bindtap="onStatusTap"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{loading && products.length == 0}}" class="empty">正在加载产品...</view>
  <view wx:elif="{{products.length == 0}}" class="empty">{{search ? '没有找到相关产品' : '暂无产品'}}</view>

  <view wx:else class="product-list">
    <view wx:for="{{products}}" wx:key="id" class="product-card">
      <view class="card-head">
        <image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="cover fallback">无图</view>
        <view class="main">
          <view class="name line-clamp-1">{{item.name}}</view>
          <view class="code">{{item.code}}</view>
          <view class="spec line-clamp-1">{{item.specification}}</view>
        </view>
        <view wx:if="{{item.status != 'active'}}" class="badge off">
          {{item.statusLabel}}
        </view>
      </view>

      <view class="card-foot">
        <view class="meta-line">
          <text>ERP：{{item.categoryName}}</text>
          <text>{{item.stockText}}</text>
          <text wx:if="{{item.availableText}}">{{item.availableText}}</text>
        </view>
        <button class="action-btn" data-id="{{item.id}}" catchtap="onEditTap">设置客户分类</button>
      </view>
    </view>

    <view wx:if="{{loading}}" class="list-more">正在加载...</view>
    <view wx:elif="{{!hasMore}}" class="list-more">已到底</view>
  </view>
</view>
