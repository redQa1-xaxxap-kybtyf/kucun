.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

.header {
  padding: 8rpx 2rpx 18rpx;
}

.eyebrow {
  color: #73716d;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 40rpx;
  font-weight: 700;
}

.section {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.section-title {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 700;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.total {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  color: #73716d;
  font-size: 24rpx;
  font-weight: 600;
}

.total-money {
  color: #b68a45;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.selected-box {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #e6e9dd;
}

.selected-name {
  color: #27594f;
  font-size: 28rpx;
  font-weight: 700;
}

.selected-meta {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 23rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 74rpx;
  margin-top: 16rpx;
  padding: 0 14rpx 0 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: #1f2328;
  font-size: 26rpx;
}

.search-btn {
  width: 120rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.customer-chip {
  flex: 1 1 220rpx;
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.customer-chip.active {
  border-color: #27594f;
  background: #e6e9dd;
}

.chip-name {
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 700;
}

.chip-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #73716d;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-result {
  margin-top: 14rpx;
}

.product-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e7e0d6;
}

.product-row:last-child {
  border-bottom: 0;
}

.row-thumb {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #efece4;
  overflow: hidden;
}

.row-thumb.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a8a195;
  font-size: 22rpx;
  font-weight: 500;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name,
.item-name {
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.product-code,
.item-code {
  margin-top: 6rpx;
  color: #27594f;
  font-family: monospace;
  font-size: 24rpx;
  font-weight: 700;
}

.product-spec {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 23rpx;
  line-height: 1.3;
}

.product-stock {
  flex: none;
  max-width: 190rpx;
  color: #27594f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: right;
}

.empty {
  margin-top: 16rpx;
  padding: 34rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #73716d;
  font-size: 25rpx;
  text-align: center;
}

.empty.compact {
  padding: 24rpx 18rpx;
}

.item-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
}

.item-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.remove-btn {
  width: 88rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #b42318;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.item-spec {
  margin-top: 10rpx;
  color: #73716d;
  font-size: 23rpx;
}

.item-pack-line {
  margin-top: 6rpx;
  color: #b68a45;
  font-size: 22rpx;
  font-weight: 600;
}

.input-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mini-field {
  min-width: 0;
}

.mini-label {
  margin-bottom: 8rpx;
  color: #73716d;
  font-size: 22rpx;
  font-weight: 600;
}

.mini-input {
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.mini-hint {
  margin-top: 8rpx;
  color: #73716d;
  font-size: 22rpx;
  line-height: 1.35;
}

.subtotal-hint {
  color: #4b4945;
  font-weight: 600;
}

.subtotal-money {
  color: #b68a45;
  font-weight: 700;
  margin-left: 4rpx;
}

.date-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 26rpx;
  font-weight: 600;
}

.remarks {
  width: 100%;
  height: 130rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 26rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7e0d6;
  background: rgba(255, 255, 255, 0.96);
}

.primary,
.secondary {
  height: 82rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.primary {
  background: #27594f;
  color: #fff;
}

.secondary {
  border: 1rpx solid #e7e0d6;
  background: #fff;
  color: #27594f;
}
