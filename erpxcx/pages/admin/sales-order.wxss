.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
  background: #f8f6f1;
}

.header {
  padding: 8rpx 2rpx 18rpx;
}

.eyebrow {
  color: #8a8175;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 42rpx;
  font-weight: 900;
}

.section {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 24rpx;
  background: #fff;
}

.section-title {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 900;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.total {
  color: #b68a45;
  font-size: 28rpx;
  font-weight: 900;
}

.selected-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #edf7f3;
}

.selected-name {
  color: #27594f;
  font-size: 28rpx;
  font-weight: 900;
}

.selected-meta {
  margin-top: 6rpx;
  color: #6b756f;
  font-size: 23rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 74rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: #1f2328;
  font-size: 26rpx;
}

.search-btn {
  width: 112rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #27594f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.chip-list {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  overflow-x: auto;
}

.customer-chip {
  min-width: 190rpx;
  padding: 16rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 18rpx;
  background: #fff;
}

.customer-chip.active {
  border-color: #27594f;
  background: #edf7f3;
}

.chip-name {
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 900;
}

.chip-meta {
  max-width: 220rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8a8175;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-result {
  margin-top: 14rpx;
}

.product-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0e9df;
}

.product-row:last-child {
  border-bottom: 0;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name,
.item-name {
  color: #1f2328;
  font-size: 27rpx;
  font-weight: 900;
}

.product-code,
.item-code {
  margin-top: 6rpx;
  color: #b68a45;
  font-family: monospace;
  font-size: 23rpx;
  font-weight: 900;
}

.product-stock {
  flex: none;
  color: #27594f;
  font-size: 23rpx;
  font-weight: 900;
}

.empty {
  margin-top: 16rpx;
  padding: 36rpx 20rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #8a8175;
  font-size: 25rpx;
  text-align: center;
}

.item-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8f6f1;
}

.item-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.remove-btn {
  width: 92rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #b42318;
  font-size: 22rpx;
  font-weight: 900;
}

.item-spec {
  margin-top: 10rpx;
  color: #8a8175;
  font-size: 23rpx;
}

.input-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.mini-label {
  margin-bottom: 8rpx;
  color: #73716d;
  font-size: 22rpx;
  font-weight: 800;
}

.mini-input {
  height: 66rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #1f2328;
  font-size: 27rpx;
  box-sizing: border-box;
}

.date-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 26rpx;
  font-weight: 800;
}

.remarks {
  width: 100%;
  height: 130rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 26rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee7dd;
  background: rgba(248, 246, 241, 0.96);
}

.primary,
.secondary {
  height: 82rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.primary {
  background: #27594f;
  color: #fff;
}

.secondary {
  background: #fff;
  color: #27594f;
}
