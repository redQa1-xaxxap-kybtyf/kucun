.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
  background: #f4f6f5;
  color: #101828;
}

.header {
  padding: 8rpx 2rpx 18rpx;
}

.eyebrow {
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 6rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 900;
}

.section {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
}

.section-title {
  color: #101828;
  font-size: 29rpx;
  font-weight: 900;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.total {
  color: #176b5b;
  font-size: 28rpx;
  font-weight: 900;
}

.selected-box {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #eaf5f1;
}

.selected-name {
  color: #176b5b;
  font-size: 28rpx;
  font-weight: 900;
}

.selected-meta {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 74rpx;
  margin-top: 16rpx;
  padding: 0 14rpx 0 18rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: #101828;
  font-size: 26rpx;
}

.search-btn {
  width: 104rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #176b5b;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.customer-chip {
  flex: 1 1 220rpx;
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
}

.customer-chip.active {
  border-color: #176b5b;
  background: #eaf5f1;
}

.chip-name {
  color: #101828;
  font-size: 25rpx;
  font-weight: 900;
}

.chip-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #667085;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-result {
  margin-top: 14rpx;
}

.product-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eaecf0;
}

.product-row:last-child {
  border-bottom: 0;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name,
.item-name {
  color: #101828;
  font-size: 27rpx;
  font-weight: 900;
}

.product-code,
.item-code {
  margin-top: 6rpx;
  color: #176b5b;
  font-family: monospace;
  font-size: 23rpx;
  font-weight: 900;
}

.product-stock {
  flex: none;
  color: #176b5b;
  font-size: 23rpx;
  font-weight: 900;
}

.empty {
  margin-top: 16rpx;
  padding: 34rpx 20rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  color: #667085;
  font-size: 25rpx;
  text-align: center;
}

.item-card {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
}

.item-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.remove-btn {
  width: 82rpx;
  height: 50rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #b42318;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 50rpx;
}

.item-spec {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
}

.input-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mini-label {
  margin-bottom: 8rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.mini-input {
  height: 66rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #101828;
  font-size: 27rpx;
  box-sizing: border-box;
}

.date-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  color: #101828;
  font-size: 26rpx;
  font-weight: 800;
}

.remarks {
  width: 100%;
  height: 130rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  color: #101828;
  font-size: 26rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d0d5dd;
  background: rgba(255, 255, 255, 0.96);
}

.primary,
.secondary {
  height: 82rpx;
  border-radius: 8rpx;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.primary {
  background: #176b5b;
  color: #fff;
}

.secondary {
  border: 1rpx solid #d0d5dd;
  background: #fff;
  color: #176b5b;
}
