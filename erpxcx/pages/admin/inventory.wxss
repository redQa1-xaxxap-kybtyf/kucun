.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f8f6f1;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 22rpx;
}

.eyebrow {
  color: #8a8175;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 42rpx;
  font-weight: 900;
}

.scan-btn {
  height: 66rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #27594f;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 20rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  height: 78rpx;
  color: #1f2328;
  font-size: 27rpx;
}

.search-clear {
  color: #b68a45;
  font-size: 24rpx;
  font-weight: 800;
}

.notice {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff3ed;
  color: #9a3412;
  font-size: 24rpx;
}

.empty {
  padding: 120rpx 20rpx;
  color: #8a8175;
  font-size: 27rpx;
  text-align: center;
}

.inventory-list {
  margin-top: 20rpx;
  padding-bottom: 40rpx;
}

.inventory-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 24rpx;
  background: #fff;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name {
  color: #1f2328;
  font-size: 30rpx;
  font-weight: 900;
}

.product-code {
  margin-top: 8rpx;
  color: #b68a45;
  font-family: monospace;
  font-size: 25rpx;
  font-weight: 900;
}

.stock {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.stock.ok {
  background: #e8f5ef;
  color: #27594f;
}

.stock.empty-stock {
  background: #f2eee8;
  color: #8a8175;
}

.spec {
  margin-top: 14rpx;
  color: #73716d;
  font-size: 24rpx;
}

.meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.meta-label,
.quantity-label {
  color: #8a8175;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 800;
}

.quantity-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.quantity-item {
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  text-align: center;
}

.quantity-item.strong {
  background: #edf7f3;
}

.quantity-value {
  color: #1f2328;
  font-size: 34rpx;
  font-weight: 900;
}

.strong .quantity-value {
  color: #27594f;
}
