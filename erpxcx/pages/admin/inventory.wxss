.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

.search-card {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(15, 30, 40, 0.05);
}

.search-input {
  flex: 1;
  height: 78rpx;
  color: #1f2328;
  font-size: 27rpx;
}

.search-clear {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #efece4;
  color: #4b4945;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #f3b8a6;
  border-radius: 12rpx;
  background: #fff4ef;
  color: #b42318;
  font-size: 24rpx;
}

.notice-text {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.notice-action {
  width: 112rpx;
  height: 60rpx;
  flex: none;
  margin: 0;
  border-radius: 12rpx;
  background: #b42318;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.empty {
  padding: 120rpx 20rpx;
  color: #73716d;
  font-size: 27rpx;
  text-align: center;
}

.inventory-list {
  margin-top: 18rpx;
  padding-bottom: 40rpx;
}

.inventory-card {
  margin-bottom: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.card-thumb {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #efece4;
  overflow: hidden;
}

.card-thumb.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a8a195;
  font-size: 22rpx;
  font-weight: 500;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name {
  color: #1f2328;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.product-code {
  margin-top: 8rpx;
  color: #27594f;
  font-family: monospace;
  font-size: 24rpx;
  font-weight: 700;
}

.product-spec {
  margin-top: 8rpx;
  color: #73716d;
  font-size: 24rpx;
  line-height: 1.35;
}

.stock {
  flex: none;
  padding: 9rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.stock.ok {
  background: #e6e9dd;
  color: #27594f;
}

.stock.empty-stock {
  background: #efece4;
  color: #73716d;
}

.spec {
  margin-top: 14rpx;
  color: #73716d;
  font-size: 24rpx;
}

.package-line {
  margin-top: 10rpx;
  color: #4b4945;
  font-size: 23rpx;
  font-weight: 700;
}

.meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-label,
.quantity-label {
  color: #73716d;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 700;
}

.quantity-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.quantity-item {
  padding: 16rpx 10rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  text-align: center;
}

.quantity-item.strong {
  background: #e6e9dd;
}

.quantity-value {
  color: #1f2328;
  font-size: 32rpx;
  font-weight: 700;
}

.strong .quantity-value {
  color: #27594f;
}

.list-more {
  padding: 20rpx 0 8rpx;
  color: #a8a195;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.search-clear::after,
.notice-action::after {
  border: 0;
}
