.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f4f6f5;
  color: #101828;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 22rpx;
}

.eyebrow {
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 6rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 900;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  height: 78rpx;
  color: #101828;
  font-size: 27rpx;
}

.search-clear {
  height: 52rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #eef2f0;
  color: #475467;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.notice {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #f3b8a6;
  border-radius: 8rpx;
  background: #fff4ef;
  color: #b42318;
  font-size: 24rpx;
}

.empty {
  padding: 120rpx 20rpx;
  color: #667085;
  font-size: 27rpx;
  text-align: center;
}

.inventory-list {
  margin-top: 18rpx;
  padding-bottom: 40rpx;
}

.inventory-card {
  margin-bottom: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name {
  color: #101828;
  font-size: 29rpx;
  font-weight: 900;
}

.product-code {
  margin-top: 8rpx;
  color: #176b5b;
  font-family: monospace;
  font-size: 24rpx;
  font-weight: 900;
}

.stock {
  padding: 9rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.stock.ok {
  background: #eaf5f1;
  color: #176b5b;
}

.stock.empty-stock {
  background: #eef2f0;
  color: #667085;
}

.spec {
  margin-top: 14rpx;
  color: #667085;
  font-size: 24rpx;
}

.package-line {
  margin-top: 10rpx;
  color: #475467;
  font-size: 23rpx;
  font-weight: 700;
}

.meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-label,
.quantity-label {
  color: #667085;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 6rpx;
  color: #101828;
  font-size: 25rpx;
  font-weight: 900;
}

.quantity-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.quantity-item {
  padding: 16rpx 10rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  text-align: center;
}

.quantity-item.strong {
  background: #eaf5f1;
}

.quantity-value {
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
}

.strong .quantity-value {
  color: #176b5b;
}

.list-more {
  padding: 20rpx 0 8rpx;
  color: #98a2b3;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.search-clear::after {
  border: 0;
}
