<view class="page">
  <view class="header">
    <view>
      <view class="eyebrow">管理员</view>
      <view class="title">开销售单</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">客户</view>
    <view wx:if="{{selectedCustomer}}" class="selected-box">
      <view>
        <view class="selected-name">{{selectedCustomer.name}}</view>
        <view class="selected-meta">{{selectedCustomer.phone || selectedCustomer.address || '已选择客户'}}</view>
      </view>
    </view>
    <view class="search-card">
      <input
        class="search-input"
        placeholder="输入客户名、电话"
        value="{{customerSearch}}"
        confirm-type="search"
        bindinput="onCustomerSearchInput"
        bindconfirm="onCustomerSearchConfirm"
      />
      <button class="search-btn" loading="{{loadingCustomers}}" bindtap="onCustomerSearchConfirm">查找</button>
    </view>
    <view class="chip-list">
      <view
        wx:for="{{customers}}"
        wx:key="id"
        class="customer-chip {{selectedCustomer && selectedCustomer.id == item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCustomerTap"
      >
        <view class="chip-name">{{item.name}}</view>
        <view class="chip-meta">{{item.phone || item.address || '客户'}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">产品</view>
    <view class="search-card">
      <input
        class="search-input"
        placeholder="输入产品编码、名称、规格"
        value="{{productSearch}}"
        confirm-type="search"
        bindinput="onProductSearchInput"
        bindconfirm="onProductSearchConfirm"
      />
      <button class="search-btn" loading="{{loadingProducts}}" bindtap="onProductSearchConfirm">查找</button>
    </view>
    <view wx:if="{{products.length > 0}}" class="product-result">
      <view
        wx:for="{{products}}"
        wx:key="id"
        class="product-row"
        data-id="{{item.id}}"
        bindtap="onProductTap"
      >
        <view class="product-main">
          <view class="product-name line-clamp-1">{{item.name}}</view>
          <view class="product-code">{{item.code}}</view>
        </view>
        <view class="product-stock">可用 {{item.availableQuantity}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">明细</view>
      <view class="total">合计 ¥{{itemTotal}}</view>
    </view>

    <view wx:if="{{items.length == 0}}" class="empty">请先搜索并添加产品</view>
    <view wx:else>
      <view wx:for="{{items}}" wx:key="productId" class="item-card">
        <view class="item-head">
          <view>
            <view class="item-name line-clamp-1">{{item.productName}}</view>
            <view class="item-code">{{item.productCode}}</view>
          </view>
          <button class="remove-btn" data-index="{{index}}" catchtap="onRemoveItem">删除</button>
        </view>
        <view class="item-spec line-clamp-1">{{item.specification || '未填写规格'}} · 可用 {{item.availableQuantity}}</view>
        <view class="input-row">
          <view class="mini-field">
            <view class="mini-label">数量</view>
            <input
              class="mini-input"
              type="digit"
              value="{{item.quantity}}"
              data-index="{{index}}"
              data-field="quantity"
              bindinput="onItemInput"
            />
          </view>
          <view class="mini-field">
            <view class="mini-label">单价</view>
            <input
              class="mini-input"
              type="digit"
              value="{{item.unitPrice}}"
              data-index="{{index}}"
              data-field="unitPrice"
              bindinput="onItemInput"
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">其他</view>
    <picker mode="date" value="{{orderDate}}" bindchange="onOrderDateChange">
      <view class="date-row">
        <view>销售日期</view>
        <view>{{orderDate}}</view>
      </view>
    </picker>
    <textarea
      class="remarks"
      placeholder="备注"
      value="{{remarks}}"
      bindinput="onRemarksInput"
    />
  </view>

  <view class="bottom-bar">
    <button
      class="secondary"
      loading="{{savingStatus == 'draft'}}"
      disabled="{{isSaving}}"
      bindtap="onSaveDraft"
    >
      保存草稿
    </button>
    <button
      class="primary"
      loading="{{savingStatus == 'confirmed'}}"
      disabled="{{isSaving}}"
      bindtap="onConfirmOrder"
    >
      确认开单
    </button>
  </view>
</view>
