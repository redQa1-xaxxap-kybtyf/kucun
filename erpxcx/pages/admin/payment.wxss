.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 130rpx;
  box-sizing: border-box;
  background: #f4f6f5;
  color: #101828;
}

.header {
  padding: 8rpx 2rpx 18rpx;
}

.eyebrow {
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 6rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 900;
}

.type-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.type-tab {
  flex: 1;
  height: 64rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
  color: #475467;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.type-tab.active {
  border-color: #176b5b;
  background: #176b5b;
  color: #fff;
}

.section {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
}

.section-title {
  color: #101828;
  font-size: 29rpx;
  font-weight: 900;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.small-btn {
  width: 96rpx;
  height: 52rpx;
  border-radius: 8rpx;
  background: #eef2f0;
  color: #176b5b;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.selected-box {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #eaf5f1;
}

.selected-name {
  color: #176b5b;
  font-size: 28rpx;
  font-weight: 900;
}

.selected-meta {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 74rpx;
  margin-top: 16rpx;
  padding: 0 14rpx 0 18rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: #101828;
  font-size: 26rpx;
}

.search-btn {
  width: 104rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #176b5b;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.customer-chip {
  flex: 1 1 220rpx;
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
}

.customer-chip.active {
  border-color: #176b5b;
  background: #eaf5f1;
}

.chip-name {
  color: #101828;
  font-size: 25rpx;
  font-weight: 900;
}

.chip-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #667085;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  margin-top: 16rpx;
  padding: 34rpx 20rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  color: #667085;
  font-size: 25rpx;
  text-align: center;
}

.order-list {
  margin-top: 14rpx;
}

.order-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
}

.order-card.active {
  border-color: #176b5b;
  background: #eaf5f1;
}

.order-number {
  color: #101828;
  font-size: 26rpx;
  font-weight: 900;
}

.order-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.remaining {
  color: #176b5b;
  font-size: 29rpx;
  font-weight: 900;
}

.field {
  margin-top: 18rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #101828;
  font-size: 25rpx;
  font-weight: 900;
}

.input,
.picker-value,
.date-row {
  height: 74rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  color: #101828;
  font-size: 27rpx;
  line-height: 74rpx;
  box-sizing: border-box;
}

.date-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  font-weight: 800;
}

.remarks {
  width: 100%;
  height: 130rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f4f6f5;
  color: #101828;
  font-size: 26rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d0d5dd;
  background: rgba(255, 255, 255, 0.96);
}

.primary {
  height: 82rpx;
  border-radius: 8rpx;
  background: #176b5b;
  color: #fff;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 82rpx;
}
