.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 130rpx;
  box-sizing: border-box;
  background: #f8f6f1;
}

.header {
  padding: 8rpx 2rpx 18rpx;
}

.eyebrow {
  color: #8a8175;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 42rpx;
  font-weight: 900;
}

.type-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #73716d;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 68rpx;
  text-align: center;
}

.type-tab.active {
  background: #27594f;
  color: #fff;
}

.section {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 24rpx;
  background: #fff;
}

.section-title {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 900;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.small-btn {
  width: 106rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #f3eee7;
  color: #27594f;
  font-size: 23rpx;
  font-weight: 900;
}

.selected-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #edf7f3;
}

.selected-name {
  color: #27594f;
  font-size: 28rpx;
  font-weight: 900;
}

.selected-meta {
  margin-top: 6rpx;
  color: #6b756f;
  font-size: 23rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 74rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: #1f2328;
  font-size: 26rpx;
}

.search-btn {
  width: 112rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #27594f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.chip-list {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  overflow-x: auto;
}

.customer-chip {
  min-width: 190rpx;
  padding: 16rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 18rpx;
  background: #fff;
}

.customer-chip.active {
  border-color: #27594f;
  background: #edf7f3;
}

.chip-name {
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 900;
}

.chip-meta {
  max-width: 220rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8a8175;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  margin-top: 16rpx;
  padding: 36rpx 20rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #8a8175;
  font-size: 25rpx;
  text-align: center;
}

.order-list {
  margin-top: 14rpx;
}

.order-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 18rpx;
  background: #fff;
}

.order-card.active {
  border-color: #27594f;
  background: #edf7f3;
}

.order-number {
  color: #1f2328;
  font-size: 26rpx;
  font-weight: 900;
}

.order-meta {
  margin-top: 8rpx;
  color: #8a8175;
  font-size: 22rpx;
}

.remaining {
  color: #b68a45;
  font-size: 29rpx;
  font-weight: 900;
}

.field {
  margin-top: 18rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 900;
}

.input,
.picker-value,
.date-row {
  height: 74rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 27rpx;
  line-height: 74rpx;
  box-sizing: border-box;
}

.date-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  font-weight: 800;
}

.remarks {
  width: 100%;
  height: 130rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 26rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee7dd;
  background: rgba(248, 246, 241, 0.96);
}

.primary {
  height: 82rpx;
  border-radius: 20rpx;
  background: #27594f;
  color: #fff;
  font-size: 29rpx;
  font-weight: 900;
}
