.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 130rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

.header {
  padding: 8rpx 2rpx 18rpx;
}

.eyebrow {
  color: #73716d;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 40rpx;
  font-weight: 700;
}

.type-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.type-tab {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  color: #4b4945;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.type-tab.active {
  border-color: #27594f;
  background: #27594f;
  color: #fff;
}

.section {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.section-title {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 700;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.small-btn {
  width: 108rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #efece4;
  color: #27594f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.selected-box {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #e6e9dd;
}

.selected-name {
  color: #27594f;
  font-size: 28rpx;
  font-weight: 700;
}

.selected-meta {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 23rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 74rpx;
  margin-top: 16rpx;
  padding: 0 14rpx 0 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: #1f2328;
  font-size: 26rpx;
}

.search-btn {
  width: 120rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.customer-chip {
  flex: 1 1 220rpx;
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.customer-chip.active {
  border-color: #27594f;
  background: #e6e9dd;
}

.chip-name {
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 700;
}

.chip-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #73716d;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  margin-top: 16rpx;
  padding: 34rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #73716d;
  font-size: 25rpx;
  text-align: center;
}

.empty.compact {
  padding: 24rpx 18rpx;
}

.order-list {
  margin-top: 14rpx;
}

.order-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.order-card.active {
  border-color: #27594f;
  background: #e6e9dd;
}

.order-number {
  color: #1f2328;
  font-size: 26rpx;
  font-weight: 700;
}

.order-meta {
  margin-top: 8rpx;
  color: #73716d;
  font-size: 22rpx;
}

.remaining {
  color: #27594f;
  font-size: 29rpx;
  font-weight: 700;
}

.field {
  margin-top: 18rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #1f2328;
  font-size: 25rpx;
  font-weight: 700;
}

.input,
.picker-value,
.date-row {
  height: 88rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 28rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

.amount-field {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 96rpx;
  margin-top: 4rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #fdf6e8;
  border: 1rpx solid #f4e3c2;
  box-sizing: border-box;
}

.amount-currency {
  flex: none;
  color: #b68a45;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: #1f2328;
  font-size: 38rpx;
  font-weight: 700;
}

.date-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  font-weight: 600;
}

.remarks {
  width: 100%;
  height: 130rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  color: #1f2328;
  font-size: 26rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7e0d6;
  background: rgba(255, 255, 255, 0.96);
}

.primary {
  height: 82rpx;
  border-radius: 12rpx;
  background: #27594f;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 82rpx;
}
