.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 44rpx;
  box-sizing: border-box;
  background: #f8f6f1;
  color: #1f2328;
}

.header {
  padding: 6rpx 2rpx 24rpx;
}

.identity {
  width: 100%;
}

.eyebrow {
  overflow: hidden;
  color: #73716d;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title {
  display: block;
  width: 100%;
  margin-top: 6rpx;
  color: #1f2328;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.18;
  white-space: nowrap;
}

.desc {
  margin-top: 12rpx;
  color: #73716d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.header-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.text-btn {
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  color: #27594f;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
  line-height: 72rpx;
  box-sizing: border-box;
}

.text-btn.danger {
  color: #b42318;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  margin: 0 2rpx 14rpx;
  color: #2c2b28;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.25;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-card {
  min-height: 132rpx;
  padding: 22rpx;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.quick-card.primary {
  grid-column: span 2;
  border-color: #c8d6cf;
  background: #e6e9dd;
}

.quick-title {
  color: #1f2328;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.28;
}

.quick-desc {
  margin-top: 10rpx;
  color: #73716d;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
}

.quick-card.primary .quick-title {
  color: #1a4035;
}

.menu-list {
  overflow: hidden;
  border: 1rpx solid #e7e0d6;
  border-radius: 12rpx;
  background: #fff;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.menu-row + .menu-row {
  border-top: 1rpx solid #e7e0d6;
}

.menu-main {
  min-width: 0;
}

.menu-title {
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.28;
}

.menu-desc {
  margin-top: 8rpx;
  overflow: hidden;
  color: #73716d;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  flex: none;
  color: #a8a195;
  font-size: 38rpx;
  line-height: 1;
}
