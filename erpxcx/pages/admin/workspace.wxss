.page {
  min-height: 100vh;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
  background: #f8f6f1;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 2rpx 28rpx;
}

.eyebrow {
  color: #8a8175;
  font-size: 23rpx;
  font-weight: 700;
}

.title {
  margin-top: 8rpx;
  color: #1f2328;
  font-size: 46rpx;
  font-weight: 900;
}

.desc {
  margin-top: 6rpx;
  color: #73716d;
  font-size: 25rpx;
}

.logout {
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8a8175;
  font-size: 24rpx;
  font-weight: 800;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 168rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: #27594f;
  box-sizing: border-box;
}

.primary-action .action-title,
.primary-action .action-desc,
.primary-action .action-arrow {
  color: #fff;
}

.action-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 18rpx;
}

.action-card {
  min-height: 150rpx;
  padding: 24rpx;
  border: 1rpx solid #eee7dd;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.action-title {
  color: #1f2328;
  font-size: 32rpx;
  font-weight: 900;
}

.action-desc {
  margin-top: 12rpx;
  color: #73716d;
  font-size: 24rpx;
  line-height: 1.35;
}

.action-arrow {
  font-size: 54rpx;
  font-weight: 300;
}

.section-title {
  margin: 30rpx 4rpx 14rpx;
  color: #8a8175;
  font-size: 24rpx;
  font-weight: 800;
}

.secondary-list {
  border: 1rpx solid #eee7dd;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
}

.secondary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.secondary-title {
  color: #1f2328;
  font-size: 29rpx;
  font-weight: 900;
}

.secondary-desc {
  margin-top: 8rpx;
  color: #73716d;
  font-size: 24rpx;
}

.row-arrow {
  color: #b68a45;
  font-size: 42rpx;
}
