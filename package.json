{
  "name": "kucun",
  "version": "1.0.49",
  "description": "瓷砖行业库存管理工具",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" next build",
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next start",
    "dev:with-scheduler": "tsx scripts/start-with-scheduler.ts dev",
    "start:with-scheduler": "cross-env NODE_ENV=production tsx scripts/start-with-scheduler.ts prod",
    "validate:schema": "node scripts/validate-prisma-relations.js",
    "lint": "npm run validate:schema && next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:inventory": "jest __tests__/unit/inventory --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "test:e2e:ui": "cross-env NODE_ENV=test playwright test --ui",
    "test:e2e:debug": "cross-env NODE_ENV=test playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:redis-ws": "tsx scripts/test-redis-websocket.ts",
    "ledger:rebuild": "tsx scripts/rebuild-ledger.ts",
    "ledger:backfill": "tsx scripts/backfill-ledger-returns-refunds.ts",
    "cache:clear": "tsx scripts/clear-cache.ts",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "lint:staged": "lint-staged",
    "pre-commit": "lint-staged",
    "pre-push": "npm run type-check && npm run lint && npm run format:check && npm run build",
    "check-all": "npm run type-check && npm run lint && npm run format:check",
    "fix-eslint": "tsx scripts/fix-eslint-issues.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:clear": "tsx scripts/clear-test-data.ts",
    "db:clear-all": "tsx scripts/clear-database.ts",
    "db:clear-sales": "tsx scripts/clear-sales-and-payments.ts",
    "db:clean-test-admins": "node scripts/clean-test-admin-users-auto.js",
    "db:verify-admin": "tsx scripts/verify-admin.ts",
    "db:check-admin-password": "node scripts/check-admin-password.js",
    "db:reset-admin-password": "node scripts/reset-admin-password-auto.js",
    "db:studio": "prisma studio",
    "scheduler:start": "dotenv -e .env -- tsx lib/queue/schedulers/start-scheduler.ts",
    "scheduler:dev": "dotenv -e .env -- tsx watch lib/queue/schedulers/start-scheduler.ts",
    "db:reset": "prisma migrate reset",
    "download-geoip": "node scripts/download-geoip.js",
    "test:ip-location": "tsx scripts/test-ip-location.ts",
    "test:queue": "dotenv -e .env -- tsx scripts/test-queue-integration.ts",
    "worker:start": "tsx scripts/start-queue-workers.ts",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:start:cluster": "pm2 start ecosystem.cluster.config.js --env production",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:reload": "pm2 reload all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "deploy:prod": "npm ci --omit=dev && npm run build && npx prisma migrate deploy && npm run pm2:reload"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.79.0",
    "@tanstack/react-query-devtools": "^5.79.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "cheerio": "^1.1.2",
    "china-division": "^2.7.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "convert-units": "^2.3.4",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "file-saver": "^2.0.5",
    "immer": "^11.1.3",
    "ioredis": "^5.8.0",
    "isomorphic-dompurify": "^2.28.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.544.0",
    "maxmind": "^5.0.0",
    "multer": "^1.4.5-lts.1",
    "next": "15.4.7",
    "next-auth": "^4.24.11",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qiniu": "^7.14.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.63.0",
    "react-moveable": "^0.56.0",
    "react-photo-view": "^1.2.7",
    "recharts": "^3.3.0",
    "sharp": "^0.34.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.6",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11",
    "zundo": "^2.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cheerio": "^0.22.35",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.19",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^8.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.0.0",
    "msw": "^2.12.7",
    "pinyin-pro": "^3.27.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^5.22.0",
    "puppeteer-core": "^24.24.0",
    "tailwindcss": "^4.1.14",
    "tar": "^7.5.1",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
