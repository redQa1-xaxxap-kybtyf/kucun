generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  email        String   @unique
  username     String   @unique
  name         String
  passwordHash String   @map("password_hash") @db.VarChar(100)
  role         String   @default("sales") @db.VarChar(32)
  status       String   @default("active") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

model Customer {
  id               String   @id @default(uuid()) @db.Char(36)
  name             String   @db.VarChar(150)
  role             String   @default("customer") @db.VarChar(32)
  phone            String?
  address          String?
  extendedInfo     String?  @map("extended_info")
  parentCustomerId String?  @map("parent_customer_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([phone])
  @@index([role], map: "idx_customers_role")
  @@index([parentCustomerId], map: "idx_customers_parent")
  @@map("customers")
}

model Supplier {
  id           String   @id @default(uuid()) @db.Char(36)
  name         String   @db.VarChar(150)
  supplierCode String?  @unique @map("supplier_code")
  phone        String?  @db.VarChar(50)
  address      String?
  status       String   @default("active") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([supplierCode], map: "idx_suppliers_code")
  @@map("suppliers")
}

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(100)
  description String?
  parentId    String?  @map("parent_id") @db.Char(36)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("active") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name, parentId], map: "unique_name_per_parent")
  @@index([name])
  @@index([code])
  @@index([parentId], map: "idx_categories_parent")
  @@index([status])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Char(36)
  code          String   @unique @db.VarChar(100)
  name          String   @db.VarChar(150)
  specification String?  @db.Text
  unit          String   @default("piece") @db.VarChar(32)
  piecesPerUnit Int      @default(1) @map("pieces_per_unit")
  weight        Float?
  thickness     Float?
  categoryId    String?  @map("category_id") @db.Char(36)
  status        String   @default("active") @db.VarChar(32)
  thumbnailUrl  String?  @map("thumbnail_url")
  images        String?
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([name])
  @@index([categoryId], map: "idx_products_category")
  @@index([status])
  @@index([status, categoryId], map: "idx_products_status_category")
  @@index([createdAt])
  @@index([status, createdAt], map: "idx_products_status_created")
  @@index([status, name], map: "idx_products_status_name")
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  colorCode  String   @map("color_code") @db.VarChar(64)
  colorName  String?  @map("color_name") @db.VarChar(100)
  colorValue String?  @map("color_value") @db.VarChar(100)
  sku        String   @unique @db.VarChar(120)
  status     String   @default("active") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([productId, colorCode], map: "uk_product_color")
  @@index([productId])
  @@index([colorCode])
  @@index([sku])
  @@map("product_variants")
}

model SalesOrder {
  id                 String    @id @default(uuid()) @db.Char(36)
  orderNumber        String    @unique @map("order_number") @db.VarChar(100)
  customerId         String    @map("customer_id") @db.Char(36)
  userId             String    @map("user_id") @db.Char(36)
  status             String    @default("draft") @db.VarChar(32)
  orderType          String    @default("NORMAL") @map("order_type") @db.VarChar(32)
  transferMode       String    @default("SUPPLIER_ONLY") @map("transfer_mode") @db.VarChar(32)
  supplierId         String?   @map("supplier_id") @db.Char(36)
  costAmount         Float?    @default(0) @map("cost_amount")
  profitAmount       Float?    @default(0) @map("profit_amount")
  itemsAmount        Float     @default(0) @map("items_amount")
  additionalFees     Float     @default(0) @map("additional_fees")
  totalAmount        Float     @default(0) @map("total_amount")
  paidAmount         Float     @default(0) @map("paid_amount")
  roundingAdjustment Float     @default(0) @map("rounding_adjustment")
  usePrepayment      Boolean   @default(false) @map("use_prepayment")
  prepaymentAmount   Float?    @default(0) @map("prepayment_amount")
  remarks            String?
  shippedAt          DateTime? @map("shipped_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([customerId], map: "idx_sales_orders_customer")
  @@index([userId], map: "idx_sales_orders_user")
  @@index([status], map: "idx_sales_orders_status")
  @@index([orderType], map: "idx_sales_orders_order_type")
  @@index([supplierId], map: "idx_sales_orders_supplier")
  @@index([usePrepayment], map: "idx_sales_orders_prepayment")
  @@map("sales_orders")
}

model SalesOrderFeeItem {
  id           String   @id @default(uuid()) @db.Char(36)
  salesOrderId String   @map("sales_order_id") @db.Char(36)
  feeType      String   @map("fee_type")
  feeName      String   @map("fee_name")
  feeAmount    Float    @map("fee_amount")
  remarks      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([salesOrderId], map: "idx_sales_order_fee_items_order")
  @@index([feeType], map: "idx_sales_order_fee_items_type")
  @@map("sales_order_fee_items")
}

model SalesOrderItem {
  id                  String   @id @default(uuid()) @db.Char(36)
  salesOrderId        String   @map("sales_order_id") @db.Char(36)
  productId           String?  @map("product_id") @db.Char(36)
  variantId           String?  @map("variant_id") @db.Char(36)
  productCode         String?  @map("product_code")
  batchNumber         String?  @map("batch_number") @db.VarChar(100)
  colorCode           String?  @map("color_code")
  productionDate      String?  @map("production_date")
  quantity            Float
  unitPrice           Float    @map("unit_price")
  subtotal            Float
  unitCost            Float?   @map("unit_cost")
  localQuantity       Float    @default(0) @map("local_quantity")
  transferQuantity    Float    @default(0) @map("transfer_quantity")
  costSubtotal        Float?   @map("cost_subtotal")
  profitAmount        Float?   @map("profit_amount")
  isManualProduct     Boolean? @map("is_manual_product")
  manualProductName   String?  @map("manual_product_name")
  manualSpecification String?  @map("manual_specification")
  manualWeight        Float?   @map("manual_weight")
  manualUnit          String?  @map("manual_unit")
  displayUnit         String?  @map("display_unit")
  displayQuantity     Float?   @map("display_quantity")
  piecesPerUnit       Int?     @map("pieces_per_unit")
  specification       String?  @map("specification") @db.Text
  remarks             String?  @map("remarks")

  @@index([salesOrderId], map: "idx_sales_order_items_order")
  @@index([productId], map: "idx_sales_order_items_product")
  @@index([variantId], map: "idx_sales_order_items_variant")
  @@index([productId, colorCode], map: "idx_sales_order_items_product_color")
  @@index([unitCost], map: "idx_sales_order_items_unit_cost")
  @@index([profitAmount], map: "idx_sales_order_items_profit")
  @@map("sales_order_items")
}

model CustomerProductPrice {
  id         String   @id @default(uuid()) @db.Char(36)
  customerId String   @map("customer_id") @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  priceType  String   @map("price_type") @db.VarChar(64)
  unitPrice  Float    @map("unit_price")
  orderId    String?  @map("order_id") @db.Char(36)
  orderType  String?  @map("order_type") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([customerId, productId, priceType], map: "idx_customer_product_price_lookup")
  @@index([productId], map: "idx_customer_product_price_product")
  @@map("customer_product_prices")
}

model SupplierProductPrice {
  id         String   @id @default(uuid()) @db.Char(36)
  supplierId String   @map("supplier_id") @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  unitPrice  Float    @map("unit_price")
  orderId    String?  @map("order_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([supplierId, productId], map: "idx_supplier_product_price_lookup")
  @@index([productId], map: "idx_supplier_product_price_product")
  @@map("supplier_product_prices")
}

model Inventory {
  id               String   @id @default(uuid()) @db.Char(36)
  productId        String   @map("product_id") @db.Char(36)
  variantId        String?  @map("variant_id") @db.Char(36)
  batchNumber      String?  @map("batch_number") @db.VarChar(100)
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  unitCost         Float?   @map("unit_cost")
  location         String?
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([productId, variantId, batchNumber], map: "uk_inventory_variant_batch")
  @@index([productId], map: "idx_inventory_product")
  @@index([variantId], map: "idx_inventory_variant")
  @@index([quantity], map: "idx_inventory_quantity")
  @@index([batchNumber], map: "idx_inventory_batch")
  @@index([location], map: "idx_inventory_location")
  @@index([updatedAt], map: "idx_inventory_updated_at")
  @@index([productId, quantity], map: "idx_inventory_product_quantity")
  @@index([productId, variantId, quantity], map: "idx_inventory_variant_quantity")
  @@map("inventory")
}

model BatchSpecification {
  id            String   @id @default(uuid()) @db.Char(36)
  productId     String   @map("product_id") @db.Char(36)
  batchNumber   String   @map("batch_number") @db.VarChar(100)
  piecesPerUnit Int      @default(1) @map("pieces_per_unit")
  weight        Float?
  thickness     Float?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([productId, batchNumber], map: "uk_batch_spec_product_batch")
  @@index([productId], map: "idx_batch_spec_product")
  @@index([batchNumber], map: "idx_batch_spec_batch")
  @@index([piecesPerUnit], map: "idx_batch_spec_pieces")
  @@map("batch_specifications")
}

model InboundRecord {
  id                   String   @id @default(uuid()) @db.Char(36)
  recordNumber         String   @unique @map("record_number")
  productId            String   @map("product_id") @db.Char(36)
  variantId            String?  @map("variant_id") @db.Char(36)
  batchNumber          String?  @map("batch_number") @db.VarChar(100)
  batchSpecificationId String?  @map("batch_specification_id") @db.Char(36)
  quantity             Float
  unitCost             Float?   @map("unit_cost")
  totalCost            Float?   @map("total_cost")
  location             String?
  reason               String   @default("purchase")
  remarks              String?
  userId               String   @map("user_id") @db.Char(36)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([productId], map: "idx_inbound_records_product")
  @@index([variantId], map: "idx_inbound_records_variant")
  @@index([batchNumber], map: "idx_inbound_records_batch")
  @@index([batchSpecificationId], map: "idx_inbound_records_batch_spec")
  @@index([userId], map: "idx_inbound_records_user")
  @@index([reason], map: "idx_inbound_records_reason")
  @@map("inbound_records")
}

model OutboundRecord {
  id           String   @id @default(uuid()) @db.Char(36)
  recordNumber String   @unique @map("record_number")
  productId    String   @map("product_id") @db.Char(36)
  variantId    String?  @map("variant_id") @db.Char(36)
  batchNumber  String?  @map("batch_number") @db.VarChar(100)
  inventoryId  String   @map("inventory_id") @db.Char(36)
  quantity     Float
  unitCost     Float?   @map("unit_cost")
  totalCost    Float?   @map("total_cost")
  reason       String   @default("manual_outbound")
  notes        String?
  customerId   String?  @map("customer_id") @db.Char(36)
  salesOrderId String?  @map("sales_order_id") @db.Char(36)
  operatorId   String   @map("operator_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([productId], map: "idx_outbound_records_product")
  @@index([variantId], map: "idx_outbound_records_variant")
  @@index([batchNumber], map: "idx_outbound_records_batch")
  @@index([inventoryId], map: "idx_outbound_records_inventory")
  @@index([customerId], map: "idx_outbound_records_customer")
  @@index([salesOrderId], map: "idx_outbound_records_sales_order")
  @@index([operatorId], map: "idx_outbound_records_operator")
  @@index([reason], map: "idx_outbound_records_reason")
  @@index([salesOrderId, reason], map: "idx_outbound_records_order_reason")
  @@map("outbound_records")
}

model InventoryOperation {
  id             String    @id @default(uuid()) @db.Char(36)
  idempotencyKey String    @unique @map("idempotency_key")
  operationType  String    @map("operation_type")
  productId      String    @map("product_id") @db.Char(36)
  status         String    @default("processing") @db.VarChar(32)
  requestData    String    @map("request_data")
  responseData   String?   @map("response_data")
  errorMessage   String?   @map("error_message")
  operatorId     String    @map("operator_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at")

  @@index([idempotencyKey], map: "idx_operation_idempotency")
  @@index([operatorId], map: "idx_operation_operator")
  @@index([createdAt], map: "idx_operation_created")
  @@index([expiresAt], map: "idx_operation_expires")
  @@map("inventory_operations")
}

model InventoryAdjustment {
  id               String    @id @default(uuid()) @db.Char(36)
  adjustmentNumber String    @unique @map("adjustment_number")
  productId        String    @map("product_id") @db.Char(36)
  variantId        String?   @map("variant_id") @db.Char(36)
  batchNumber      String?   @map("batch_number") @db.VarChar(100)
  beforeQuantity   Int       @map("before_quantity")
  adjustQuantity   Int       @map("adjust_quantity")
  afterQuantity    Int       @map("after_quantity")
  reason           String
  notes            String?
  status           String    @default("draft") @db.VarChar(32)
  operatorId       String    @map("operator_id") @db.Char(36)
  approverId       String?   @map("approver_id") @db.Char(36)
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([productId], map: "idx_inventory_adjustments_product")
  @@index([variantId], map: "idx_inventory_adjustments_variant")
  @@index([batchNumber], map: "idx_inventory_adjustments_batch")
  @@index([reason], map: "idx_inventory_adjustments_reason")
  @@index([status], map: "idx_inventory_adjustments_status")
  @@index([operatorId], map: "idx_inventory_adjustments_operator")
  @@index([approverId], map: "idx_inventory_adjustments_approver")
  @@index([operatorId, status], map: "idx_inventory_adjustments_operator_status")
  @@index([productId, status], map: "idx_inventory_adjustments_product_status")
  @@map("inventory_adjustments")
}

model PaymentRecord {
  id                     String   @id @default(uuid()) @db.Char(36)
  paymentNumber          String   @unique @map("payment_number")
  salesOrderId           String?  @map("sales_order_id") @db.Char(36)
  factoryShipmentOrderId String?  @map("factory_shipment_order_id") @db.Char(36)
  customerId             String   @map("customer_id") @db.Char(36)
  userId                 String   @map("user_id") @db.Char(36)
  paymentType            String   @default("order_payment") @map("payment_type") @db.VarChar(64)
  paymentMethod          String   @default("cash") @db.VarChar(64)
  paymentAmount          Float    @map("payment_amount")
  actualPaymentAmount    Float    @default(0) @map("actual_payment_amount")
  roundingAmount         Float    @default(0) @map("rounding_amount")
  appliedAmount          Float    @default(0) @map("applied_amount")
  paymentDate            DateTime @map("payment_date")
  status                 String   @default("pending") @db.VarChar(32)
  remarks                String?
  receiptNumber          String?  @map("receipt_number")
  bankInfo               String?  @map("bank_info")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([salesOrderId], map: "idx_payment_records_order")
  @@index([factoryShipmentOrderId], map: "idx_payment_records_factory_shipment")
  @@index([customerId], map: "idx_payment_records_customer")
  @@index([userId], map: "idx_payment_records_user")
  @@index([status], map: "idx_payment_records_status")
  @@index([paymentType], map: "idx_payment_records_type")
  @@index([paymentMethod], map: "idx_payment_records_method")
  @@index([customerId, paymentType, status], map: "idx_payment_records_customer_type_status")
  @@index([salesOrderId, status], map: "idx_payment_records_order_status")
  @@map("payment_records")
}

model FactoryShipmentOrder {
  id                  String    @id @default(uuid()) @db.Char(36)
  orderNumber         String    @unique @map("order_number")
  containerNumber     String?   @map("container_number")
  customerId          String    @map("customer_id") @db.Char(36)
  userId              String    @map("user_id") @db.Char(36)
  status              String    @default("draft") @db.VarChar(32)
  totalAmount         Float     @default(0) @map("total_amount")
  receivableAmount    Float     @default(0) @map("receivable_amount")
  depositAmount       Float     @default(0) @map("deposit_amount")
  paidAmount          Float     @default(0) @map("paid_amount")
  remarks             String?
  plan_date           DateTime?
  shipmentDate        DateTime? @map("shipment_date")
  estimatedArrival    DateTime? @map("estimated_arrival") @db.DateTime(0)
  arrivalDate         DateTime? @map("arrival_date")
  deliveryDate        DateTime? @map("delivery_date")
  completionDate      DateTime? @map("completion_date")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  shippingCompany     String?   @map("shipping_company")
  lastShippingQueryAt DateTime? @map("last_shipping_query_at")
  shippingQueryStatus String?   @map("shipping_query_status") @db.VarChar(50)
  shippingQueryError  String?   @map("shipping_query_error") @db.Text
  preferredSiteId     String?   @map("preferred_site_id")

  @@index([orderNumber])
  @@index([containerNumber])
  @@index([customerId], map: "idx_factory_shipment_orders_customer")
  @@index([userId], map: "idx_factory_shipment_orders_user")
  @@index([status])
  @@index([status, shipmentDate], map: "idx_factory_shipment_orders_status_shipment")
  @@index([shippingCompany], map: "idx_factory_shipment_orders_shipping_company")
  @@index([shippingQueryStatus], map: "idx_factory_shipment_orders_query_status")
  @@index([lastShippingQueryAt], map: "idx_factory_shipment_orders_last_query")
  @@index([preferredSiteId], map: "idx_factory_shipment_orders_preferred_site")
  @@map("factory_shipment_orders")
}

model FactoryShipmentOrderItem {
  id                     String    @id @default(uuid()) @db.Char(36)
  factoryShipmentOrderId String    @map("factory_shipment_order_id") @db.Char(36)
  productId              String?   @map("product_id") @db.Char(36)
  supplierId             String    @map("supplier_id") @db.Char(36)
  quantity               Float
  unitPrice              Float     @map("unit_price")
  totalPrice             Float     @map("total_price")
  ownership              String    @default("customer")
  ownershipRemarks       String?   @map("ownership_remarks")
  customerDeliveryStatus String?   @map("customer_delivery_status")
  selfInboundStatus      String?   @map("self_inbound_status")
  deliveryConfirmedAt    DateTime? @map("delivery_confirmed_at")
  inboundReceivedAt      DateTime? @map("inbound_received_at")
  isManualProduct        Boolean?  @map("is_manual_product")
  manualProductName      String?   @map("manual_product_name")
  manualSpecification    String?   @map("manual_specification")
  manualWeight           Float?    @map("manual_weight")
  manualUnit             String?   @map("manual_unit")
  displayName            String    @map("display_name")
  specification          String?   @db.Text
  unit                   String    @default("piece")
  weight                 Float?
  remarks                String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([factoryShipmentOrderId], map: "idx_factory_shipment_order_items_order")
  @@index([productId], map: "idx_factory_shipment_order_items_product")
  @@index([supplierId], map: "idx_factory_shipment_order_items_supplier")
  @@map("factory_shipment_order_items")
}

model ReturnOrder {
  id           String    @id @default(uuid()) @db.Char(36)
  returnNumber String    @unique @map("return_number")
  returnMode   String    @default("single_order") @map("return_mode") @db.VarChar(32)
  salesOrderId String?   @map("sales_order_id") @db.Char(36)
  customerId   String    @map("customer_id") @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  type         String    @map("type") @db.VarChar(32)
  processType  String    @map("process_type") @db.VarChar(32)
  status       String    @default("draft") @db.VarChar(32)
  reason       String?
  totalAmount  Float     @map("total_amount")
  refundAmount Float     @map("refund_amount")
  remarks      String?
  submittedAt  DateTime? @map("submitted_at")
  approvedAt   DateTime? @map("approved_at")
  processedAt  DateTime? @map("processed_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([returnMode], map: "idx_return_orders_mode")
  @@index([salesOrderId], map: "idx_return_orders_sales_order")
  @@index([customerId], map: "idx_return_orders_customer")
  @@index([userId], map: "idx_return_orders_user")
  @@index([status], map: "idx_return_orders_status")
  @@index([type], map: "idx_return_orders_type")
  @@index([returnMode, customerId, status], map: "idx_return_orders_mode_customer_status")
  @@index([salesOrderId, status], map: "idx_return_orders_order_status")
  @@index([status, type], map: "idx_return_orders_status_type")
  @@map("return_orders")
}

model ReturnOrderItem {
