generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique
  username     String    @unique
  name         String
  passwordHash String    @map("password_hash") @db.VarChar(100)
  role         String    @default("sales") @db.VarChar(32)
  status       String    @default("active") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  salesOrders              SalesOrder[]
  returnOrders             ReturnOrder[]
  factoryShipmentOrders    FactoryShipmentOrder[]
  paymentRecords           PaymentRecord[]
  refundRecords            RefundRecord[]
  inboundRecords           InboundRecord[]
  operatedAdjustments      InventoryAdjustment[]  @relation("InventoryAdjustmentOperator")
  approvedAdjustments      InventoryAdjustment[]  @relation("InventoryAdjustmentApprover")
  purchaseOrders           PurchaseOrder[]
  payableRecords           PayableRecord[]
  paymentOutRecords        PaymentOutRecord[]
  systemLogs               SystemLog[]
  expenseRecords           ExpenseRecord[]
  approvedExpenses         ExpenseRecord[]        @relation("ExpenseApprovedBy")
  createdTemporaryProducts TemporaryProduct[]
  createdInventoryCounts   InventoryCount[]       @relation("InventoryCountCreator")
  operatedInventoryCounts  InventoryCount[]       @relation("InventoryCountOperator")
  approvedInventoryCounts  InventoryCount[]       @relation("InventoryCountApprover")
  countedInventoryItems    InventoryCountItem[]   @relation("InventoryCountItemCounter")
  operatedOutboundRecords  OutboundRecord[]       @relation("OutboundRecordOperator")
  inventoryOperations      InventoryOperation[]   @relation("InventoryOperationOperator")
  loginLogs                LoginLog[]
  sessions                 Session[]
  productFavorites         ProductFavorite[]
  productViewHistory       ProductViewHistory[]
  createdPrintTemplates    PrintTemplate[]        @relation("PrintTemplateCreator")
  updatedPrintTemplates    PrintTemplate[]        @relation("PrintTemplateUpdater")

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  sessionToken String   @unique @map("session_token") @db.VarChar(128)
  userId       String   @map("user_id") @db.Char(36)
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model Customer {
  id               String   @id @default(uuid()) @db.Char(36)
  name             String   @unique(map: "uk_suppliers_name") @db.VarChar(150)
  role             String   @default("customer") @db.VarChar(32)
  phone            String?
  address          String?
  extendedInfo     String?  @map("extended_info")
  parentCustomerId String?  @map("parent_customer_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  parentCustomer        Customer?              @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childCustomers        Customer[]             @relation("CustomerHierarchy")
  salesOrders           SalesOrder[]
  returnOrders          ReturnOrder[]
  factoryShipmentOrders FactoryShipmentOrder[]
  paymentRecords        PaymentRecord[]
  refundRecords         RefundRecord[]
  productPrices         CustomerProductPrice[]
  outboundRecords       OutboundRecord[]

  @@index([phone])
  @@index([createdAt])
  @@index([role], map: "idx_customers_role")
  @@index([parentCustomerId], map: "idx_customers_parent")
  @@map("customers")
}

model Supplier {
  id           String   @id @default(uuid()) @db.Char(36)
  name         String   @db.VarChar(150)
  supplierCode String?  @unique @map("supplier_code")
  phone        String?  @db.VarChar(50)
  address      String?
  status       String   @default("active") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  salesOrders               SalesOrder[]
  factoryShipmentOrderItems FactoryShipmentOrderItem[]
  factoryShipmentFeeItems   FactoryShipmentOrderFeeItem[]
  temporaryProducts         TemporaryProduct[]
  productPrices             SupplierProductPrice[]
  purchaseOrders            PurchaseOrder[]
  purchaseOrderItems        PurchaseOrderItem[]
  inboundRecords            InboundRecord[]
  payableRecords            PayableRecord[]
  paymentOutRecords         PaymentOutRecord[]
  expenseRecords            ExpenseRecord[]

  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([supplierCode], map: "idx_suppliers_code")
  @@map("suppliers")
}

model TemporaryProduct {
  id            String    @id @default(uuid()) @db.Char(36)
  supplierId    String    @map("supplier_id") @db.Char(36)
  code          String    @db.VarChar(120)
  name          String    @db.VarChar(150)
  specification String?   @db.Text
  weight        Decimal?  @db.Decimal(18, 6)
  unit          String    @default("片") @db.VarChar(32)
  piecesPerUnit Int       @default(1) @map("pieces_per_unit")
  usageCount    Int       @default(0) @map("usage_count")
  lastUsedAt    DateTime? @map("last_used_at")
  createdBy     String?   @map("created_by") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // 关系定义
  supplier                  Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator                   User?                      @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  salesOrderItems           SalesOrderItem[]
  factoryShipmentOrderItems FactoryShipmentOrderItem[]

  @@unique([supplierId, code], map: "uk_temporary_products_supplier_code")
  @@index([supplierId], map: "idx_temporary_products_supplier")
  @@index([code], map: "idx_temporary_products_code")
  @@index([usageCount], map: "idx_temporary_products_usage")
  @@index([lastUsedAt], map: "idx_temporary_products_last_used")
  @@index([createdBy], map: "temporary_products_created_by_fkey")
  @@map("temporary_products")
}

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(100)
  description String?
  parentId    String?  @map("parent_id") @db.Char(36)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("active") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children        Category[]       @relation("CategoryHierarchy")
  products        Product[]
  inventoryCounts InventoryCount[]

  @@unique([name, parentId], map: "unique_name_per_parent")
  @@index([name])
  @@index([code])
  @@index([parentId], map: "idx_categories_parent")
  @@index([status])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Char(36)
  code          String   @unique @db.VarChar(100)
  name          String   @db.VarChar(150)
  specification String?  @db.Text
  unit          String   @default("sheet") @db.VarChar(32)
  piecesPerUnit Int      @default(1) @map("pieces_per_unit")
  weight        Decimal? @db.Decimal(18, 6)
  thickness     Decimal? @db.Decimal(18, 6)
  minStock      Int?     @map("min_stock")
  categoryId    String?  @map("category_id") @db.Char(36)
  status        String   @default("active") @db.VarChar(32)
  thumbnailUrl  String?  @map("thumbnail_url")
  /// 存储产品图片 JSON（最多 10 张）；生产环境可能存较长的 CDN/签名 URL，用 LONGTEXT 兜底
  images        String?  @db.LongText
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 关系定义
  variants                  ProductVariant[]
  category                  Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  salesOrderItems           SalesOrderItem[]
  factoryShipmentOrderItems FactoryShipmentOrderItem[]
  returnOrderItems          ReturnOrderItem[]
  inventory                 Inventory[]
  inboundRecords            InboundRecord[]
  customerPrices            CustomerProductPrice[]
  supplierPrices            SupplierProductPrice[]
  inventoryAdjustments      InventoryAdjustment[]
  purchaseOrderItems        PurchaseOrderItem[]
  outboundRecords           OutboundRecord[]
  inventoryCountItems       InventoryCountItem[]
  batchSpecifications       BatchSpecification[]
  InventoryCostQueue        InventoryCostQueue[]
  favorites                 ProductFavorite[]
  viewHistory               ProductViewHistory[]
  fifoConsumptionLedgers    FifoConsumptionLedger[]

  @@index([code])
  @@index([name])
  @@index([categoryId], map: "idx_products_category")
  @@index([status])
  @@index([status, categoryId], map: "idx_products_status_category")
  @@index([createdAt])
  @@index([status, createdAt], map: "idx_products_status_created")
  @@index([status, name], map: "idx_products_status_name")
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  colorCode  String   @map("color_code") @db.VarChar(64)
  colorName  String?  @map("color_name") @db.VarChar(100)
  colorValue String?  @map("color_value") @db.VarChar(100)
  sku        String   @unique @db.VarChar(120)
  status     String   @default("active") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // 关系定义
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  salesOrderItems      SalesOrderItem[]
  inboundRecords       InboundRecord[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryCountItems  InventoryCountItem[]
  inventory            Inventory[]
  outboundRecords      OutboundRecord[]
  InventoryCostQueue   InventoryCostQueue[]
  fifoConsumptionLedgers FifoConsumptionLedger[]

  @@unique([productId, colorCode], map: "uk_product_color")
  @@index([productId])
  @@index([colorCode])
  @@index([sku])
  @@map("product_variants")
}

model SalesOrder {
  id                 String    @id @default(uuid()) @db.Char(36)
  orderNumber        String    @unique @map("order_number") @db.VarChar(100)
  customerId         String    @map("customer_id") @db.Char(36)
  userId             String    @map("user_id") @db.Char(36)
  status             String    @default("draft") @db.VarChar(32)
  orderType          String    @default("NORMAL") @map("order_type") @db.VarChar(32)
  transferMode       String    @default("SUPPLIER_ONLY") @map("transfer_mode") @db.VarChar(32)
  supplierId         String?   @map("supplier_id") @db.Char(36)
  costAmount         Decimal?  @default(0) @map("cost_amount") @db.Decimal(18, 2)
  profitAmount       Decimal?  @default(0) @map("profit_amount") @db.Decimal(18, 2)
  itemsAmount        Decimal   @default(0) @map("items_amount") @db.Decimal(18, 2)
  additionalFees     Decimal   @default(0) @map("additional_fees") @db.Decimal(18, 2)
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  paidAmount         Decimal   @default(0) @map("paid_amount") @db.Decimal(18, 2)
  roundingAdjustment Decimal   @default(0) @map("rounding_adjustment") @db.Decimal(18, 2)
  usePrepayment      Boolean   @default(false) @map("use_prepayment")
  prepaymentAmount   Decimal?  @default(0) @map("prepayment_amount") @db.Decimal(18, 2)
  remarks            String?
  dataTag            String    @default("prod") @map("data_tag") @db.VarChar(16)
  voidedAt           DateTime? @map("voided_at")
  voidedBy           String?   @map("voided_by") @db.Char(36)
  voidReason         String?   @map("void_reason") @db.VarChar(64)
  shippedAt          DateTime? @map("shipped_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  expenseAmount      Decimal?  @default(0) @map("expense_amount") @db.Decimal(18, 2)

  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items            SalesOrderItem[]
  feeItems         SalesOrderFeeItem[]
  returnOrders     ReturnOrder[]
  payments         PaymentRecord[]
  outboundRecords  OutboundRecord[]
  refundRecords    RefundRecord[]
  purchaseOrders   PurchaseOrder[]
  prepaymentUsages PrepaymentUsage[]

  @@index([customerId], map: "idx_sales_orders_customer")
  @@index([userId], map: "idx_sales_orders_user")
  @@index([status], map: "idx_sales_orders_status")
  @@index([orderType], map: "idx_sales_orders_order_type")
  @@index([supplierId], map: "idx_sales_orders_supplier")
  @@index([usePrepayment], map: "idx_sales_orders_prepayment")
  @@index([customerId, status])
  @@index([customerId, createdAt])
  @@index([status, createdAt], map: "idx_sales_orders_status_created")
  @@index([status, totalAmount], map: "idx_sales_orders_status_amount")
  @@index([status, customerId, createdAt], map: "idx_sales_orders_status_customer_created")
  @@index([orderNumber], map: "idx_sales_orders_order_number")
  @@index([dataTag], map: "idx_sales_orders_data_tag")
  @@index([voidedAt], map: "idx_sales_orders_voided_at")
  @@map("sales_orders")
}

model SalesOrderFeeItem {
  id           String   @id @default(uuid()) @db.Char(36)
  salesOrderId String   @map("sales_order_id") @db.Char(36)
  feeType      String   @map("fee_type")
  feeName      String   @map("fee_name")
  feeAmount    Decimal  @map("fee_amount") @db.Decimal(18, 2)
  remarks      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  paidBy       String   @default("customer") @map("paid_by") @db.VarChar(20)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([salesOrderId], map: "idx_sales_order_fee_items_order")
  @@index([feeType], map: "idx_sales_order_fee_items_type")
  @@index([paidBy], map: "idx_sales_order_fee_items_paid_by")
  @@map("sales_order_fee_items")
}

model SalesOrderItem {
  id                  String   @id @default(uuid()) @db.Char(36)
  salesOrderId        String   @map("sales_order_id") @db.Char(36)
  productId           String?  @map("product_id") @db.Char(36)
  variantId           String?  @map("variant_id") @db.Char(36)
  productCode         String?  @map("product_code")
  batchNumber         String?  @map("batch_number") @db.VarChar(100)
  colorCode           String?  @map("color_code")
  productionDate      String?  @map("production_date")
  quantity            Int
  unitPrice           Decimal  @map("unit_price") @db.Decimal(18, 2)
  subtotal            Decimal  @db.Decimal(18, 2)
  unitCost            Decimal? @map("unit_cost") @db.Decimal(18, 2)
  localQuantity       Int      @default(0) @map("local_quantity")
  transferQuantity    Int      @default(0) @map("transfer_quantity")
  costSubtotal        Decimal? @map("cost_subtotal") @db.Decimal(18, 2)
  profitAmount        Decimal? @map("profit_amount") @db.Decimal(18, 2)
  allocatedExpense    Decimal? @default(0) @map("allocated_expense") @db.Decimal(18, 2)
  profitMargin        Decimal? @map("profit_margin") @db.Decimal(9, 6)
  isManualProduct     Boolean? @map("is_manual_product")
  manualProductName   String?  @map("manual_product_name")
  manualSpecification String?  @map("manual_specification")
  manualWeight        Decimal? @map("manual_weight") @db.Decimal(18, 6)
  manualUnit          String?  @map("manual_unit")
  displayUnit         String?  @map("display_unit")
  displayQuantity     Decimal? @map("display_quantity") @db.Decimal(18, 6)
  piecesPerUnit       Int?     @map("pieces_per_unit")
  specification       String?  @map("specification") @db.Text
  remarks             String?  @map("remarks")
  temporaryProductId  String?  @map("temporary_product_id") @db.Char(36)

  salesOrder       SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  temporaryProduct TemporaryProduct? @relation(fields: [temporaryProductId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  returnItems      ReturnOrderItem[]

  @@index([salesOrderId], map: "idx_sales_order_items_order")
  @@index([productId], map: "idx_sales_order_items_product")
  @@index([variantId], map: "idx_sales_order_items_variant")
  @@index([productId, colorCode], map: "idx_sales_order_items_product_color")
  @@index([unitCost], map: "idx_sales_order_items_unit_cost")
  @@index([profitAmount], map: "idx_sales_order_items_profit")
  @@index([temporaryProductId], map: "idx_sales_order_items_temp_product")
  @@map("sales_order_items")
}

model CustomerProductPrice {
  id         String   @id @default(uuid()) @db.Char(36)
  customerId String   @map("customer_id") @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  priceType  String   @map("price_type") @db.VarChar(64)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(18, 2)
  orderId    String?  @map("order_id") @db.Char(36)
  orderType  String?  @map("order_type") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // 关系定义
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerId, productId, priceType], map: "idx_customer_product_price_lookup")
  @@index([productId], map: "idx_customer_product_price_product")
  @@map("customer_product_prices")
}

model SupplierProductPrice {
  id         String   @id @default(uuid()) @db.Char(36)
  supplierId String   @map("supplier_id") @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(18, 2)
  orderId    String?  @map("order_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // 关系定义
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([supplierId, productId], map: "idx_supplier_product_price_lookup")
  @@index([productId], map: "idx_supplier_product_price_product")
  @@map("supplier_product_prices")
}

model Inventory {
  id               String   @id @default(uuid()) @db.Char(36)
  productId        String   @map("product_id") @db.Char(36)
  variantId        String?  @map("variant_id") @db.Char(36)
  batchNumber      String?  @map("batch_number") @db.VarChar(100)
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  unitCost         Decimal? @map("unit_cost") @db.Decimal(18, 2)
  location         String?
  updatedAt        DateTime @updatedAt @map("updated_at")

  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outboundRecords OutboundRecord[]

  @@unique([productId, variantId, batchNumber], map: "uk_inventory_variant_batch")
  @@index([productId], map: "idx_inventory_product")
  @@index([variantId], map: "idx_inventory_variant")
  @@index([quantity], map: "idx_inventory_quantity")
  @@index([batchNumber], map: "idx_inventory_batch")
  @@index([location], map: "idx_inventory_location")
  @@index([updatedAt], map: "idx_inventory_updated_at")
  @@index([productId, quantity], map: "idx_inventory_product_quantity")
  @@index([productId, variantId, quantity], map: "idx_inventory_variant_quantity")
  @@map("inventory")
}

model BatchSpecification {
  id            String   @id @default(uuid()) @db.Char(36)
  productId     String   @map("product_id") @db.Char(36)
  batchNumber   String   @map("batch_number") @db.VarChar(100)
  piecesPerUnit Int      @default(1) @map("pieces_per_unit")
  weight        Decimal? @db.Decimal(18, 6)
  thickness     Decimal? @db.Decimal(18, 6)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 关系定义
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inboundRecords InboundRecord[]

  @@unique([productId, batchNumber], map: "uk_batch_spec_product_batch")
  @@index([productId], map: "idx_batch_spec_product")
  @@index([batchNumber], map: "idx_batch_spec_batch")
  @@index([piecesPerUnit], map: "idx_batch_spec_pieces")
  @@map("batch_specifications")
}

model InboundRecord {
  id                   String   @id @default(uuid()) @db.Char(36)
  recordNumber         String   @unique @map("record_number")
  productId            String   @map("product_id") @db.Char(36)
  variantId            String?  @map("variant_id") @db.Char(36)
  batchNumber          String?  @map("batch_number") @db.VarChar(100)
  batchSpecificationId String?  @map("batch_specification_id") @db.Char(36)
  quantity             Int
  unitCost             Decimal? @map("unit_cost") @db.Decimal(18, 2)
  totalCost            Decimal? @map("total_cost") @db.Decimal(18, 2)
  location             String?
  reason               String   @default("purchase")
  remarks              String?
  userId               String   @map("user_id") @db.Char(36)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  purchaseOrderId      String?  @map("purchase_order_id") @db.Char(36)
  purchaseOrderItemId  String?  @map("purchase_order_item_id") @db.Char(36)
  supplierId           String?  @map("supplier_id") @db.Char(36)

  // 关系定义
  product            Product              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant            ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  batchSpecification BatchSpecification?  @relation(fields: [batchSpecificationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  purchaseOrder      PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  purchaseOrderItem  PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier           Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  costQueueEntries   InventoryCostQueue[] // FIFO成本队列条目

  @@index([productId], map: "idx_inbound_records_product")
  @@index([variantId], map: "idx_inbound_records_variant")
  @@index([supplierId], map: "idx_inbound_records_supplier")
  @@index([batchNumber], map: "idx_inbound_records_batch")
  @@index([batchSpecificationId], map: "idx_inbound_records_batch_spec")
  @@index([userId], map: "idx_inbound_records_user")
  @@index([reason], map: "idx_inbound_records_reason")
  @@index([purchaseOrderId], map: "idx_inbound_records_purchase_order")
  @@index([purchaseOrderItemId], map: "idx_inbound_records_purchase_order_item")
  @@map("inbound_records")
}

// FIFO成本队列表 - 用于先进先出成本核算
// 记录每批入库的成本信息,按入库时间排序出库
model InventoryCostQueue {
  id              String  @id @default(uuid()) @db.Char(36)
  productId       String  @map("product_id") @db.Char(36)
  variantId       String? @map("variant_id") @db.Char(36)
  batchNumber     String? @map("batch_number") @db.VarChar(100)
  inboundRecordId String  @map("inbound_record_id") @db.Char(36)

  remainingQty Int      @map("remaining_qty") // 该批次剩余可用数量
  unitCost     Decimal  @map("unit_cost") @db.Decimal(18, 2) // 该批次单位成本
  inboundDate  DateTime @map("inbound_date") // 入库时间(FIFO排序关键)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关系定义
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  inboundRecord InboundRecord   @relation(fields: [inboundRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // FIFO核心索引: 按产品+变体+入库时间排序
  @@index([productId, variantId, inboundDate], map: "idx_cost_queue_fifo")
  // 可用库存查询索引
  @@index([productId, variantId, remainingQty], map: "idx_cost_queue_available")
  // 批次查询索引
  @@index([batchNumber], map: "idx_cost_queue_batch")
  // 入库记录关联索引
  @@index([inboundRecordId], map: "idx_cost_queue_inbound")
  @@map("inventory_cost_queue")
}

