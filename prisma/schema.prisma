  @@index([ruleName], map: "idx_consistency_alerts_rule_name")
  @@index([severity], map: "idx_consistency_alerts_severity")
  @@index([entityType], map: "idx_consistency_alerts_entity_type")
  @@index([status], map: "idx_consistency_alerts_status")
  @@index([firstSeenAt], map: "idx_consistency_alerts_first_seen_at")
  @@index([lastSeenAt], map: "idx_consistency_alerts_last_seen_at")
  @@map("consistency_alerts")
}
