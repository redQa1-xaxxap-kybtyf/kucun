// 登录日志表 - 用于安全审计和异常检测
// MySQL 5.7兼容性说明:
// - 组合索引总长度控制在767字节以内
// - VARCHAR使用utf8mb4字符集(每字符4字节)
model LoginLog {
  id            String   @id @default(uuid()) @db.Char(36)
  userId        String?  @map("user_id") @db.Char(36)
  username      String   @db.VarChar(100)
  type          String   @db.VarChar(32) // 'success' | 'failed' | 'blocked'
  failureReason String?  @map("failure_reason") @db.VarChar(64) // 失败原因
  clientIp      String   @map("client_ip") @db.VarChar(45) // IPv6最大长度45
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  // 关系定义
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_login_logs_user")

  // 索引设计 - MySQL 5.7兼容
  @@index([username], map: "idx_login_logs_username")
  @@index([clientIp], map: "idx_login_logs_client_ip")
  @@index([createdAt], map: "idx_login_logs_created_at")
  @@index([type], map: "idx_login_logs_type")
  @@index([userId], map: "idx_login_logs_user_id")
  // 组合索引: username(100*4) + type(32*4) + createdAt(8) = 536字节 < 767字节限制
  @@index([username, type, createdAt], map: "idx_login_logs_username_type_created")
  @@map("login_logs")
}

// 产品收藏表 - 记录用户收藏的产品
model ProductFavorite {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  productId String   @map("product_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, productId], map: "uk_product_favorites_user_product")
  @@index([userId], map: "idx_product_favorites_user")
  @@index([productId], map: "idx_product_favorites_product")
  @@map("product_favorites")
}

// 产品浏览历史表 - 记录用户最近浏览的产品
model ProductViewHistory {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  productId String   @map("product_id") @db.Char(36)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, productId], map: "uk_product_view_history_user_product")
  @@index([userId, viewedAt], map: "idx_product_view_history_user_time")
  @@index([productId], map: "idx_product_view_history_product")
  @@map("product_view_history")
}

// 打印模板表 - 存储可视化设计器创建的打印模板
model PrintTemplate {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)

  /// 模板类型: sales-order, purchase-order, factory-shipment, delivery-note, custom
  type String @map("template_type") @db.VarChar(50)

  /// 是否为该类型的默认模板
  isDefault Boolean @default(false) @map("is_default")

  /// 模板配置 JSON (Zod Schema 验证)
  content Json @map("content")

  /// 缩略图 (base64 或 URL)
  thumbnail String? @db.Text

  /// 状态: active, disabled, deleted
  status String @default("active") @db.VarChar(20)

  /// 是否为系统内置模板 (不可删除)
  isSystem Boolean @default(false) @map("is_system")

  /// 审计字段
  createdBy String   @map("created_by") @db.Char(36)
  updatedBy String   @map("updated_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关系
  creator User @relation("PrintTemplateCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updater User @relation("PrintTemplateUpdater", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([type, status], map: "idx_print_template_type_status")
  @@index([isDefault], map: "idx_print_template_default")
  @@index([createdBy], map: "idx_print_template_creator")
  @@index([status], map: "idx_print_template_status")
  @@map("print_templates")
}

model AuditRun {
  runId       String   @id @map("run_id") @db.Char(36)
  auditKey    String   @map("audit_key") @db.VarChar(64)
  rangeStart  DateTime? @map("range_start")
  rangeEnd    DateTime? @map("range_end")
  status      String   @db.VarChar(32)
  shardJson   Json?    @map("shard_json")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  scannedCount Int?    @map("scanned_count")
  issueCount  Int?     @map("issue_count")
  configJson  Json?    @map("config_json")

  findings AuditFinding[]
  metrics  AuditMetric[]

  @@index([auditKey], map: "idx_audit_run_key")
  @@index([status], map: "idx_audit_run_status")
  @@map("audit_run")
}

model AuditFinding {
  runId        String   @map("run_id") @db.Char(36)
  domain       String   @db.VarChar(64)
  reasonCode   String   @map("reason_code") @db.VarChar(64)
  severity     String   @db.VarChar(16)
  entityType   String   @map("entity_type") @db.VarChar(64)
  entityId     String   @map("entity_id") @db.VarChar(64)
  entityNumber String?  @map("entity_number") @db.VarChar(128)
  expected     Json?
  actual       Json?
  delta        Decimal? @db.Decimal(18, 4)
  message      String   @db.Text
  evidenceJson Json?    @map("evidence_json")
  createdAt    DateTime @default(now()) @map("created_at")

  run AuditRun @relation(fields: [runId], references: [runId], onDelete: Cascade, onUpdate: Cascade)

  @@id([runId, domain, reasonCode, entityType, entityId])
  @@index([runId, domain], map: "idx_audit_finding_run_domain")
  @@index([reasonCode], map: "idx_audit_finding_reason")
  @@index([entityType, entityId], map: "idx_audit_finding_entity")
  @@map("audit_finding")
}

model AuditMetric {
  runId          String   @map("run_id") @db.Char(36)
  metricKey      String   @map("metric_key") @db.VarChar(64)
  metricValueJson Json    @map("metric_value_json")
  createdAt      DateTime @default(now()) @map("created_at")

  run AuditRun @relation(fields: [runId], references: [runId], onDelete: Cascade, onUpdate: Cascade)

  @@id([runId, metricKey])
  @@map("audit_metric")
}

model FifoConsumptionLedger {
  id              String   @id @default(uuid()) @db.Char(36)
  businessKey     String   @unique(map: "uk_fifo_ledger_business_key") @map("business_key") @db.VarChar(191)
  productId       String   @map("product_id") @db.Char(36)
  variantId       String?  @map("variant_id") @db.Char(36)
  batchNumber     String?  @map("batch_number") @db.VarChar(100)
  totalQty        Int      @map("total_qty")
  totalCost       Decimal  @map("total_cost") @db.Decimal(18, 2)
  averageUnitCost Decimal  @map("average_unit_cost") @db.Decimal(18, 2)
  costBreakdown   Json?    @map("cost_breakdown")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, variantId], map: "idx_fifo_ledger_product_variant")
  @@index([createdAt], map: "idx_fifo_ledger_created")
  @@map("fifo_consumption_ledger")
}

model ConsistencyAlert {
  id          String   @id @default(uuid()) @db.Char(36)
  ruleName    String   @map("rule_name") @db.VarChar(100)
  severity    String   @db.VarChar(10)
  entityType  String   @map("entity_type") @db.VarChar(50)
